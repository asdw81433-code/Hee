        <item name="android:colorAccent">#8B5CFF</item>
        <item name="android:colorPrimary">#171230</item>
        <item name="android:colorPrimaryDark">#0B0D1A</item>
        <item name="android:windowBackground">@drawable/bg_kivo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0B1628</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
