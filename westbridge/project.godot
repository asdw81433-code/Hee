; Engine configuration file.
; WESTBRIDGE - Open World City Life Simulator (Godot 4.5+ / tested on 4.7.1)

config_version=5

[application]

config/name="Westbridge"
config/description="Open World City Life Simulator"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.09, 0.11, 0.14, 1)

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
Settings="*res://scripts/core/settings.gd"
GameTime="*res://scripts/core/game_time.gd"
SaveSystem="*res://scripts/core/save_system.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="ragdoll"
3d_physics/layer_5="props"
3d_physics/layer_6="interactable"
3d_physics/layer_7="vehicle"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=1024
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.55, 0.66, 0.78, 1)
anti_aliasing/quality/msaa_3d=1

[shader_globals]

night_factor={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
