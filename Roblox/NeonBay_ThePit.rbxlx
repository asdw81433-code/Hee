    <Item class="StringValue" referent="744">
      <Properties>
        <string name="Name">READ_ME</string>
        <string name="Value">NEON BAY: THE PIT. Press Play. Solo: open CAREER to fight the CPU ladder. Multiplayer: test with Test &gt; Clients and Servers (2 players) and stand on both corner pads of a ring. Enable Game Settings &gt; Security &gt; Enable Studio Access to API Services to test saving.</string>
      </Properties>
    </Item>
