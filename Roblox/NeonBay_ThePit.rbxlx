	{ key = "chin", name = "Chin (neck work)" },
	{ key = "def", name = "Defense (slip rope)" },
	{ key = "foot", name = "Footwork (ladder drills)" },
}
Config.TrainMax = 10
function Config.TrainCost(level)
	return 250 + level * 220
end

Config.StartingCash = 500

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="756">
        <Properties>
          <string name="Name">RigDef</string>
          <string name="Source"><![CDATA[--[[
	Skeleton of a NEON BAY fighter. Every bone is a small invisible part whose origin IS the joint, so a
	Motor6D with C0 = offset and C1 = identity rotates the bone around its joint through Motor6D.Transform.
	Coordinates: Roblox (front = -Z, right = +X), authored in meters and scaled to studs.
]]

local Config = require(script.Parent.Config)

local RigDef = {}

RigDef.Bones = {
	{ name = "LowerTorso", parent = "HumanoidRootPart", motor = "Root" },
	{ name = "Spine", parent = "LowerTorso", motor = "Waist" },
	{ name = "UpperTorso", parent = "Spine", motor = "Chest" },
	{ name = "Neck", parent = "UpperTorso", motor = "NeckJoint" },
	{ name = "Head", parent = "Neck", motor = "Neck" },
	{ name = "Jaw", parent = "Head", motor = "Jaw" },
	{ name = "LeftUpperArm", parent = "UpperTorso", motor = "LeftShoulder" },
	{ name = "LeftLowerArm", parent = "LeftUpperArm", motor = "LeftElbow" },
	{ name = "LeftHand", parent = "LeftLowerArm", motor = "LeftWrist" },
	{ name = "RightUpperArm", parent = "UpperTorso", motor = "RightShoulder" },
	{ name = "RightLowerArm", parent = "RightUpperArm", motor = "RightElbow" },
	{ name = "RightHand", parent = "RightLowerArm", motor = "RightWrist" },
	{ name = "LeftUpperLeg", parent = "LowerTorso", motor = "LeftHip" },
	{ name = "LeftLowerLeg", parent = "LeftUpperLeg", motor = "LeftKnee" },
	{ name = "LeftFoot", parent = "LeftLowerLeg", motor = "LeftAnkle" },
	{ name = "RightUpperLeg", parent = "LowerTorso", motor = "RightHip" },
	{ name = "RightLowerLeg", parent = "RightUpperLeg", motor = "RightKnee" },
	{ name = "RightFoot", parent = "RightLowerLeg", motor = "RightAnkle" },
}

RigDef.HipHeightM = 0.98
RigDef.UpperArm, RigDef.LowerArm = 0.29, 0.26
RigDef.UpperLeg, RigDef.LowerLeg = 0.44, 0.43

function RigDef.Dims(p)
	local b = math.clamp(p.bulk or 1, 0.85, 1.4)
	local m = math.clamp(p.muscle or 0.5, 0, 1)
	local f = p.female and 1 or 0
	local h = math.clamp(p.height or 1, 0.9, 1.1)
	return {
		b = b, m = m, f = f, h = h,
		sx = 0.168 + 0.05 * (b - 1) + 0.012 * m - 0.018 * f,
		hx = 0.088 + 0.015 * (b - 1) + 0.012 * f,
		scale = Config.S * h, -- studs per authored meter for this fighter
	}
end

--[[ Offsets in parent space, in studs. ]]
function RigDef.Offsets(p)
	local d = RigDef.Dims(p)
	local k = d.scale
	local o = {
		LowerTorso = Vector3.new(0, 0, 0),
		Spine = Vector3.new(0, 0.06, 0),
		UpperTorso = Vector3.new(0, 0.2, 0),
		Neck = Vector3.new(0, 0.225, 0.012),
		Head = Vector3.new(0, 0.095, -0.012),
		Jaw = Vector3.new(0, 0.11, -0.01),
		LeftUpperArm = Vector3.new(-d.sx, 0.185, 0.015),
		RightUpperArm = Vector3.new(d.sx, 0.185, 0.015),
		LeftLowerArm = Vector3.new(0, -RigDef.UpperArm, 0),
		RightLowerArm = Vector3.new(0, -RigDef.UpperArm, 0),
		LeftHand = Vector3.new(0, -RigDef.LowerArm, 0),
		RightHand = Vector3.new(0, -RigDef.LowerArm, 0),
		LeftUpperLeg = Vector3.new(-d.hx, -0.05, 0),
		RightUpperLeg = Vector3.new(d.hx, -0.05, 0),
		LeftLowerLeg = Vector3.new(0, -RigDef.UpperLeg, 0),
		RightLowerLeg = Vector3.new(0, -RigDef.UpperLeg, 0),
		LeftFoot = Vector3.new(0, -RigDef.LowerLeg, 0),
		RightFoot = Vector3.new(0, -RigDef.LowerLeg, 0),
	}
	for name, v in o do
		o[name] = v * k
	end
	return o, d
end

-- HumanoidRootPart is centred on the hip joint
RigDef.RootSize = Vector3.new(1.6, 2, 1.3)

function RigDef.HipHeight(p)
	local d = RigDef.Dims(p)
	return RigDef.HipHeightM * d.scale - RigDef.RootSize.Y / 2
end

-- ragdoll / hit colliders per bone: centre (m, bone space) and size (m)
RigDef.Colliders = {
	LowerTorso = { c = Vector3.new(0, -0.03, 0), s = Vector3.new(0.3, 0.2, 0.2) },
	Spine = { c = Vector3.new(0, 0.1, 0), s = Vector3.new(0.27, 0.25, 0.18) },
	UpperTorso = { c = Vector3.new(0, 0.12, 0), s = Vector3.new(0.36, 0.3, 0.22) },
	Head = { c = Vector3.new(0, 0.13, -0.01), s = Vector3.new(0.2, 0.25, 0.22) },
	LeftUpperArm = { c = Vector3.new(0, -0.145, 0), s = Vector3.new(0.1, 0.32, 0.1) },
	RightUpperArm = { c = Vector3.new(0, -0.145, 0), s = Vector3.new(0.1, 0.32, 0.1) },
	LeftLowerArm = { c = Vector3.new(0, -0.17, 0), s = Vector3.new(0.09, 0.4, 0.09) },
	RightLowerArm = { c = Vector3.new(0, -0.17, 0), s = Vector3.new(0.09, 0.4, 0.09) },
	LeftUpperLeg = { c = Vector3.new(0, -0.22, 0), s = Vector3.new(0.15, 0.48, 0.15) },
	RightUpperLeg = { c = Vector3.new(0, -0.22, 0), s = Vector3.new(0.15, 0.48, 0.15) },
	LeftLowerLeg = { c = Vector3.new(0, -0.22, 0), s = Vector3.new(0.11, 0.48, 0.11) },
	RightLowerLeg = { c = Vector3.new(0, -0.22, 0), s = Vector3.new(0.11, 0.48, 0.11) },
	LeftFoot = { c = Vector3.new(0, -0.03, -0.05), s = Vector3.new(0.09, 0.06, 0.25) },
	RightFoot = { c = Vector3.new(0, -0.03, -0.05), s = Vector3.new(0.09, 0.06, 0.25) },
}

-- ragdoll joint limits: "ball" = cone + twist, "hinge" = bend in one direction (degrees)
RigDef.Joints = {
	Waist = { kind = "ball", cone = 25, twist = 20 },
	Chest = { kind = "ball", cone = 20, twist = 18 },
	NeckJoint = { kind = "ball", cone = 25, twist = 25 },
	Neck = { kind = "ball", cone = 35, twist = 45 },
	LeftShoulder = { kind = "ball", cone = 85, twist = 55 },
	RightShoulder = { kind = "ball", cone = 85, twist = 55 },
	LeftElbow = { kind = "hinge", lo = -3, hi = 140 },
	RightElbow = { kind = "hinge", lo = -3, hi = 140 },
	LeftHip = { kind = "ball", cone = 70, twist = 25 },
	RightHip = { kind = "ball", cone = 70, twist = 25 },
	LeftKnee = { kind = "hinge", lo = -135, hi = 3 },
	RightKnee = { kind = "hinge", lo = -135, hi = 3 },
	LeftWrist = { kind = "ball", cone = 30, twist = 20 },
	RightWrist = { kind = "ball", cone = 30, twist = 20 },
	LeftAnkle = { kind = "ball", cone = 25, twist = 10 },
	RightAnkle = { kind = "ball", cone = 25, twist = 10 },
}

return RigDef
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="757">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="758">
      <Properties>
        <string name="Name">NeonBay</string>
      </Properties>
      <Item class="ModuleScript" referent="759">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[--[[
	Player data: look, career record, cash, training and injuries. Uses DataStoreService when the place is
	published with API access; otherwise (e.g. a local Studio test) it silently keeps data for the session.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Data = {}
Data.cache = {}

local store
do
	local ok, s = pcall(function() return DataStoreService:GetDataStore("NeonBayPit_v2") end)
	if ok then store = s end
end

local function defaults(player)
	local look = Util.deepCopy(Config.DefaultProfile)
	look.name = player and player.DisplayName or "Fighter"
	return {
		look = look,
		cash = Config.StartingCash,
		wins = 0, losses = 0, draws = 0, kos = 0, rank = 0,
		train = { pow = 0, spd = 0, eng = 0, chin = 0, def = 0, foot = 0 },
		injuries = {},
		created = false,
	}
end

local function merge(base, saved)
	if type(saved) ~= "table" then return base end
	for k, v in saved do
		if type(v) == "table" and type(base[k]) == "table" then
			merge(base[k], v)
		else
			base[k] = v
		end
	end
	return base
end

function Data.Load(player)
	local d = defaults(player)
	if store then
		local ok, saved = pcall(function() return store:GetAsync("p_" .. player.UserId) end)
		if ok and saved then merge(d, saved) end
	end
	Data.cache[player] = d
	return d
end

function Data.Get(player)
	return Data.cache[player]
end

function Data.Save(player)
	local d = Data.cache[player]
	if not d or not store then return end
	pcall(function() store:SetAsync("p_" .. player.UserId, d) end)
end

function Data.Release(player)
	Data.Save(player)
	Data.cache[player] = nil
end

--[[ Fight attributes of a player: RPG-free, driven by training. ]]
function Data.FightStats(d)
	local t = d.train
	return {
		power = 48 + t.pow * 4,
		speed = 50 + t.spd * 4,
		engine = 50 + t.eng * 4,
		chin = 48 + t.chin * 4,
		defense = 48 + t.def * 4,
		footwork = 50 + t.foot * 4,
		heart = 55 + (d.wins or 0) * 1.5,
	}
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="760">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[--[[
	Builds fighter rigs from scratch (HumanoidRootPart + 18 bone parts joined by Motor6D) and dresses them
	with Appearance. Building our own rig keeps the game independent of avatar assets and guarantees every
	joint is a Motor6D the client animator can drive.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local RigDef = require(Shared.RigDef)
local Appearance = require(Shared.Appearance)

local CharacterService = {}

local function bonePart(name)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = Vector3.new(0.15, 0.15, 0.15)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	return p
end

--[[ Returns model, bones. role: "Player", "CPU", "Referee", "Dummy". ]]
function CharacterService.BuildRig(profile, name, role, at: CFrame?)
	local model = Instance.new("Model")
	model.Name = name
	local offsets, d = RigDef.Offsets(profile)
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = RigDef.RootSize
	hrp.Transparency = 1
	hrp.CanCollide = true
	hrp.CanQuery = false
	hrp.CastShadow = false
	local base = at or CFrame.new(0, 20, 0)
	hrp.CFrame = base * CFrame.new(0, RigDef.HipHeightM * d.scale, 0)
	hrp.Parent = model
	model.PrimaryPart = hrp
	local bones = { HumanoidRootPart = hrp }
	for _, def in RigDef.Bones do
		local parent = bones[def.parent]
		local part = bonePart(def.name)
		local off = offsets[def.name]
		part.CFrame = parent.CFrame * CFrame.new(off)
		local m = Instance.new("Motor6D")
		m.Name = def.motor
		m.Part0 = parent
		m.Part1 = part
		m.C0 = CFrame.new(off)
		m.C1 = CFrame.identity
		m.Parent = part
		part.Parent = model
		bones[def.name] = part
	end
	-- colliders: used for ragdolls (they only collide while ragdolled)
	for boneName, col in RigDef.Colliders do
		local bone = bones[boneName]
		if bone then
			local c = Instance.new("Part")
			c.Name = "Col_" .. boneName
			c.Size = col.s * d.scale
			c.Transparency = 1
			c.CanCollide = false
			c.CanQuery = false
			c.CanTouch = false
			c.Massless = true
			c.CastShadow = false
			c.CollisionGroup = "Ragdoll"
			local w = Instance.new("Weld")
			w.Part0 = bone
			w.Part1 = c
			w.C0 = CFrame.new(col.c * d.scale)
			w.Parent = c
			c.CFrame = bone.CFrame * w.C0
			c.Parent = model
		end
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.AutomaticScalingEnabled = false
	hum.HipHeight = RigDef.HipHeight(profile)
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.MaxHealth = 100
	hum.Health = 100
	hum.WalkSpeed = Config.Movement.lobbyWalkSpeed
	hum.UseJumpPower = true
	hum.JumpPower = 38
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.NameDisplayDistance = 40
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.DisplayName = profile.nickname ~= "" and profile.nickname or name
	hum.Parent = model
	-- facing control used in the ring
	local att = Instance.new("Attachment")
	att.Name = "FaceAtt"
	att.Parent = hrp
	local ao = Instance.new("AlignOrientation")
	ao.Name = "Facing"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.Responsiveness = 80
	ao.MaxTorque = 1e8
	ao.Enabled = false
	ao.Parent = hrp
	Appearance.Apply(model, bones, profile)
	model:SetAttribute("Role", role)
	model:SetAttribute("Southpaw", profile.southpaw == true)
	model:SetAttribute("Scale", d.scale)
	model:SetAttribute("State", "Idle")
	CollectionService:AddTag(model, "NBRig")
	return model, bones
end

function CharacterService.Bones(model)
	local bones = { HumanoidRootPart = model:FindFirstChild("HumanoidRootPart") }
	for _, def in RigDef.Bones do
		bones[def.name] = model:FindFirstChild(def.name)
	end
	return bones
end

--[[ Re-dress an existing rig (profile edits from the creator). Bone proportions are rebuilt by respawning. ]]
function CharacterService.Redress(model, profile)
	Appearance.Apply(model, CharacterService.Bones(model), profile)
	model:SetAttribute("Southpaw", profile.southpaw == true)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then hum.DisplayName = profile.nickname ~= "" and profile.nickname or model.Name end
end

function CharacterService.SpawnPlayer(player: Player, profile, at: CFrame)
	local old = player.Character
	local model = CharacterService.BuildRig(profile, player.Name, "Player", at)
	model.Parent = workspace
	player.Character = model
	if old and old ~= model then old:Destroy() end
	return model
end

function CharacterService.SpawnPoint()
	local map = workspace:FindFirstChild("Map")
	local spawn = map and map:FindFirstChild("LobbySpawn", true)
	if spawn and spawn:IsA("BasePart") then
		local offset = Vector3.new(math.random(-6, 6), 0, math.random(-6, 6))
		return CFrame.new(spawn.Position + offset + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, math.rad(spawn.Orientation.Y), 0)
	end
	return CFrame.new(0, 3, 0)
end

-- keep Players from auto-loading default avatars
Players.CharacterAutoLoads = false

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="761">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[--[[
	One fight in one ring: intro, timed rounds, the referee and his ten-count, the get-up minigame, three
	judges with their own habits, the corner between rounds, doctor stoppages, KO ragdolls and the result.
	The ring model publishes the match state as attributes so every client can draw the HUD.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local PunchData = require(Shared.PunchData)
local Util = require(Shared.Util)

local Fighter = require(script.Parent.Fighter)
local AI = require(script.Parent.AI)
local Ragdoll = require(script.Parent.Ragdoll)

local Remotes = ReplicatedStorage:WaitForChild("NeonBayRemotes")
local ImpactEv = Remotes:WaitForChild("Impact")
local MatchEv = Remotes:WaitForChild("MatchEvent")

local Match = {}
Match.__index = Match

local function now() return workspace:GetServerTimeNow() end

local JUDGES = {
	{ name = "Marisol Vega", power = 1.2, activity = 0.8, defense = 1.0, ring = 1.0 },
	{ name = "Hank 'Two-Cards' Doyle", power = 1.6, activity = 0.6, defense = 0.5, ring = 0.8 },
	{ name = "Dr. Anan Sirikul", power = 0.9, activity = 1.3, defense = 1.2, ring = 1.2 },
}

local CORNER = { "WORK THE CUT", "ICE THE SWELLING", "CATCH YOUR BREATH", "GO FOR THE KO" }
Match.CornerOptions = CORNER

--[[
	ring: the ring model (must contain Canvas, RedCorner, BlueCorner, Neutral1, Neutral2 parts)
	red / blue: { model, player?, name, nick, record, stats, style, southpaw, injuries?, rosterId? }
	hooks: { onEnd(match, result), buildReferee(ring) -> model }
]]
function Match.new(ring, red, blue, opts)
	local self = setmetatable({}, Match)
	self.ring = ring
	self.canvas = ring:FindFirstChild("Canvas")
	self.center = self.canvas.Position + Vector3.new(0, self.canvas.Size.Y / 2, 0)
	self.opts = opts or {}
	self.rounds = math.max(3, self.opts.rounds or 3)
	self.round = 0
	self.clock = Config.Match.roundLength
	self.phase = "Intro"
	self.phaseT = 0
	self.Red = Fighter.new(red.model, { player = red.player, name = red.name, nick = red.nick, record = red.record, stats = red.stats, style = red.style, southpaw = red.southpaw, injuries = red.injuries, corner = 0 })
	self.Blue = Fighter.new(blue.model, { player = blue.player, name = blue.name, nick = blue.nick, record = blue.record, stats = blue.stats, style = blue.style, southpaw = blue.southpaw, injuries = blue.injuries, corner = 1 })
	self.Red.opponent, self.Blue.opponent = self.Blue, self.Red
	self.Red.entry, self.Blue.entry = red, blue
	self.ais = {}
	local diff = self.opts.difficulty or 0.6
	if self.Red.isNPC then self.ais[self.Red] = AI.new(self.Red, self.Blue, diff) end
	if self.Blue.isNPC then self.ais[self.Blue] = AI.new(self.Blue, self.Red, diff) end
	self.judges = {}
	for _, j in JUDGES do table.insert(self.judges, { def = j, red = {}, blue = {} }) end
	self.cornerChoice = {}
	self.getUp = 0
	self.count = 0
	self.countT = 0
	self.clinchT = 0
	self.referee = self.opts.buildReferee and self.opts.buildReferee(self) or nil
	-- publish
	ring:SetAttribute("Busy", true)
	ring:SetAttribute("WinnerCorner", "")
	ring:SetAttribute("Comment", "")
	self:SetRingValue("RedModel", self.Red.model)
	self:SetRingValue("BlueModel", self.Blue.model)
	self:SetRingValue("RefModel", self.referee)
	ring:SetAttribute("RedName", self.Red.name)
	ring:SetAttribute("BlueName", self.Blue.name)
	ring:SetAttribute("RedNick", self.Red.nick)
	ring:SetAttribute("BlueNick", self.Blue.nick)
	ring:SetAttribute("RedRecord", self.Red.record)
	ring:SetAttribute("BlueRecord", self.Blue.record)
	ring:SetAttribute("RedStyle", Config.StyleNames[self.Red.style] or self.Red.style)
	ring:SetAttribute("BlueStyle", Config.StyleNames[self.Blue.style] or self.Blue.style)
	ring:SetAttribute("Rounds", self.rounds)
	ring:SetAttribute("Bio", self.opts.bio or "")
	for k, v in self.Red.stats do ring:SetAttribute("RedS_" .. k, v) end
	for k, v in self.Blue.stats do ring:SetAttribute("BlueS_" .. k, v) end
	for _, f in { self.Red, self.Blue } do
		f.model:SetAttribute("Fighter", true)
		f.model:SetAttribute("Corner", f.corner)
		local ov = f.model:FindFirstChild("Opponent") or Instance.new("ObjectValue")
		ov.Name = "Opponent"
		ov.Value = f.opponent.model
		ov.Parent = f.model
		local rv = f.model:FindFirstChild("Ring") or Instance.new("ObjectValue")
		rv.Name = "Ring"
		rv.Value = ring
		rv.Parent = f.model
		local hrp = f.hrp
		if f.hum then
			f.hum.AutoRotate = false
			f.hum.JumpPower = 0
		end
		local face = hrp:FindFirstChild("Facing")
		if face then face.Enabled = true end
		f:SyncInjuries()
	end
	self:PlaceInCorners()
	self:SetPhase("Intro")
	self:Event({ type = "intro" })
	return self
end

function Match:SetRingValue(name, inst)
	local v = self.ring:FindFirstChild(name)
	if not v then
		v = Instance.new("ObjectValue")
		v.Name = name
		v.Parent = self.ring
	end
	v.Value = inst
end

function Match:Event(t)
	t.ring = self.ring
	MatchEv:FireAllClients(t)
end

function Match:Say(text)
	self.ring:SetAttribute("Comment", text)
	self.ring:SetAttribute("CommentT", now())
end

function Match:Signal(text)
	if self.referee then
		self.referee:SetAttribute("Signal", text)
		self.referee:SetAttribute("SignalT", now())
	end
end

function Match:SetPhase(p)
	self.phase = p
	self.phaseT = 0
	self.ring:SetAttribute("Phase", p)
end

function Match:Corner(name)
	local c = self.ring:FindFirstChild(name)
	return c and c.Position or self.center
end

function Match:Place(f, cornerName)
	local pos = self:Corner(cornerName)
	local look = Util.flatUnit(self.center - pos)
	local y = self.center.Y + (f.hum and f.hum.HipHeight or 2) + f.hrp.Size.Y / 2 + 0.05
	local cf = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X, y, pos.Z) + look)
	-- the model pivot is the root part, so move the root and let the welded/motored rig follow
	f.model:PivotTo(cf * f.hrp.CFrame:ToObjectSpace(f.model:GetPivot()))
	f.hrp.AssemblyLinearVelocity = Vector3.zero
end

function Match:PlaceInCorners()
	self:Place(self.Red, "RedCorner")
	self:Place(self.Blue, "BlueCorner")
end

function Match:OnRopes(f)
	local l = f.hrp.Position - self.center
	local lim = Config.Ring.ropeHalf - 1.6
	return math.abs(l.X) > lim or math.abs(l.Z) > lim
end

-- ---------------------------------------------------------------- input from players
function Match:FighterFor(player)
	if self.Red.player == player then return self.Red end
	if self.Blue.player == player then return self.Blue end
	return nil
end

function Match:Input(player, msg)
	local f = self:FighterFor(player)
	if not f then return end
	local k = msg.k
	if k == "punch" then
		if self.phase == "Fight" then f:QueuePunch(math.clamp(tonumber(msg.id) or 1, 1, 6), msg.body == true, msg.power == true) end
	elseif k == "guard" then
		f.guard = math.clamp(tonumber(msg.g) or 0, 0, 2)
	elseif k == "lean" then
		local x, y, z = tonumber(msg.x) or 0, tonumber(msg.y) or 0, tonumber(msg.z) or 0
		f.lean = Vector3.new(math.clamp(x, -1, 1), math.clamp(y, -1, 0), math.clamp(z, -1, 0.5))
	elseif k == "clinch" then
		self:TryClinch(f)
	elseif k == "taunt" then
		self:Taunt(f)
	elseif k == "getup" then
		if self.phase == "Knockdown" and self.downed == f and os.clock() - (f.lastGetUpPress or 0) > 0.2 then
			f.lastGetUpPress = os.clock()
			if msg.hit then
				self.getUp += 1 / (2 + f.kdTotal)
			else
				self.getUp = math.max(0, self.getUp - 0.15)
			end
			self.ring:SetAttribute("GetUp", self.getUp)
		end
	elseif k == "corner" then
		if self.phase == "Corner" and not self.cornerChoice[f] then
			local i = math.clamp(tonumber(msg.i) or 3, 1, 4)
			self.cornerChoice[f] = i
			if i == 1 then f:Treat(0.55, 0.08)
			elseif i == 2 then f:Treat(0.1, 0.35)
			elseif i == 3 then f.staminaMax = math.min(105, f.staminaMax + 8); f.headHP = math.min(f.headCap, f.headHP + 8)
			else f.aggression = 1 end
			if i ~= 4 then f.aggression = 0 end
		end
	end
end

function Match:Taunt(f)
	if f.state ~= "Fight" or f.cur then return end
	f.model:SetAttribute("TauntT", now())
	f.stamina = math.min(f.staminaMax, f.stamina + 6)
	self:Event({ type = "popup", text = "SHOWBOAT!", color = Config.Neon.Magenta, at = f:HeadPoint() })
end

function Match:TryClinch(f)
	local o = f.opponent
	if f.state ~= "Fight" or o.state ~= "Fight" then return end
	if (f.hrp.Position - o.hrp.Position).Magnitude > 0.95 * f.scale + 1 then return end
	f:SetState("Clinch")
	o:SetState("Clinch")
	f:CancelPunch(); o:CancelPunch()
	self.clinchT = 1.4 + math.random() * 1
	self:Say(f.name:split(" ")[1] .. " ties him up!")
end

function Match:BreakClinch()
	for _, f in { self.Red, self.Blue } do
		if f.state == "Clinch" then f:SetState("Fight") end
	end
	self:Signal("BREAK!")
	local d = Util.flatUnit(self.Blue.hrp.Position - self.Red.hrp.Position)
	self.Red.model:PivotTo(self.Red.model:GetPivot() - d * 1.2)
	self.Blue.model:PivotTo(self.Blue.model:GetPivot() + d * 1.2)
end

-- ---------------------------------------------------------------- punches
function Match:ResolvePunch(a, def, body, power)
	local d = a.opponent
	if not d or d:IsDown() or self.phase ~= "Fight" then a:OnPunchResult("miss") return end
	local sh = a:ShoulderPoint(def.lead)
	local target
	if body then
		local leftHand = (def.lead and not a.southpaw) or (not def.lead and a.southpaw)
		local side = def.kind == "hook" and (leftHand and 1 or -1) or 0
		target = d:BodyPoint(side)
	elseif def.kind == "upper" then
		target = d:ChinPoint()
	else
		target = d:HeadPoint()
	end
	local reach = def.reach * a.scale * (power and 1.04 or 1) + 0.06 * a.scale
	local toT = target - sh
	local dir = toT.Magnitude > 0 and toT.Unit or a.hrp.CFrame.LookVector
	local facing = a.hrp.CFrame.LookVector:Dot(Util.flatUnit(d.hrp.Position - a.hrp.Position))
	local inRange = toT.Magnitude <= reach and facing > 0.5 and d.state ~= "Clinch"
	local base = { type = "impact", att = a.model, def = d.model, id = def.id, body = body, power = power, pos = target, dir = dir }
	if not inRange then
		a:OnPunchResult("miss")
		base.res = "miss"
		ImpactEv:FireAllClients(base)
		return
	end
	local res, mult = d:Evaluate(a, def, body)
	local counter = res == "clean" and (d:InRecovery() or d:WindingUp() or a.counterWindow > 0)
	if res == "slip" then
		a:OnPunchResult("slip")
		d.counterWindow = 0.6
		d.round.evaded += 1
		base.res = "slip"
		ImpactEv:FireAllClients(base)
		return
	end
	if res == "parry" then
		a:OnPunchResult("parry")
		d.counterWindow = 0.7
		d.round.evaded += 1
		base.res = "parry"
		ImpactEv:FireAllClients(base)
		return
	end
	local dmg = def.damage * Config.DamageScale * a:PowerFactor() * (power and Config.PowerMult or 1) * a:StaminaFactor() * mult * (0.9 + math.random() * 0.2)
	if counter then dmg *= Config.CounterMult end
	dmg *= 1 + (a.aggression or 0) * 0.1
	dmg *= 1 + (d.aggression or 0) * 0.12
	if d.rocked > 0 and not body then dmg *= 1.1 end
	if a.isNPC and d.player then dmg *= self.opts.cpuDamage or 1 end
	local side = (d.hrp.CFrame.RightVector:Dot(dir) > 0) and -1 or 1
	local kd = d:TakeHit(a, def, body, power, dmg, res, side, counter)
	local pk = math.clamp(dmg / 14, 0.1, 1.6)
	base.dmg, base.pk, base.counter = dmg, pk, counter
	if res == "block" then
		a:OnPunchResult("block")
		d.round.blocked += 1
		base.res = "block"
		ImpactEv:FireAllClients(base)
		return
	end
	a:OnPunchResult("clean")
	local r = a.round
	r.landed += 1
	if def.id == 1 then r.jabsLanded += 1 else r.powerLanded += 1 end
	if body then r.bodyLanded += 1 else r.headLanded += 1 end
	if counter then r.counters += 1 end
	r.damage += dmg
	base.res = "clean"
	base.rocked = d.rocked > 0
	ImpactEv:FireAllClients(base)
	if d.rocked > 1.5 and not kd and os.clock() - (self.lastRockSay or 0) > 2.5 then
		self.lastRockSay = os.clock()
		self:Say(d.name:split(" ")[1]:upper() .. " IS HURT! He's in trouble!")
	end
	if kd then self:Knockdown(d, a, dir, pk) end
end

-- ---------------------------------------------------------------- knockdowns
function Match:Knockdown(v, by, dir, pk)
	local ko = v.headHP < -28 or v.kdRound >= 2 or (v.kdTotal >= 3 and math.random() < 0.6)
	by.round.knockdowns += 1
	v:KnockDown(dir, ko)
	self:Event({ type = "knockdown", victim = v.model, ko = ko, dir = dir })
	self:Say(ko and ("DOWN GOES " .. v.name:upper() .. "! HE'S OUT COLD!") or ("DOWN GOES " .. v.name:upper() .. "!"))
	self.downed = v
	if v.kdRound >= 3 then
		self:KO(v, dir, pk)
		self:End(by, "TKO", "Three knockdowns in round " .. self.round)
		return
	end
	if ko then
		self:KO(v, dir, pk)
		self:End(by, "KO", "Knockout, round " .. self.round .. " " .. Util.formatTime(Config.Match.roundLength - self.clock))
		return
	end
	self:SetPhase("Knockdown")
	self.count = 0
	self.countT = -Config.Match.countStartDelay
	self.getUp = 0
	self.ring:SetAttribute("Count", 0)
	self.ring:SetAttribute("GetUp", 0)
	self.ring:SetAttribute("Downed", v.corner == 0 and "Red" or "Blue")
	self.ring:SetAttribute("GetUpZone", Util.lerp(0.12, 0.3, v:Stat("heart") / 100) * Util.lerp(1, 0.6, math.clamp((v.kdTotal - 1) / 3, 0, 1)))
	by:SetState("Corner")
	-- send the other fighter to the farther neutral corner
	local hp = v.hrp.Position
	local n1, n2 = self:Corner("Neutral1"), self:Corner("Neutral2")
	task.delay(0.8, function()
		if self.phase == "Knockdown" then self:Place(by, (n1 - hp).Magnitude > (n2 - hp).Magnitude and "Neutral1" or "Neutral2") end
	end)
	if v.isNPC then
		local will = v:Stat("heart") / 100 + 0.4 - (v.kdTotal - 1) * 0.15 - math.clamp(-v.headHP / 40, 0, 1) * 0.35
		self.aiGetUpAt = will > math.random() * 0.9 and math.random(4, 9) or 11
	end
end

function Match:KO(v, dir, pk)
	v:SetState("KO")
	local impulse = (Util.flatUnit(dir) * (420 + pk * 380) + Vector3.new(0, 140, 0))
	task.delay(0.12, function()
		if v.model.Parent then Ragdoll.Enable(v.model, impulse) end
	end)
end

function Match:LiverKnockdown(v)
	if self.phase ~= "Fight" or v:IsDown() then return end
	self:Say("A LIVER SHOT! " .. v.name:split(" ")[1] .. " folds in half!")
	self:Event({ type = "popup", text = "LIVER SHOT", color = Config.Neon.Orange, at = v:BodyPoint(0) })
	self:Knockdown(v, v.opponent, -v.hrp.CFrame.LookVector, 0.4)
end

function Match:TickCount(dt)
	local v = self.downed
	if not v then
		self.resumeT -= dt
		if self.resumeT <= 0 then
			for _, f in { self.Red, self.Blue } do
				if f.state == "GetUp" or f.state == "Corner" then f:SetState("Fight") end
			end
			self:SetPhase("Fight")
			self:Signal("BOX!")
		end
		return
	end
	self.countT += dt
	if self.countT >= Config.Match.countInterval then
		self.countT -= Config.Match.countInterval
		self.count += 1
		self.ring:SetAttribute("Count", self.count)
		self:Signal(tostring(self.count))
		self:Event({ type = "count", n = self.count })
		if self.count >= 10 then
			self:KO(v, -v.hrp.CFrame.LookVector, 0.2)
			self:End(v.opponent, "KO", "Counted out, round " .. self.round)
			return
		end
	end
	if self.count < 1 then return end
	if (v.isNPC and self.count >= (self.aiGetUpAt or 11)) or (not v.isNPC and self.getUp >= 1) then
		v:GetUp()
		self:Signal("Can you continue?")
		self:Say(v.name:split(" ")[1] .. " beats the count at " .. self.count .. "!")
		self.downed = nil
		self.resumeT = 2.4
		self.ring:SetAttribute("Downed", "")
		self:Event({ type = "getup", victim = v.model })
	end
end

-- ---------------------------------------------------------------- rounds
function Match:StartRound(n)
	self.round = n
	self.clock = Config.Match.roundLength
	self.ring:SetAttribute("Round", n)
	self.ring:SetAttribute("Clock", self.clock)
	for _, f in { self.Red, self.Blue } do
		f.kdRound = 0
		f.round = Fighter.NewStats()
		f:SetState("Intro")
	end
	self:PlaceInCorners()
	self:SetPhase("RoundStart")
	self:Event({ type = "round", n = n, final = n == self.rounds })
end

function Match:EndRound()
	self:Event({ type = "bell", count = 3 })
	self:Signal("TIME!")
	self:ScoreRound()
	for _, f in { self.Red, self.Blue } do f:SetState("Corner"); f:CancelPunch() end
	self:SetPhase("RoundEnd")
end

local function points(me, j)
	return me.jabsLanded * 1 * j.activity + me.powerLanded * 1.9 * j.power + me.damage * 0.06 * j.power + me.evaded * 0.35 * j.defense
		+ me.blocked * 0.15 * j.defense + me.center * 0.05 * j.ring + me.pressure * 0.03 * j.ring + me.thrown * 0.08 * j.activity + me.counters * 0.8
end

function Match:ScoreRound()
	for _, j in self.judges do
		local r, b = points(self.Red.round, j.def), points(self.Blue.round, j.def)
		local margin = (r - b) / math.max(1, r + b) + (math.random() - 0.5) * 0.16
		local rs, bs = 10, 10
		if margin > 0.06 then bs = 9 elseif margin < -0.06 then rs = 9 elseif math.random() < 0.5 then if margin >= 0 then bs = 9 else rs = 9 end end
		rs -= self.Blue.round.knockdowns
		bs -= self.Red.round.knockdowns
		rs, bs = math.max(rs, 6), math.max(bs, 6)
		if rs == bs and rs < 10 then rs += 1; bs += 1 end
		table.insert(j.red, rs)
		table.insert(j.blue, bs)
	end
	Fighter.AddStats(self.Red.total, self.Red.round)
	Fighter.AddStats(self.Blue.total, self.Blue.round)
end

function Match:CornerBegin()
	self.cornerChoice = {}
	-- doctor
	for _, f in { self.Red, self.Blue } do
		if self.round >= 2 and (f:MaxCut() > 0.95 or f:EyeClosure(true) > 0.98 or f:EyeClosure(false) > 0.98) and math.random() < 0.5 then
			self:Say("The ringside doctor waves it off! " .. f.name:split(" ")[1] .. " can't continue!")
			self:End(f.opponent, "TKO", "Doctor stoppage after round " .. self.round)
			return
		end
	end
	if self.round >= self.rounds then
		self:Decision()
		return
	end
	for _, f in { self.Red, self.Blue } do
		if f.player then
			local r, o = f.round, f.opponent.round
			local advice
			if f:MaxCut() > 0.4 then advice = "That cut is ugly. Let me work on it or the doc stops this."
			elseif math.max(f:EyeClosure(true), f:EyeClosure(false)) > 0.3 then advice = "Your eye is closing. Keep that side covered."
			elseif f.stamina < 35 or f.staminaMax < 70 then advice = "You're gassing! Stop loading up on every punch and breathe."
			elseif r.landed < o.landed then advice = "He's outworking you. Double the jab and go downstairs."
			else advice = "Good round! Hands up, make him miss, make him pay." end
			MatchEv:FireClient(f.player, { ring = self.ring, type = "corner", round = self.round, advice = advice, options = CORNER,
				me = r, them = o, cut = f:MaxCut(), eyeL = f:EyeClosure(true), eyeR = f:EyeClosure(false), concussion = f.concussion or 0, ribs = f.bodyTrauma or 0 })
		else
			f:Treat(0.25, 0.15)
		end
	end
end

function Match:CornerEnd()
	for _, f in { self.Red, self.Blue } do
		if not self.cornerChoice[f] and f.player then f:Treat(0.2, 0.1) end
		f:Recover(1)
	end
	self:StartRound(self.round + 1)
end

function Match:Decision()
	local r, b = 0, 0
	for _, j in self.judges do
		local jr, jb = 0, 0
		for i = 1, #j.red do jr += j.red[i]; jb += j.blue[i] end
		if jr > jb then r += 1 elseif jb > jr then b += 1 end
	end
	local w, method
	if r >= 2 and b == 0 then w, method = self.Red, (r == 3 and "UNANIMOUS DECISION" or "MAJORITY DECISION")
	elseif b >= 2 and r == 0 then w, method = self.Blue, (b == 3 and "UNANIMOUS DECISION" or "MAJORITY DECISION")
	elseif r == 2 then w, method = self.Red, "SPLIT DECISION"
	elseif b == 2 then w, method = self.Blue, "SPLIT DECISION"
	else method = "DRAW" end
	self:End(w, method, "After " .. self.rounds .. " rounds")
end

function Match:End(winner, method, detail)
	if self.ended then return end
	self.ended = true
	self.winner = winner
	self:SetPhase(method == "KO" and "KO" or "Result")
	for _, f in { self.Red, self.Blue } do
		if not f:IsDown() then f:SetState(f == winner and "Celebrate" or "Dejected") end
	end
	if self.round > 0 and #self.judges[1].red < self.round then
		Fighter.AddStats(self.Red.total, self.Red.round)
		Fighter.AddStats(self.Blue.total, self.Blue.round)
	end
	local cards = {}
	for _, j in self.judges do table.insert(cards, { name = j.def.name, red = j.red, blue = j.blue }) end
	local result = {
		type = "result",
		title = winner and (winner.name:upper() .. " WINS") or "DRAW",
		method = method .. "  -  " .. detail,
		winner = winner and (winner.corner == 0 and "Red" or "Blue") or "",
		ko = method == "KO" or method == "TKO",
		cards = cards,
		red = self.Red.total, blue = self.Blue.total,
		redName = self.Red.name, blueName = self.Blue.name,
	}
	self.result = result
	self.ring:SetAttribute("WinnerCorner", result.winner)
	if self.opts.onEnd then
		local extra = self.opts.onEnd(self, result)
		if extra then for k, v in extra do result[k] = v end end
	end
	self:Event(result)
	self:Event({ type = "bell", count = 3 })
end

-- ---------------------------------------------------------------- tick
function Match:Tick(dt)
	self.phaseT += dt
	local p = self.phase
	if p == "Intro" then
		if self.phaseT > Config.Match.introTime then self:StartRound(1) end
	elseif p == "RoundStart" then
		if self.phaseT > 1.6 then
			self:SetPhase("Fight")
			self.Red:SetState("Fight"); self.Blue:SetState("Fight")
			self:Event({ type = "bell", count = 1 })
			self:Signal("FIGHT!")
		end
	elseif p == "Fight" then
		self.clock -= dt
		self.ring:SetAttribute("Clock", math.max(0, self.clock))
		local rc, bc = Util.flat(self.Red.hrp.Position - self.center).Magnitude, Util.flat(self.Blue.hrp.Position - self.center).Magnitude
		if rc < bc - 1.3 then self.Red.round.center += dt elseif bc < rc - 1.3 then self.Blue.round.center += dt end
		for _, f in { self.Red, self.Blue } do
			if f.move.Y > 0.3 then f.round.pressure += dt end
		end
		if self.Red.state == "Clinch" then
			self.clinchT -= dt
			if self.clinchT <= 0 then self:BreakClinch() end
		end
		if self.clock <= 0 then self:EndRound() end
	elseif p == "Knockdown" then
		self:TickCount(dt)
	elseif p == "RoundEnd" then
		if self.phaseT > 2.4 then
			self:SetPhase("Corner")
			self:PlaceInCorners()
			self:CornerBegin()
		end
	elseif p == "Corner" then
		if self.phaseT > Config.Match.cornerTime then self:CornerEnd() end
	elseif p == "KO" then
		if self.phaseT > 4 then self:SetPhase("Result") end
	elseif p == "Result" then
		if self.phaseT > Config.Match.resultTime then
			self:SetPhase("Done")
			if self.opts.onClose then self.opts.onClose(self) end
			return false
		end
	end

	-- fighters
	local onImpact = function(f, def, body, power) self:ResolvePunch(f, def, body, power) end
	local onLiver = function(f) self:LiverKnockdown(f) end
	local ring = { center = self.center, onRopes = function(f) return self:OnRopes(f) end }
	for _, f in { self.Red, self.Blue } do
		local ai = self.ais[f]
		if ai and (p == "Fight" or p == "Intro" or p == "RoundStart") then
			local dir = ai:Tick(dt, ring, function(x) self:TryClinch(x) end, function(x) self:Taunt(x) end)
			if f.hum and f.state == "Fight" then f.hum:Move(dir, false) elseif f.hum then f.hum:Move(Vector3.zero, false) end
		elseif ai and f.hum then
			f.hum:Move(Vector3.zero, false)
		end
		if p ~= "Fight" and f.player then f.lean, f.guard = Vector3.zero, 0 end
		f:Tick(dt, onImpact, onLiver)
		-- NPCs face their opponent (players' own clients steer their facing)
		if f.isNPC and f.state ~= "KO" then
			local face = f.hrp:FindFirstChild("Facing")
			local look = Util.flatUnit(f.opponent.hrp.Position - f.hrp.Position, f.hrp.CFrame.LookVector)
			if (f.state == "Corner" or f.state == "Intro") and p ~= "Fight" then look = Util.flatUnit(self.center - f.hrp.Position, look) end
			if face then face.CFrame = CFrame.lookAt(Vector3.zero, look) end
		end
	end
	return true
end

function Match:PlayerLeft(player)
	local f = self:FighterFor(player)
	if f and not self.ended then
		self:End(f.opponent, "TKO", "Opponent left the arena")
	end
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="762">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[--[[
	NEON BAY: THE PIT  -  server entry
	Players walk the warehouse as their custom boxer. Step on both corner pads of a ring for a PvP fight, or
	open CAREER to fight the Pit's ranked CPU fighters. All combat is resolved here (see Fighter / Match).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local TextService = game:GetService("TextService")

-- remotes first: other modules wait for them
local remotes = Instance.new("Folder")
remotes.Name = "NeonBayRemotes"
local function remote(name, class)
	local r = Instance.new(class or "RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local InputEv = remote("Input")
local LeanEv
do
	local ok, ev = pcall(function() return remote("Lean", "UnreliableRemoteEvent") end)
	LeanEv = ok and ev or remote("Lean")
end
remote("Impact")
remote("MatchEvent")
local NotifyEv = remote("Notify")
local RequestFn = remote("Request", "RemoteFunction")
remotes.Parent = ReplicatedStorage

pcall(function()
	PhysicsService:RegisterCollisionGroup("Ragdoll")
	PhysicsService:CollisionGroupSetCollidable("Ragdoll", "Ragdoll", false)
end)

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local CharacterService = require(script.Parent.CharacterService)
local Data = require(script.Parent.Data)
local Match = require(script.Parent.Match)

local matches = {} -- ring -> match
local fighterOf = {} -- player -> match

local function notify(player, text, color)
	NotifyEv:FireClient(player, { text = text, color = color })
end

-- ---------------------------------------------------------------- helpers
local function rings()
	local map = workspace:FindFirstChild("Map")
	local list = {}
	if map then
		for _, d in map:GetDescendants() do
			if d:IsA("Model") and d:GetAttribute("IsRing") then table.insert(list, d) end
		end
	end
	table.sort(list, function(a, b) return (a:GetAttribute("RingOrder") or 0) < (b:GetAttribute("RingOrder") or 0) end)
	return list
end

local function freeRing()
	for _, r in rings() do
		if not r:GetAttribute("Busy") then return r end
	end
	return nil
end

local function record(d)
	return string.format("%d-%d%s (%d KO)", d.wins, d.losses, d.draws > 0 and ("-" .. d.draws) or "", d.kos)
end

local function publish(player)
	local d = Data.Get(player)
	if not d then return end
	player:SetAttribute("Cash", d.cash)
	player:SetAttribute("Wins", d.wins)
	player:SetAttribute("Losses", d.losses)
	player:SetAttribute("Draws", d.draws)
	player:SetAttribute("KOs", d.kos)
	player:SetAttribute("Rank", d.rank)
	player:SetAttribute("Created", d.created)
	for k, v in d.train do player:SetAttribute("Train_" .. k, v) end
	local inj = 0
	for _, v in d.injuries do if type(v) == "number" then inj = math.max(inj, v) end end
	player:SetAttribute("Injured", inj)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		ls.Wins.Value = d.wins
		ls.KOs.Value = d.kos
	end
end

local function spawnPlayer(player)
	local d = Data.Get(player)
	if not d then return end
	local look = Util.deepCopy(d.look)
	look.outfit = "boxer"
	local model = CharacterService.SpawnPlayer(player, look, CharacterService.SpawnPoint())
	model:SetAttribute("Injuries", nil)
	-- carried damage shows on the face in the lobby too
	for k, v in d.injuries do
		if type(v) == "number" and k ~= "concussion" and k ~= "bodyTrauma" then model:SetAttribute("I_" .. k, v) end
	end
	return model
end

-- ---------------------------------------------------------------- referee
local REF_LOOK = {
	name = "Referee", nickname = "", female = false, skin = 4, hair = 3, hairColor = 4, beard = 3, beardColor = 4, brows = 1,
	eye = 8, jaw = 0.7, bulk = 1.05, muscle = 0.3, height = 1.0, trunks = 4, gloves = 3, accent = 9, outfit = "street",
}

local function buildReferee(m)
	local spot = m.ring:FindFirstChild("Neutral2")
	local at = CFrame.new((spot and spot.Position or m.center) + Vector3.new(0, 0.5, 0))
	local model = CharacterService.BuildRig(REF_LOOK, "Referee", "Referee", at)
	model.Parent = workspace
	pcall(function() model.HumanoidRootPart:SetNetworkOwner(nil) end)
	return model
end

local function tickReferee(m)
	local ref = m.referee
	if not ref or not ref.Parent then return end
	local hum = ref:FindFirstChildOfClass("Humanoid")
	local hrp = ref:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end
	local a, b = m.Red.hrp.Position, m.Blue.hrp.Position
	local target
	if m.phase == "Knockdown" and m.downed then
		local dp = m.downed.hrp.Position
		target = dp - Util.flatUnit(dp - m.center) * 3.2
	else
		local mid = (a + b) / 2
		local line = Util.flatUnit(b - a)
		local perp = line:Cross(Vector3.yAxis)
		local c1, c2 = mid + perp * 5.5, mid - perp * 5.5
		target = (c1 - m.center).Magnitude < (c2 - m.center).Magnitude and c1 or c2
	end
	local lim = Config.Ring.ropeHalf - 1.4
	local l = target - m.center
	target = m.center + Vector3.new(math.clamp(l.X, -lim, lim), 0, math.clamp(l.Z, -lim, lim))
	if (Util.flat(target - hrp.Position)).Magnitude > 1 then hum:MoveTo(target) else hum:Move(Vector3.zero) end
end

-- ---------------------------------------------------------------- matches
local function entryForPlayer(player)
	local d = Data.Get(player)
	local look = d.look
	return {
		model = player.Character, player = player, name = (look.name ~= "" and look.name or player.DisplayName), nick = look.nickname or "",
		record = record(d), stats = Data.FightStats(d), style = "OutBoxer", southpaw = look.southpaw == true, injuries = d.injuries,
	}
end

local function closeMatch(m)
	matches[m.ring] = nil
	for _, f in { m.Red, m.Blue } do
		if f.player then
			fighterOf[f.player] = nil
			if f.player.Parent then spawnPlayer(f.player) end
		elseif f.model.Parent then
			f.model:Destroy()
		end
	end
	if m.referee then m.referee:Destroy() end
	m.ring:SetAttribute("Busy", false)
	m.ring:SetAttribute("Phase", "Idle")
	for _, n in { "RedModel", "BlueModel", "RefModel" } do
		local v = m.ring:FindFirstChild(n)
		if v then v.Value = nil end
	end
end

local function onMatchEnd(m, result)
	local extra = {}
	for _, f in { m.Red, m.Blue } do
		if f.player then
			local d = Data.Get(f.player)
			if d then
				local won = m.winner == f
				local draw = m.winner == nil
				local roster = f.opponent.entry.rosterIndex
				local purse
				if draw then
					d.draws += 1
					purse = roster and math.floor(Config.Roster[roster].purse / 2) or 250
				elseif won then
					d.wins += 1
					if result.ko then d.kos += 1 end
					purse = roster and math.floor(Config.Roster[roster].purse * (result.ko and 1.25 or 1)) or 600
					if roster and roster == d.rank + 1 then d.rank = math.min(#Config.Roster, d.rank + 1) end
				else
					d.losses += 1
					purse = roster and math.floor(Config.Roster[roster].purse / 4) or 150
				end
				d.cash += purse
				d.injuries = f:InjuryRecord()
				publish(f.player)
				Data.Save(f.player)
				extra[(f.corner == 0 and "redPurse" or "bluePurse")] = purse
			end
		end
	end
	return extra
end

local function startMatch(ring, red, blue, opts)
	opts = opts or {}
	opts.buildReferee = buildReferee
	opts.onEnd = onMatchEnd
	opts.onClose = closeMatch
	for _, e in { red, blue } do
		if e.player then
			fighterOf[e.player] = true
			e.model = e.player.Character
		end
	end
	local m = Match.new(ring, red, blue, opts)
	matches[ring] = m
	for _, e in { red, blue } do
		if e.player then fighterOf[e.player] = m end
	end
	return m
end

local function startCareer(player, rosterIndex)
	if fighterOf[player] then return false, "You're already fighting." end
	local d = Data.Get(player)
	if not d then return false, "Loading..." end
	local ring = freeRing()
	if not ring then return false, "Both rings are busy. Watch the fight or try again soon." end
	local idx = rosterIndex or math.min(#Config.Roster, d.rank + 1)
	if idx > d.rank + 1 then return false, "You have to climb the rankings first." end
	local opp = Config.Roster[idx]
	local look = Util.deepCopy(opp.look)
	look.outfit = "boxer"
	look.southpaw = opp.southpaw
	look.nickname = opp.nick
	local corner = ring:FindFirstChild("BlueCorner")
	local model = CharacterService.BuildRig(look, opp.name, "CPU", CFrame.new(corner.Position + Vector3.new(0, 0.5, 0)))
	model.Parent = workspace
	pcall(function() model.HumanoidRootPart:SetNetworkOwner(nil) end)
	local diff = math.clamp(0.45 + idx * 0.06, 0.45, 0.95)
	startMatch(ring, entryForPlayer(player), {
		model = model, name = opp.name, nick = opp.nick, record = string.format("%d-%d (%d KO)", opp.w, opp.l, opp.ko), stats = opp.stats,
		style = opp.style, southpaw = opp.southpaw, rosterIndex = idx,
	}, { rounds = opp.rounds, difficulty = diff, bio = opp.bio, cpuDamage = 0.9 })
	return true
end

-- ---------------------------------------------------------------- players
Players.PlayerAdded:Connect(function(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local w = Instance.new("IntValue"); w.Name = "Wins"; w.Parent = ls
	local k = Instance.new("IntValue"); k.Name = "KOs"; k.Parent = ls
	ls.Parent = player
	Data.Load(player)
	publish(player)
	spawnPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)
	local m = fighterOf[player]
	if type(m) == "table" then m:PlayerLeft(player) end
	Data.Release(player)
	fighterOf[player] = nil
end)

-- ---------------------------------------------------------------- input
local function lobbyPunch(player, id)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if os.clock() - (char:GetAttribute("LastPunchClock") or 0) < 0.22 then return end
	char:SetAttribute("LastPunchClock", os.clock())
	local t0 = workspace:GetServerTimeNow()
	char:SetAttribute("Act", id)
	char:SetAttribute("ActId", (char:GetAttribute("ActId") or 0) + 1)
	char:SetAttribute("ActT0", t0)
	char:SetAttribute("ActScale", 1)
	task.delay(0.55, function()
		if char.Parent and char:GetAttribute("ActT0") == t0 then char:SetAttribute("Act", 0) end
	end)
	-- heavy bags
	local map = workspace:FindFirstChild("Map")
	if not map then return end
	for _, bag in map:GetDescendants() do
		if bag:IsA("BasePart") and bag.Name == "Bag" then
			local to = bag.Position - hrp.Position
			if Util.flat(to).Magnitude < 4.2 and math.abs(to.Y) < 4 and hrp.CFrame.LookVector:Dot(Util.flatUnit(to)) > 0.4 then
				task.delay(0.18, function()
					bag:ApplyImpulse(Util.flatUnit(to) * bag.AssemblyMass * (id == 1 and 9 or 16))
					ReplicatedStorage.NeonBayRemotes.Impact:FireAllClients({ type = "bag", pos = bag.Position, power = id ~= 1 })
				end)
				break
			end
		end
	end
end

InputEv.OnServerEvent:Connect(function(player, msg)
	if type(msg) ~= "table" then return end
	local m = fighterOf[player]
	if type(m) == "table" then
		m:Input(player, msg)
	elseif msg.k == "punch" then
		lobbyPunch(player, math.clamp(tonumber(msg.id) or 1, 1, 6))
	end
end)

LeanEv.OnServerEvent:Connect(function(player, x, y, z)
	local m = fighterOf[player]
	if type(m) == "table" then m:Input(player, { k = "lean", x = x, y = y, z = z }) end
end)

-- ---------------------------------------------------------------- requests from the UI
local function clampLook(look, old)
	local o = Util.deepCopy(old)
	local function int(k, lo, hi) if type(look[k]) == "number" then o[k] = math.clamp(math.floor(look[k]), lo, hi) end end
	local function num(k, lo, hi) if type(look[k]) == "number" then o[k] = math.clamp(look[k], lo, hi) end end
	local function bool(k) if type(look[k]) == "boolean" then o[k] = look[k] end end
	int("skin", 1, #Config.SkinTones); int("hair", 1, #Config.HairNames); int("hairColor", 1, #Config.HairColors)
	int("beard", 1, #Config.BeardNames); int("beardColor", 0, #Config.HairColors); int("brows", 1, #Config.BrowNames)
	int("eye", 1, #Config.EyeColors); int("trunks", 1, #Config.TrunkColors); int("gloves", 1, #Config.GloveColors); int("accent", 1, 9)
	num("jaw", 0, 1); num("bulk", 0.85, 1.35); num("muscle", 0, 1); num("height", 0.92, 1.08)
	bool("female"); bool("southpaw"); bool("tattoo")
	return o
end

local function filter(player, text)
	if type(text) ~= "string" then return "" end
	text = string.sub(text, 1, 18)
	if text == "" then return "" end
	local ok, res = pcall(function()
		local f = TextService:FilterStringAsync(text, player.UserId)
		return f:GetNonChatStringForBroadcastAsync()
	end)
	if ok then return res end
	-- text filtering is unavailable in some Studio sessions; only then fall back to the raw text
	return RunService:IsStudio() and text or ""
end

RequestFn.OnServerInvoke = function(player, kind, arg)
	local d = Data.Get(player)
	if not d then return false, "Loading..." end
	if kind == "saveLook" and type(arg) == "table" then
		if fighterOf[player] then return false, "Not during a fight." end
		local old = d.look
		local new = clampLook(arg, old)
		new.name = filter(player, arg.name)
		if new.name == "" then new.name = player.DisplayName end
		new.nickname = filter(player, arg.nickname)
		d.look = new
		d.created = true
		publish(player)
		local rebuild = new.bulk ~= old.bulk or new.height ~= old.height or new.female ~= old.female or new.muscle ~= old.muscle
		local char = player.Character
		if rebuild or not char then
			local at = char and char:GetPivot() or CharacterService.SpawnPoint()
			local look = Util.deepCopy(new); look.outfit = "boxer"
			CharacterService.SpawnPlayer(player, look, CFrame.new(at.Position - Vector3.new(0, 3, 0)) * at.Rotation)
		else
			local look = Util.deepCopy(new); look.outfit = "boxer"
			CharacterService.Redress(char, look)
		end
		Data.Save(player)
		return true
	elseif kind == "career" then
		return startCareer(player, nil)
	elseif kind == "exhibition" then
		local i = tonumber(arg)
		if not i or i < 1 or i > d.rank then return false, "You haven't beaten that fighter yet." end
		return startCareer(player, i)
	elseif kind == "train" then
		local key = tostring(arg)
		if d.train[key] == nil then return false, "?" end
		local lv = d.train[key]
		if lv >= Config.TrainMax then return false, "Maxed out." end
		local cost = Config.TrainCost(lv)
		if d.cash < cost then return false, "Not enough cash." end
		d.cash -= cost
		d.train[key] = lv + 1
		publish(player)
		return true
	elseif kind == "heal" then
		local cost = 200
		if d.cash < cost then return false, "Not enough cash." end
		d.cash -= cost
		d.injuries = {}
		publish(player)
		if not fighterOf[player] then spawnPlayer(player) end
		return true
	elseif kind == "profile" then
		return true, d
	end
	return false, "Unknown request"
end

-- ---------------------------------------------------------------- PvP corner pads
local padHold = {}
local function padOccupant(pad)
	for _, pl in Players:GetPlayers() do
		local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if hrp and not fighterOf[pl] and (Util.flat(hrp.Position - pad.Position)).Magnitude < pad.Size.X / 2 + 0.5 and math.abs(hrp.Position.Y - pad.Position.Y) < 6 then
			return pl
		end
	end
	return nil
end

task.spawn(function()
	while true do
		task.wait(0.25)
		for _, ring in rings() do
			if not ring:GetAttribute("Busy") then
				local rp, bp = ring:FindFirstChild("RedPad", true), ring:FindFirstChild("BluePad", true)
				if rp and bp then
					local a, b = padOccupant(rp), padOccupant(bp)
					ring:SetAttribute("PadRed", a and a.DisplayName or "")
					ring:SetAttribute("PadBlue", b and b.DisplayName or "")
					if a and b and a ~= b then
						padHold[ring] = (padHold[ring] or 0) + 0.25
						ring:SetAttribute("Countdown", math.max(0, Config.Match.pvpCountdown - padHold[ring]))
						if padHold[ring] >= Config.Match.pvpCountdown then
							padHold[ring] = 0
							ring:SetAttribute("Countdown", -1)
							startMatch(ring, entryForPlayer(a), entryForPlayer(b), { rounds = 3, difficulty = 0.6 })
						end
					else
						padHold[ring] = 0
						ring:SetAttribute("Countdown", -1)
					end
				end
			end
		end
	end
end)

-- ---------------------------------------------------------------- main loop
RunService.Heartbeat:Connect(function(dt)
	for ring, m in matches do
		local ok, alive = pcall(function() return m:Tick(dt) end)
		if not ok then
			warn("[NeonBay] match error:", alive)
			pcall(closeMatch, m)
		elseif alive then
			tickReferee(m)
		end
	end
	-- fell out of the world
	for _, pl in Players:GetPlayers() do
		local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if hrp and hrp.Position.Y < -60 and not fighterOf[pl] then spawnPlayer(pl) end
	end
end)

task.spawn(function()
	while true do
		task.wait(120)
		for _, pl in Players:GetPlayers() do Data.Save(pl) end
	end
end)

game:BindToClose(function()
	for _, pl in Players:GetPlayers() do Data.Save(pl) end
end)

-- heavy bags swing on server physics so every player sees the same swing
task.defer(function()
	local map = workspace:WaitForChild("Map", 10)
	if not map then return end
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "Bag" and not d.Anchored then
			pcall(function() d:SetNetworkOwner(nil) end)
		end
	end
end)

print("[NeonBay] THE PIT v" .. Config.Version .. " server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="763">
        <Properties>
          <string name="Name">Ragdoll</string>
          <string name="Source"><![CDATA[--[[
	Knockout ragdoll: every body Motor6D is swapped for a BallSocket or Hinge constraint with anatomical limits
	(knees and elbows only bend one way), colliders switch on in a self-ignoring collision group, the server
	takes physics ownership and the punch's impulse throws the body.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local RigDef = require(Shared.RigDef)

local Ragdoll = {}

local function attach(part, cf, name)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = cf
	a.Parent = part
	return a
end

function Ragdoll.Enable(model, impulse: Vector3?, at: Vector3?)
	if model:GetAttribute("Ragdolled") then return end
	model:SetAttribute("Ragdolled", true)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = true
		hum.AutoRotate = false
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
	end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	local face = hrp and hrp:FindFirstChild("Facing")
	if face then face.Enabled = false end
	for _, def in RigDef.Bones do
		local part = model:FindFirstChild(def.name)
		local motor = part and part:FindFirstChild(def.motor)
		local lim = RigDef.Joints[def.motor]
		if motor and motor:IsA("Motor6D") and def.motor ~= "Root" and def.motor ~= "Jaw" then
			local a0 = attach(motor.Part0, motor.C0, "RD0_" .. def.motor)
			local a1 = attach(motor.Part1, motor.C1, "RD1_" .. def.motor)
			local con
			if lim and lim.kind == "hinge" then
				con = Instance.new("HingeConstraint")
				con.LimitsEnabled = true
				con.LowerAngle = lim.lo
				con.UpperAngle = lim.hi
				-- hinge axis is the attachment's X axis: the character's left-right axis
			else
				con = Instance.new("BallSocketConstraint")
				con.LimitsEnabled = true
				con.UpperAngle = lim and lim.cone or 45
				con.TwistLimitsEnabled = true
				con.TwistLowerAngle = -(lim and lim.twist or 30)
				con.TwistUpperAngle = lim and lim.twist or 30
				-- ball socket cone axis is X: point it down the bone
				a0.CFrame = motor.C0 * CFrame.Angles(0, 0, math.rad(-90))
				a1.CFrame = motor.C1 * CFrame.Angles(0, 0, math.rad(-90))
			end
			con.Name = "RD_" .. def.motor
			con.Attachment0 = a0
			con.Attachment1 = a1
			con.Parent = part
			motor.Enabled = false
		end
	end
	-- the root holds the hips still no longer: weld HRP to the pelvis loosely so the body drags it along
	local root = model:FindFirstChild("LowerTorso") and model.LowerTorso:FindFirstChild("Root")
	if root then root.Enabled = true end
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") and string.sub(d.Name, 1, 4) == "Col_" then
			d.CanCollide = true
			d.Massless = false
		end
	end
	if hrp then
		hrp.CanCollide = false
		hrp.Massless = true
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and not d.Anchored then
			pcall(function() d:SetNetworkOwner(nil) end)
		end
	end
	if impulse then
		local head = model:FindFirstChild("Col_Head") or model:FindFirstChild("Col_UpperTorso")
		local chest = model:FindFirstChild("Col_UpperTorso")
		task.defer(function()
			if head then pcall(function() head:ApplyImpulse(impulse) end) end
			if chest then pcall(function() chest:ApplyImpulse(impulse * 0.6) end) end
		end)
	end
end

return Ragdoll
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="764">
        <Properties>
          <string name="Name">Fighter</string>
          <string name="Source"><![CDATA[--[[
	Server-authoritative fighter. Owns vitals, the punch timeline, defence and damage. Everything the clients
	need to animate (current punch, guard, lean, state, injuries) is published as attributes on the model.
	Hit detection uses virtual head/body points computed from the HumanoidRootPart plus the fighter's lean,
	so it is deterministic and independent of client animation.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local PunchData = require(Shared.PunchData)
local Util = require(Shared.Util)

local Fighter = {}
Fighter.__index = Fighter

local INJ = { "EyeL", "EyeR", "CheekL", "CheekR", "Nose", "Mouth", "CutL", "CutR", "RibsL", "RibsR", "Liver" }

function Fighter.new(model, opts)
	local self = setmetatable({}, Fighter)
	self.model = model
	self.hrp = model:FindFirstChild("HumanoidRootPart")
	self.hum = model:FindFirstChildOfClass("Humanoid")
	self.player = opts.player
	self.isNPC = opts.player == nil
	self.name = opts.name or model.Name
	self.nick = opts.nick or ""
	self.stats = opts.stats
	self.southpaw = opts.southpaw == true
	self.style = opts.style or "OutBoxer"
	self.record = opts.record or "0-0"
	self.scale = model:GetAttribute("Scale") or 3.2
	self.corner = opts.corner or 0
	self.headHP, self.headCap, self.bodyHP = 100, 100, 100
	self.staminaMax = Util.lerp(92, 108, (self.stats.engine or 50) / 100)
	self.stamina = self.staminaMax
	self.recentHead, self.rocked, self.openT, self.counterWindow = 0, 0, 0, 0
	self.lastHit = -99
	self.kdRound, self.kdTotal = 0, 0
	self.state = "Intro"
	self.move = Vector2.zero
	self.lean = Vector3.zero
	self.leanCur = Vector3.zero
	self.guard = 0
	self.guardPressed = 99
	self.lastGuard = 0
	self.cur = nil
	self.queued = nil
	self.combo = 0
	self.lastPunchEnd = -9
	self.lastLead = false
	self.actId = 0
	self.inj = {}
	for _, k in INJ do self.inj[k] = 0 end
	self.round = Fighter.NewStats()
	self.total = Fighter.NewStats()
	self.syncT = 0
	self.liverT = -1
	if opts.injuries then
		for k, v in opts.injuries do
			if self.inj[k] ~= nil then self.inj[k] = v end
		end
		self.headCap = 100 - (opts.injuries.concussion or 0) * 35
		self.headHP = self.headCap
	end
	return self
end

function Fighter.NewStats()
	return { thrown = 0, landed = 0, jabsThrown = 0, jabsLanded = 0, powerThrown = 0, powerLanded = 0, bodyLanded = 0, headLanded = 0, blocked = 0, evaded = 0, knockdowns = 0, counters = 0, damage = 0, center = 0, pressure = 0 }
end

local function addStats(a, b)
	for k, v in b do a[k] = (a[k] or 0) + v end
end
Fighter.AddStats = addStats

-- ---------------------------------------------------------------- derived
function Fighter:Stat(n) return self.stats[n] or 50 end
function Fighter:PowerFactor() return 0.72 + self:Stat("power") / 100 * 0.65 end
function Fighter:SpeedFactor() return 1.16 - self:Stat("speed") / 100 * 0.32 end
function Fighter:StaminaFactor() return Util.lerp(0.5, 1, math.clamp(self.stamina / 45, 0, 1)) end
function Fighter:Fatigue() return math.clamp(1 - self.stamina / 60, 0, 1) * 0.7 + math.clamp(1 - self.staminaMax / 100, 0, 1) * 0.5 end
function Fighter:IsDown() return self.state == "Down" or self.state == "KO" end
function Fighter:CanAct() return self.state == "Fight" and self.openT <= 0 end

function Fighter:Chin()
	return (1.28 - self:Stat("chin") / 100 * 0.55) * (1 + (self.concussion or 0) * 0.8)
end

local function now() return workspace:GetServerTimeNow() end

function Fighter:Timing()
	local c = self.cur
	if not c then return 0, 0, 0 end
	return PunchData.Timing(c.def, c.power, c.body, c.scale, c.whiffed)
end

function Fighter:TimeToImpact()
	local c = self.cur
	if not c or c.impact then return 99 end
	local w, e = self:Timing()
	return math.max(0, w + e - (now() - c.t0))
end

function Fighter:WindingUp()
	local c = self.cur
	if not c then return false end
	local w = self:Timing()
	return now() - c.t0 < w
end

function Fighter:InRecovery() return self.cur ~= nil and self.cur.impact end

-- ---------------------------------------------------------------- geometry (virtual, server side)
function Fighter:LeanOffset()
	local l = self.leanCur
	local k = self.scale
	return Vector3.new(l.X * 0.18 * k, math.min(0, l.Y) * 0.26 * k, -l.Z * 0.15 * k)
end

function Fighter:HeadPoint()
	local cf = self.hrp.CFrame
	return cf:PointToWorldSpace(Vector3.new(0, 0.71 * self.scale, -0.04 * self.scale) + self:LeanOffset())
end

function Fighter:ChinPoint()
	return self:HeadPoint() + Vector3.new(0, -0.08 * self.scale, 0) - self.hrp.CFrame.LookVector * 0.06 * self.scale
end

function Fighter:BodyPoint(side)
	local off = self:LeanOffset() * 0.4
	return self.hrp.CFrame:PointToWorldSpace(Vector3.new(0.08 * side * self.scale, 0.36 * self.scale, -0.12 * self.scale) + off)
end

function Fighter:ShoulderPoint(lead)
	local leftHand = (lead and not self.southpaw) or (not lead and self.southpaw)
	local x = (leftHand and -1 or 1) * 0.17 * self.scale
	return self.hrp.CFrame:PointToWorldSpace(Vector3.new(x, 0.45 * self.scale, 0))
end

-- ---------------------------------------------------------------- commands
function Fighter:QueuePunch(id, body, power)
	local def = PunchData.Get(id)
	if not def or self.state ~= "Fight" then return end
	if not self.cur and self.openT <= 0 then
		self:StartPunch(def, body, power)
	else
		self.queued = { def = def, body = body, power = power, age = 0 }
	end
end

function Fighter:StartPunch(def, body, power)
	local t = now()
	local chained = t - self.lastPunchEnd < 0.32
	local alternate = self.combo > 0 and def.lead ~= self.lastLead
	self.combo = chained and self.combo + 1 or 1
	local scale = self:SpeedFactor() * (self.rocked > 0 and 1.25 or 1) * Util.lerp(1.3, 1, math.clamp(self.stamina / 35, 0, 1))
	if chained and alternate then scale *= 0.82 end
	self.cur = { def = def, body = body, power = power, t0 = t, scale = scale, impact = false, whiffed = false }
	local cost = def.stamina * (power and 1.6 or 1) * (body and 1.1 or 1)
	self.stamina = math.max(0, self.stamina - cost)
	self.staminaMax = math.max(45, self.staminaMax - cost * 0.035)
	self.round.thrown += 1
	if def.id == 1 then self.round.jabsThrown += 1 else self.round.powerThrown += 1 end
	self.lastLead = def.lead
	self.actId += 1
	local m = self.model
	m:SetAttribute("Act", def.id)
	m:SetAttribute("ActId", self.actId)
	m:SetAttribute("ActT0", t)
	m:SetAttribute("ActScale", scale)
	m:SetAttribute("ActBody", body)
	m:SetAttribute("ActPow", power)
end

function Fighter:OnPunchResult(res)
	if not self.cur then return end
	if res == "miss" or res == "slip" then
		self.cur.whiffed = true
		self.stamina = math.max(0, self.stamina - self.cur.def.stamina * 0.45)
		self.model:SetAttribute("ActWhiff", true)
	end
	if res == "parry" then self.openT = 0.42 end
	if res == "slip" then self.openT = math.max(self.openT, 0.18) end
end

-- ---------------------------------------------------------------- defence
function Fighter:Evaluate(attacker, def, body)
	local mult = 1
	local l = self.leanCur
	local slip, duck, back = math.abs(l.X), -math.min(0, l.Y), -math.min(0, l.Z)
	if not body then
		if def.kind == "straight" then
			if slip > 0.55 or duck > 0.6 or back > 0.78 then return "slip", 1 end
		elseif def.kind == "hook" then
			if duck > 0.55 or back > 0.85 then return "slip", 1 end
			if slip > 0.5 then mult *= 1.15 end
		else
			if back > 0.6 or slip > 0.72 then return "slip", 1 end
			if duck > 0.4 then mult *= 1.3 end
		end
		if l.Z > 0.3 then mult *= 1.12 end
	elseif back > 0.9 and def.kind == "straight" then
		return "slip", 1
	end
	local parryable = not body and def.kind ~= "upper"
	if parryable and self.guard == 1 and self.guardPressed < 0.16 and self.stamina > 6 then
		return "parry", 0
	end
	local blocking = (self.guard == 1 and not body) or (self.guard == 2 and body)
	if blocking then
		local frac = body and 0.22 or def.kind == "straight" and 0.12 or def.kind == "hook" and 0.28 or 0.6
		if self.stamina < 8 then frac = math.min(1, frac * 2.6) end
		return "block", mult * frac
	end
	if not body and self.guard == 0 and def.kind == "straight" and math.random() < 0.25 + self:Stat("defense") / 400 then
		return "block", mult * 0.55
	end
	if body and self.guard == 1 then mult *= 1.2 end
	if self:InRecovery() or self:WindingUp() then mult *= 1.15 end
	return "clean", mult
end

local function bump(self, key, amount)
	self.inj[key] = math.clamp((self.inj[key] or 0) + amount, 0, 1)
end

--[[ Apply a resolved hit. Returns true when it knocks the fighter down. side: +1 = landed on my right. ]]
function Fighter:TakeHit(attacker, def, body, power, damage, res, side, counter)
	self.lastHit = now()
	local pk = math.clamp(damage / 14, 0.15, 1.6)
	if res == "block" then
		self.stamina = math.max(0, self.stamina - def.stamina * 0.9 * (power and 1.4 or 1))
		if body then self.bodyHP -= damage * 0.5 else self.headHP -= damage * 0.5 end
		self.counterWindow = 0.3
		return false
	end
	local kd = false
	local sev = math.clamp(damage / 28, 0, 1) * (counter and 1.3 or 1) * (power and 1.2 or 1)
	if not body then
		local d = damage * self:Chin()
		self.headHP -= d
		self.headCap = math.max(30, self.headCap - d * 0.16)
		self.recentHead += d
		self.stamina = math.max(0, self.stamina - d * 0.25)
		self.concussion = math.clamp((self.concussion or 0) + sev * 0.12, 0, 1)
		local rockLine = Util.lerp(14, 24, self:Stat("chin") / 100) / self:Chin()
		if self.recentHead > rockLine or (self.headHP < 28 and d > 6) then
			self:Rock(Util.lerp(1.6, 3.6, math.clamp(self.recentHead / 50, 0, 1)))
		end
		-- injuries
		local s = side > 0 and "R" or "L"
		if def.kind == "hook" then
			local r = math.random()
			if r < 0.5 then bump(self, "Cheek" .. s, sev * 0.45) else bump(self, "Eye" .. s, sev * 0.32) end
			if math.random() < 0.1 * (0.3 + (self.inj["Eye" .. s] or 0)) then bump(self, "Cut" .. s, 0.18 + sev * 0.3) end
		elseif def.kind == "upper" then
			bump(self, "Mouth", sev * 0.5)
		else
			local r = math.random()
			if r < 0.4 then bump(self, "Nose", sev * 0.4) elseif r < 0.6 then bump(self, "Mouth", sev * 0.3) else bump(self, "Eye" .. s, sev * 0.3) end
			if math.random() < (0.04 + (power and 0.05 or 0)) * (0.3 + self.inj.Nose) then bump(self, "Cut" .. s, 0.15 + sev * 0.25) end
		end
		if self.headHP <= 0 then kd = true
		elseif self.rocked > 0 and (counter or power) and d > 6 and self.headHP < 50 and math.random() < 0.3 then kd = true
		elseif counter and power and d > 9 and self.headHP < 40 and math.random() < 0.2 then kd = true end
	else
		local d = damage * (1 + (self.bodyTrauma or 0) * 0.6)
		self.bodyHP -= d
		self.stamina = math.max(0, self.stamina - d * 1.15)
		self.staminaMax = math.max(40, self.staminaMax - d * 0.22)
		self.bodyTrauma = math.clamp((self.bodyTrauma or 0) + sev * 0.12, 0, 1)
		local liver = side > 0 and def.kind == "hook"
		bump(self, liver and "Liver" or side > 0 and "RibsR" or "RibsL", sev * 0.5)
		if liver and self.bodyHP < 45 and d > 8 and math.random() < 0.55 then self.liverT = 0.55 end
		if self.bodyHP <= 0 then self.liverT = 0.3; self.bodyHP = 8 end
	end
	self:SyncInjuries()
	return kd
end

function Fighter:Rock(t)
	self.rocked = math.max(self.rocked, t)
	if self.cur and not self.cur.impact then self:CancelPunch() end
end

function Fighter:CancelPunch()
	self.cur = nil
	self.model:SetAttribute("Act", 0)
end

function Fighter:SyncInjuries()
	local m = self.model
	for k, v in self.inj do m:SetAttribute("I_" .. k, math.floor(v * 100 + 0.5) / 100) end
	local bleed = math.max(self.inj.CutL, self.inj.CutR) + math.max(0, self.inj.Nose - 0.45)
	m:SetAttribute("I_Bleed", math.floor(bleed * 100) / 100)
end

function Fighter:InjuryRecord()
	local r = { concussion = self.concussion or 0, bodyTrauma = self.bodyTrauma or 0 }
	for k, v in self.inj do r[k] = v end
	return r
end

function Fighter:Treat(cutWork, iceWork)
	self.inj.CutL = math.max(0, self.inj.CutL - cutWork)
	self.inj.CutR = math.max(0, self.inj.CutR - cutWork)
	for _, k in { "EyeL", "EyeR", "CheekL", "CheekR", "Nose", "Mouth" } do
		self.inj[k] = math.max(0, self.inj[k] - iceWork)
	end
	self:SyncInjuries()
end

function Fighter:EyeClosure(left)
	return math.clamp(((self.inj[left and "EyeL" or "EyeR"] or 0) - 0.35) * 1.4, 0, 1)
end

function Fighter:MaxCut() return math.max(self.inj.CutL, self.inj.CutR) end

-- ---------------------------------------------------------------- state changes
function Fighter:SetState(s)
	self.state = s
	self.model:SetAttribute("State", s)
	if s ~= "Fight" then self.move = Vector2.zero end
end

function Fighter:KnockDown(dir, ko)
	self.cur = nil
	self.queued = nil
	self.kdRound += 1
	self.kdTotal += 1
	self:SetState(ko and "KO" or "Down")
	self.model:SetAttribute("DownT0", now())
	self.model:SetAttribute("DownDir", dir)
	self.model:SetAttribute("Act", 0)
end

function Fighter:GetUp()
	if self.state ~= "Down" then return end
	self:SetState("GetUp")
	self.model:SetAttribute("GetUpT0", now())
	local heart = self:Stat("heart") / 100
	self.headHP = math.max(self.headHP, Util.lerp(28, 55, heart) * Util.lerp(1, 0.6, math.clamp((self.kdTotal - 1) / 3, 0, 1)))
	self.recentHead = 0
	self.stamina = math.max(self.stamina, self.staminaMax * 0.5)
	self.rocked = 0
end

function Fighter:Recover(k)
	self.staminaMax = math.min(108, self.staminaMax + 4 * k)
	self.stamina = self.staminaMax
	self.headHP = math.min(self.headCap, self.headHP + Util.lerp(10, 20, self:Stat("heart") / 100) * k)
	self.bodyHP = math.min(100, self.bodyHP + 10 * k)
	self.recentHead = 0
	self.rocked = 0
end

-- ---------------------------------------------------------------- tick
function Fighter:Tick(dt, onImpact, onLiver)
	self.guardPressed += dt
	if self.guard == 1 and self.lastGuard ~= 1 then self.guardPressed = 0 end
	self.lastGuard = self.guard
	self.openT -= dt
	self.counterWindow -= dt
	self.recentHead = Util.moveTowards(self.recentHead, 0, dt * 7)
	if self.rocked > 0 then self.rocked -= dt end
	if self.liverT > 0 then
		self.liverT -= dt
		if self.liverT <= 0 and self.state == "Fight" and onLiver then onLiver(self) end
	end
	if self.state == "Down" or self.state == "KO" then
		self:Sync(dt)
		return
	end
	-- punch timeline
	local c = self.cur
	if c then
		local w, e, r = self:Timing()
		local t = now() - c.t0
		if not c.impact and t >= w + e then
			c.impact = true
			if onImpact then onImpact(self, c.def, c.body, c.power) end
		end
		if self.cur == c and t >= w + e + r then
			self.cur = nil
			self.lastPunchEnd = now()
			self.model:SetAttribute("Act", 0)
			self.model:SetAttribute("ActWhiff", false)
		end
	end
	local q = self.queued
	if q then
		q.age += dt
		if q.age > 0.4 then
			self.queued = nil
		elseif not self.cur and self:CanAct() then
			self.queued = nil
			self:StartPunch(q.def, q.body, q.power)
		end
	end
	-- recovery
	local active = self.state == "Fight" or self.state == "Clinch"
	if active and not self.cur then
		local regen = (9 + self:Stat("engine") / 100 * 8) * (1 - (self.bodyTrauma or 0) * 0.4) * (self.guard == 1 and 0.6 or 1) * (self.state == "Clinch" and 1.6 or 1)
		if self.move.Magnitude > 0.1 then regen *= 0.8 end
		self.stamina = math.min(self.staminaMax, self.stamina + regen * dt)
	end
	if now() - self.lastHit > 3 then self.headHP = math.min(self.headCap, self.headHP + dt * 0.9) end
	self.bodyHP = math.min(100, self.bodyHP + dt * 0.15)
	-- lean follows the command with lag: timing matters
	local leanSpeed = Util.lerp(5, 9, self:Stat("defense") / 100) * (self.rocked > 0 and 0.5 or 1) * Util.lerp(0.7, 1, self.stamina / 100)
	local cmd = self.state == "Fight" and self.lean or Vector3.zero
	if self.cur then cmd *= 0.35 end
	self.leanCur = Util.moveTowardsV(self.leanCur, cmd, dt * leanSpeed)
	if math.abs(self.leanCur.X) > 0.3 or self.leanCur.Y < -0.3 then self.stamina = math.max(0, self.stamina - dt * 3) end
	-- movement speed reflects condition
	if self.hum then
		local foot = 0.85 + self:Stat("footwork") / 100 * 0.35
		local spd = 10 * foot * Util.lerp(0.65, 1, math.clamp(self.stamina / 40, 0, 1)) * (self.rocked > 0 and 0.45 or 1) * (self.cur and 0.45 or 1) * (self.guard == 1 and 0.75 or 1)
		if self.state ~= "Fight" then spd = (self.state == "Corner" or self.state == "Walk") and 8 or 0 end
		self.hum.WalkSpeed = spd
	end
	self:Sync(dt)
end

function Fighter:Sync(dt)
	self.syncT -= dt
	if self.syncT > 0 then return end
	self.syncT = 0.05
	local m = self.model
	m:SetAttribute("HeadHP", math.floor(self.headHP * 10) / 10)
	m:SetAttribute("HeadCap", math.floor(self.headCap))
	m:SetAttribute("BodyHP", math.floor(self.bodyHP * 10) / 10)
	m:SetAttribute("Stam", math.floor(self.stamina * 10) / 10)
	m:SetAttribute("StamMax", math.floor(self.staminaMax * 10) / 10)
	m:SetAttribute("Rocked", math.max(0, math.floor(self.rocked * 10) / 10))
	m:SetAttribute("Guard", self.guard)
	m:SetAttribute("LeanX", math.floor(self.leanCur.X * 100) / 100)
	m:SetAttribute("LeanY", math.floor(self.leanCur.Y * 100) / 100)
	m:SetAttribute("LeanZ", math.floor(self.leanCur.Z * 100) / 100)
	m:SetAttribute("Fatigue", math.floor(self:Fatigue() * 100) / 100)
end

return Fighter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="765">
        <Properties>
          <string name="Name">AI</string>
          <string name="Source"><![CDATA[--[[
	CPU boxer brain. Reads the player's punches with a human reaction delay and defends by style (slip, duck,
	shell, parry), throws style-specific combinations, counters after making you miss, cuts off the ring,
	escapes the ropes, clinches when hurt and goes for the finish when you're rocked.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local PunchData = require(Shared.PunchData)
local Util = require(Shared.Util)

local AI = {}
AI.__index = AI

local LIB = {
	OutBoxer = { "1", "1", "1 1", "1 2", "1 1 2", "1 2 3", "b1 1", "1 2 b3", "2 3 2" },
	Swarmer = { "b3 3", "1 2 b3", "3 2 3", "b4 b3 3", "5 2 3", "1 2 5 2", "b2 3", "3 b3 4" },
	Slugger = { "p2", "p4", "1 p2", "3 p2", "p6", "1 1 p2", "pb4" },
	Counter = { "1", "1 2", "b1", "1 b2" },
	Brawler = { "3 4 3", "p4 p3", "5 6 3 4", "1 2 3 4", "pb3 p3", "2 3 2 p3" },
}
local RANGE = { OutBoxer = 1.18, Swarmer = 0.72, Slugger = 0.9, Counter = 1.05, Brawler = 0.82 }

local function parse(s)
	local out = {}
	for tok in string.gmatch(s, "%S+") do
		local id = tonumber(string.sub(tok, -1)) or 1
		table.insert(out, { id = id, body = string.find(tok, "b") ~= nil, power = string.find(tok, "p") ~= nil })
	end
	return out
end

function AI.new(me, opp, difficulty)
	local self = setmetatable({}, AI)
	self.me, self.opp = me, opp
	self.style = me.style
	local overall = 0
	for _, v in me.stats do overall += v end
	overall /= 7
	self.skill = math.clamp((difficulty or 0.6) * 0.7 + overall / 100 * 0.4, 0, 1)
	self.combos = {}
	for _, s in LIB[self.style] or LIB.OutBoxer do table.insert(self.combos, parse(s)) end
	self.range = RANGE[self.style] or 1
	self.plan = {}
	self.comboCd, self.gap, self.defendHold, self.clinchCd, self.tauntCd, self.strafeT = 1.2, 0, 0, 3, 8, 0
	self.strafe = 1
	self.seen = nil
	return self
end

function AI:Def() return (self.me.stats.defense or 50) / 100 end

function AI:ChooseDefence(def, body)
	self.defendHold = 0.38
	self.defLean, self.defGuard = Vector3.zero, 0
	local r = math.random()
	if body then
		self.defGuard = 2
		if r < 0.25 then self.defLean = Vector3.new(0, 0, -1) end
		return
	end
	if def.kind == "straight" then
		if (self.style == "Counter" and r < 0.65) or r < 0.35 then
			self.defLean = Vector3.new(math.random() < 0.5 and -1 or 1, -0.1, 0)
		elseif r < 0.55 and self.skill > 0.6 then
			self.defGuard = 1
			self.defendHold = 0.2
		elseif r < 0.75 then
			self.defLean = Vector3.new(0, -1, 0)
		else
			self.defGuard = 1
		end
	elseif def.kind == "hook" then
		if r < 0.5 then self.defLean = Vector3.new(0, -1, 0) else self.defGuard = 1 end
	else
		if r < 0.55 then self.defLean = Vector3.new(0, 0, -1) else self.defGuard = 1 end
	end
end

--[[ Returns the move direction (world, flat) the server should feed into Humanoid:Move. ]]
function AI:Tick(dt, ring, tryClinch, taunt)
	local me, opp = self.me, self.opp
	if me.state == "Intro" then return Vector3.zero end
	if me.state ~= "Fight" then
		me.lean, me.guard = Vector3.zero, 0
		self.plan = {}
		return Vector3.zero
	end
	self.comboCd -= dt; self.gap -= dt; self.defendHold -= dt; self.clinchCd -= dt; self.tauntCd -= dt; self.strafeT -= dt
	local toOpp = Util.flat(opp.hrp.Position - me.hrp.Position)
	local dist = toOpp.Magnitude / me.scale
	local tired = 1 - math.clamp(me.stamina / 60, 0, 1)

	-- defence
	if opp.cur and opp.cur ~= self.seen then
		self.seen = opp.cur
		self.seenAt = os.clock()
		self.reacted = false
	end
	if not opp.cur then self.seen = nil end
	local reaction = Util.lerp(0.34, 0.1, self.skill * (0.5 + self:Def() * 0.5)) * (me.rocked > 0 and 1.8 or 1) * (1 + tired * 0.5)
	if self.seen and not self.reacted and os.clock() - self.seenAt >= reaction and opp:TimeToImpact() > 0.015 then
		self.reacted = true
		local chance = self:Def() * (0.5 + self.skill * 0.55) * (1 - tired * 0.4) * (me.rocked > 0 and 0.5 or 1)
		if self.style == "Counter" then chance += 0.15 end
		if self.style == "Slugger" or self.style == "Brawler" then chance -= 0.1 end
		if math.random() < chance and not me.cur then self:ChooseDefence(opp.cur.def, opp.cur.body) end
	end
	if self.defendHold > 0 then
		me.lean, me.guard = self.defLean, self.defGuard
	else
		local sway = (self.style == "Counter" or self.style == "Swarmer") and math.sin(os.clock() * 2.1) * 0.35 or 0
		me.lean = Vector3.new(sway, 0, 0)
		me.guard = ((self.style == "Swarmer" and dist < 1.4 and not me.cur and #self.plan == 0) or (me.rocked > 0 and math.random() < 0.6)) and 1 or 0
	end

	-- hurt: hold on
	if me.rocked > 0 and dist < 0.9 and self.clinchCd <= 0 and math.random() < 0.02 + (1 - me.headHP / 100) * 0.05 then
		self.clinchCd = 6
		tryClinch(me)
	end

	-- offence
	local oppHurt = opp.rocked > 0 or opp.stamina < 20
	local aggression = (self.style == "Swarmer" or self.style == "Brawler") and 1.2 or self.style == "Counter" and 0.55 or 0.9
	if oppHurt then aggression *= 1.8 end
	if me.rocked > 0 then aggression *= 0.3 end
	local reach = 0.92 + (self.style == "OutBoxer" and 0.12 or 0)
	local inRange = dist < reach
	if me.counterWindow > 0 and inRange and #self.plan == 0 and not me.cur and math.random() < 0.6 + self.skill * 0.3 then
		local c = self.style == "Counter" and (math.random() < 0.5 and "p2 3" or "3 p2") or (math.random() < 0.5 and "2" or "3 2")
		self.plan = parse(c)
		self.gap = 0
	end
	if #self.plan == 0 and self.comboCd <= 0 and inRange and me.stamina > 18 and math.random() < aggression * dt * 2.6 then
		local combo = self.combos[math.random(1, #self.combos)]
		local forceBody = opp.guard == 1 and math.random() < 0.6
		local forceHead = opp.guard == 2
		for _, p in combo do
			table.insert(self.plan, { id = p.id, body = (not forceHead) and (p.body or (forceBody and p.id ~= 1)), power = p.power or (oppHurt and math.random() < 0.4) })
		end
		self.comboCd = Util.lerp(1.6, 0.55, self.skill) / math.max(0.3, aggression) + tired * 1.2
	end
	if #self.plan > 0 and self.gap <= 0 and not me.cur and me:CanAct() then
		local n = table.remove(self.plan, 1)
		if dist < PunchData.Get(n.id).reach * 1.25 + 0.15 then
			me:QueuePunch(n.id, n.body, n.power and me.stamina > 30)
			self.gap = 0.02 + math.random() * 0.1
		else
			self.plan = {}
		end
	end

	-- footwork
	if self.strafeT <= 0 then
		self.strafeT = 1.2 + math.random() * 1.8
		self.strafe = math.random() < 0.5 and -1 or 1
	end
	local want = self.range * (oppHurt and 0.8 or 1) * (me.rocked > 0 and 1.5 or 1)
	if #self.plan > 0 then want = math.min(want, 0.85) end
	local fwd = math.clamp((dist - want) * 2.2, -1, 1)
	local lat = self.strafe * (self.style == "OutBoxer" and 0.85 or self.style == "Slugger" and 0.25 or 0.5)
	local f = dist > 0.01 and toOpp.Unit or me.hrp.CFrame.LookVector
	local right = f:Cross(Vector3.yAxis)
	if ring and ring.onRopes and ring.onRopes(me) then
		local toCenter = Util.flatUnit(ring.center - me.hrp.Position)
		lat = toCenter:Dot(right) > 0 and 1 or -1
		fwd = math.max(fwd, 0.2)
	end
	if ring and ring.onRopes and ring.onRopes(opp) and (self.style == "Swarmer" or self.style == "Brawler" or oppHurt) then
		lat *= 0.2
		fwd = math.max(fwd, 0.6)
	end
	me.move = Vector2.new(lat, fwd)

	-- showboat
	if self.tauntCd <= 0 and me.headHP > opp.headHP + 35 and not me.cur and math.random() < 0.004 then
		self.tauntCd = 14
		taunt(me)
	end
	local dir = right * lat + f * fwd
	if dir.Magnitude > 1 then dir = dir.Unit end
	return dir
end

return AI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="766">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">45</float>
      <float name="CameraMinZoomDistance">6</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="767">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="768">
        <Properties>
          <string name="Name">NeonBay</string>
        </Properties>
        <Item class="ModuleScript" referent="769">
          <Properties>
            <string name="Name">Crowd</string>
            <string name="Source"><![CDATA[--[[
	Client-side crowd around each ring: low-detail spectators that bounce, raise fists, clap and jump up on
	big shots and knockdowns. Purely local, moved with BulkMoveTo.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)

local Crowd = {}
local crowds = {}

local function ell(parent, size, color, mat)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.CastShadow = false
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = parent
	return p
end

local function build(ring)
	local canvas = ring:FindFirstChild("Canvas")
	if not canvas then return end
	local center = canvas.Position
	local floorY = canvas.Position.Y - canvas.Size.Y / 2
	local folder = Instance.new("Folder")
	folder.Name = "Crowd"
	folder.Parent = workspace
	local rng = Random.new(ring:GetAttribute("RingOrder") or 1)
	local fans = {}
	local parts, cfs = {}, {}
	local count = ring:GetAttribute("CrowdSize") or 28
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace:FindFirstChild("Map") }
	local tries = 0
	while #fans < count and tries < count * 6 do
		tries += 1
		local ang = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(Config.Ring.ropeHalf + 6, Config.Ring.ropeHalf + 15)
		local p = center + Vector3.new(math.cos(ang) * dist, 6, math.sin(ang) * dist)
		local hit = workspace:Raycast(p, Vector3.new(0, -14, 0), params)
		if hit and hit.Position.Y < floorY + 4 and hit.Instance.Name ~= "Canvas" then
			local ok = true
			for _, f in fans do if (f.base - hit.Position).Magnitude < 2.6 then ok = false break end end
			if ok then
				local skin = Config.SkinTones[rng:NextInteger(1, 7)]
				local shirt = Color3.fromHSV(rng:NextNumber(), rng:NextNumber(0.2, 0.8), rng:NextNumber(0.15, 0.8))
				local f = {
					base = hit.Position, yaw = math.atan2(-(center.X - hit.Position.X), -(center.Z - hit.Position.Z)),
					phase = rng:NextNumber(0, 10), mood = rng:NextInteger(1, 3), excite = 0, jump = 0, scale = rng:NextNumber(0.9, 1.1),
					legs = ell(folder, Vector3.new(1.1, 2.9, 0.75), Color3.fromRGB(25, 25, 32), Enum.Material.Fabric),
					body = ell(folder, Vector3.new(1.45, 2.2, 0.95), shirt, Enum.Material.Fabric),
					head = ell(folder, Vector3.new(0.75, 0.9, 0.82), skin),
					hair = ell(folder, Vector3.new(0.8, 0.5, 0.86), Config.HairColors[rng:NextInteger(1, 6)], Enum.Material.Fabric),
					armL = ell(folder, Vector3.new(0.38, 1.7, 0.38), shirt, Enum.Material.Fabric),
					armR = ell(folder, Vector3.new(0.38, 1.7, 0.38), shirt, Enum.Material.Fabric),
				}
				if rng:NextNumber() < 0.25 then
					f.glow = ell(folder, Vector3.new(0.3, 0.3, 0.3), Config.Neon.Magenta:Lerp(Config.Neon.Cyan, rng:NextNumber()), Enum.Material.Neon)
				end
				for _, k in { "legs", "body", "head", "hair", "armL", "armR", "glow" } do
					if f[k] then table.insert(parts, f[k]) end
				end
				table.insert(fans, f)
			end
		end
	end
	crowds[ring] = { fans = fans, parts = parts, cfs = cfs, center = center, hype = 0.15 }
end

function Crowd.Excite(ring, amount)
	local c = ring and crowds[ring]
	if not c then return end
	c.hype = math.clamp(c.hype + amount * 0.5, 0, 1)
	for _, f in c.fans do
		f.excite = math.max(f.excite, amount * (0.6 + math.random() * 0.6))
		if amount > 0.5 and math.random() < 0.6 then f.jump = 0.4 + math.random() * 0.5 end
	end
end

function Crowd.Start()
	local map = workspace:WaitForChild("Map", 30)
	if not map then return end
	task.wait(1)
	for _, d in map:GetDescendants() do
		if d:IsA("Model") and d:GetAttribute("IsRing") then build(d) end
	end
	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		local t = os.clock()
		for ring, c in crowds do
			if (cam.CFrame.Position - c.center).Magnitude < 180 then
				local busy = ring:GetAttribute("Busy")
				c.hype = math.max(busy and 0.3 or 0.08, c.hype - dt * 0.05)
				local i = 0
				for _, f in c.fans do
					f.excite = math.max(c.hype * 0.5, f.excite - dt * 0.4)
					f.jump = math.max(0, f.jump - dt * 0.5)
					local ex = f.excite
					local bounce = math.abs(math.sin(t * 7 + f.phase)) * 0.5 * f.jump + math.abs(math.sin(t * 3 + f.phase)) * 0.12 * ex
					local root = CFrame.new(f.base) * CFrame.Angles(0, f.yaw, 0) * CFrame.new(0, bounce, 0)
					local s = f.scale
					local arms = math.clamp((ex - 0.3) * 2 + f.jump, 0, 1)
					local pump = math.sin(t * 8 + f.phase) * 0.35
					local raiseL, raiseR
					if f.mood == 1 then raiseL, raiseR = arms * (2.6 + pump), arms * (2.6 - pump)
					elseif f.mood == 2 then raiseL, raiseR = 0.15, arms * (2.4 + pump * 1.5)
					else
						local clap = math.abs(math.sin(t * 9 + f.phase))
						raiseL, raiseR = arms * (1.2 + clap * 0.2), arms * (1.2 + clap * 0.2)
					end
					local function put(part, cf)
						i += 1
						c.cfs[i] = cf
						local _ = part
					end
					put(f.legs, root * CFrame.new(0, 1.45 * s, 0))
					put(f.body, root * CFrame.new(0, 3.6 * s, 0) * CFrame.Angles(-0.1 * ex, 0, 0))
					put(f.head, root * CFrame.new(0, 5.05 * s, -0.05) * CFrame.Angles(0.15 * ex, math.sin(t * 0.7 + f.phase) * 0.3, 0))
					put(f.hair, root * CFrame.new(0, 5.3 * s, 0.05))
					put(f.armL, root * CFrame.new(-0.85 * s, 4.3 * s, 0) * CFrame.Angles(raiseL, 0, -0.15) * CFrame.new(0, -0.75, 0))
					put(f.armR, root * CFrame.new(0.85 * s, 4.3 * s, 0) * CFrame.Angles(raiseR, 0, 0.15) * CFrame.new(0, -0.75, 0))
					if f.glow then put(f.glow, root * CFrame.new(0.85 * s, 4.3 * s, 0) * CFrame.Angles(raiseR, 0, 0.15) * CFrame.new(0, -1.6, 0)) end
				end
				workspace:BulkMoveTo(c.parts, c.cfs, Enum.BulkMoveMode.FireCFrameChanged)
			end
		end
	end)
end

return Crowd
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="770">
          <Properties>
            <string name="Name">Ropes</string>
            <string name="Source"><![CDATA[--[[
	Ring ropes simulated with verlet integration on each client. Four ropes per side; fighters, the referee,
	lobby players and knocked-out bodies push them, they stretch, wobble and settle. Rendered as chains of
	cylinder parts moved with BulkMoveTo (only while the camera is near).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local Animator = require(script.Parent.Animator)

local Ropes = {}
local POINTS = 14
local rings = {}

local COLORS = {
	{ Config.Neon.Cyan, Enum.Material.Neon },
	{ Color3.fromRGB(235, 235, 240), Enum.Material.SmoothPlastic },
	{ Color3.fromRGB(235, 235, 240), Enum.Material.SmoothPlastic },
	{ Config.Neon.Red, Enum.Material.Neon },
}

local function build(ring)
	local canvas = ring:FindFirstChild("Canvas")
	if not canvas then return end
	local center = canvas.Position + Vector3.new(0, canvas.Size.Y / 2, 0)
	local half = ring:GetAttribute("RopeHalf") or Config.Ring.ropeHalf
	local folder = Instance.new("Folder")
	folder.Name = "SimRopes"
	folder.Parent = workspace
	local corners = { Vector3.new(-half, 0, -half), Vector3.new(half, 0, -half), Vector3.new(half, 0, half), Vector3.new(-half, 0, half) }
	local outs = { Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(-1, 0, 0) }
	local data = { ring = ring, center = center, half = half, ropes = {}, parts = {}, cfs = {} }
	for s = 1, 4 do
		for lv, h in Config.Ring.ropeHeights do
			local rope = { outward = outs[s], p = {}, prev = {}, rest = {}, segs = {} }
			local a = center + corners[s] + Vector3.new(0, h, 0)
			local b = center + corners[s % 4 + 1] + Vector3.new(0, h, 0)
			for i = 1, POINTS do
				local t = (i - 1) / (POINTS - 1)
				local pt = a:Lerp(b, t) - Vector3.new(0, math.sin(t * math.pi) * 0.08, 0)
				rope.p[i], rope.prev[i], rope.rest[i] = pt, pt, pt
			end
			rope.segLen = (b - a).Magnitude / (POINTS - 1)
			for i = 1, POINTS - 1 do
				local part = Instance.new("Part")
				part.Name = "Rope"
				part.Shape = Enum.PartType.Cylinder
				part.Anchored = true
				part.CanCollide, part.CanQuery, part.CanTouch = false, false, false
				part.Size = Vector3.new(rope.segLen + 0.06, lv == 4 and 0.24 or 0.2, lv == 4 and 0.24 or 0.2)
				part.Color = COLORS[lv][1]
				part.Material = COLORS[lv][2]
				part.Parent = folder
				table.insert(rope.segs, part)
				table.insert(data.parts, part)
			end
			table.insert(data.ropes, rope)
		end
	end
	data.folder = folder
	rings[ring] = data
end

local function pushers(data)
	local list = {}
	local c, half = data.center, data.half + 3
	for model, _ in Animator.Rigs do
		local hrp = model:FindFirstChild("HumanoidRootPart")
		if hrp and model.Name ~= "CreatorPreview" then
			local l = hrp.Position - c
			if math.abs(l.X) < half and math.abs(l.Z) < half then
				if model:GetAttribute("Ragdolled") then
					for _, n in { "UpperTorso", "LowerTorso", "Head" } do
						local p = model:FindFirstChild(n)
						if p then table.insert(list, { pos = p.Position, r = n == "Head" and 0.5 or 0.8, y0 = p.Position.Y - 1.2, y1 = p.Position.Y + 1.2 }) end
					end
				else
					local ut = model:FindFirstChild("UpperTorso")
					local center = ut and ut.Position or hrp.Position
					table.insert(list, { pos = center, r = 0.95, y0 = hrp.Position.Y - 3, y1 = hrp.Position.Y + 2.6 })
				end
			end
		end
	end
	return list
end

local function simulate(data, dt)
	local ps = pushers(data)
	for _, rope in data.ropes do
		local p, prev, rest = rope.p, rope.prev, rope.rest
		local g = Vector3.new(0, -9.8 * dt * dt * 0.6, 0)
		for i = 2, POINTS - 1 do
			local v = (p[i] - prev[i]) * 0.965
			prev[i] = p[i]
			p[i] = p[i] + v + g + (rest[i] - p[i]) * 0.06
		end
		for _ = 1, 3 do
			for i = 1, POINTS - 1 do
				local d = p[i + 1] - p[i]
				local len = d.Magnitude
				if len > 1e-4 then
					local corr = d * ((len - rope.segLen) / len) * 0.5
					if i > 1 then p[i] += corr end
					if i + 1 < POINTS then p[i + 1] -= corr end
				end
			end
			for _, pu in ps do
				for i = 2, POINTS - 1 do
					local pt = p[i]
					if pt.Y > pu.y0 and pt.Y < pu.y1 then
						local dx = Vector3.new(pt.X - pu.pos.X, 0, pt.Z - pu.pos.Z)
						local dist = dx.Magnitude
						if dist < pu.r and dist > 1e-3 then
							local dir = dx / dist
							if dir:Dot(rope.outward) < 0 then dir = rope.outward end
							local np = Vector3.new(pu.pos.X, pt.Y, pu.pos.Z) + dir * pu.r
							local moved = (np - pt).Magnitude
							p[i] = np - Vector3.new(0, moved * 0.25, 0)
						end
					end
				end
			end
		end
	end
end

local function render(data)
	local i = 0
	for _, rope in data.ropes do
		for s, _ in rope.segs do
			local a, b = rope.p[s], rope.p[s + 1]
			i += 1
			local mid = (a + b) / 2
			local dir = b - a
			if dir.Magnitude < 1e-4 then dir = Vector3.xAxis end
			-- cylinder axis is X
			data.cfs[i] = CFrame.lookAt(mid, mid + dir) * CFrame.Angles(0, math.rad(90), 0)
		end
	end
	workspace:BulkMoveTo(data.parts, data.cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

function Ropes.Start()
	local map = workspace:WaitForChild("Map", 30)
	if not map then return end
	for _, d in map:GetDescendants() do
		if d:IsA("Model") and d:GetAttribute("IsRing") then build(d) end
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		local cam = workspace.CurrentCamera
		for _, data in rings do
			local near = (cam.CFrame.Position - data.center).Magnitude < 160
			if near then
				-- fixed 60 Hz steps for stable verlet
				local steps = 0
				local t = acc
				while t >= 1 / 60 and steps < 3 do
					simulate(data, 1 / 60)
					t -= 1 / 60
					steps += 1
				end
				render(data)
			end
		end
		while acc >= 1 / 60 do acc -= 1 / 60 end
	end)
end

local _ = Players
return Ropes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="771">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[ Fight HUD: tale of the tape, health/body/stamina bars, clock, popups, count, corner, results. ]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local HUD = {}
local player = Players.LocalPlayer
local gui
local refs = {}
local popups = {}
local Controls -- set in Start

local FONT = Enum.Font.GothamBlack
local FONT2 = Enum.Font.GothamBold
local TITLE = Enum.Font.Michroma
local RED = Color3.fromRGB(242, 51, 64)
local BLUE = Color3.fromRGB(64, 128, 255)
local YELLOW = Config.Neon.Yellow
local CYAN = Config.Neon.Cyan

-- ------------------------------------------------------------------ tiny UI kit
local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in props do o[k] = v end
	o.Parent = parent
	return o
end

local function frame(parent, pos, size, color, alpha, z)
	return make("Frame", { Position = pos, Size = size, BackgroundColor3 = color or Color3.new(0, 0, 0), BackgroundTransparency = alpha or 0, BorderSizePixel = 0, ZIndex = z or 1 }, parent)
end

local function label(parent, text, pos, size, color, font, align, z)
	return make("TextLabel", {
		Text = text, Position = pos, Size = size, TextColor3 = color or Color3.new(1, 1, 1), Font = font or FONT2, TextScaled = true,
		BackgroundTransparency = 1, TextXAlignment = align or Enum.TextXAlignment.Center, ZIndex = z or 2, RichText = true,
	}, parent)
end

local function stroke(o, color, th)
	return make("UIStroke", { Color = color, Thickness = th or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end

local function corner(o, r) return make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end

local function button(parent, text, pos, size, color, cb)
	local b = make("TextButton", {
		Text = text, Position = pos, Size = size, BackgroundColor3 = Color3.fromRGB(14, 16, 26), TextColor3 = Color3.new(1, 1, 1),
		Font = FONT, TextScaled = true, AutoButtonColor = true, BorderSizePixel = 0, ZIndex = 5,
	}, parent)
	corner(b, 6)
	stroke(b, color or CYAN, 1.5)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, b)
	b.MouseButton1Click:Connect(cb)
	return b
end
HUD.Make, HUD.Frame, HUD.Label, HUD.Button, HUD.Stroke, HUD.Corner = make, frame, label, button, stroke, corner

-- ------------------------------------------------------------------ bars
local function bar(parent, pos, size, color, mirror)
	local back = frame(parent, pos, size, Color3.new(0, 0, 0), 0.35, 2)
	local lost = frame(back, UDim2.new(mirror and 0 or 1, 0, 0, 0), UDim2.new(0, 0, 1, 0), Color3.fromRGB(70, 12, 14), 0.1, 3)
	lost.AnchorPoint = Vector2.new(mirror and 0 or 1, 0)
	local lag = frame(back, UDim2.new(mirror and 1 or 0, 0, 0, 0), UDim2.new(1, 0, 1, 0), Color3.new(1, 1, 1), 0.2, 3)
	lag.AnchorPoint = Vector2.new(mirror and 1 or 0, 0)
	local fill = frame(back, UDim2.new(mirror and 1 or 0, 0, 0, 0), UDim2.new(1, 0, 1, 0), color, 0, 4)
	fill.AnchorPoint = Vector2.new(mirror and 1 or 0, 0)
	make("UIGradient", { Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.25), color), Rotation = 90 }, fill)
	return { back = back, fill = fill, lag = lag, lost = lost, lagV = 1 }
end

local function setBar(b, frac, cap, dt)
	frac = math.clamp(frac, 0, 1)
	cap = math.clamp(cap or 1, 0, 1)
	b.fill.Size = UDim2.new(frac, 0, 1, 0)
	if b.lagV < frac then b.lagV = frac else b.lagV = Util.moveTowards(b.lagV, frac, dt * 0.18) end
	b.lag.Size = UDim2.new(b.lagV, 0, 1, 0)
	b.lost.Size = UDim2.new(1 - cap, 0, 1, 0)
end

local function fighterPanel(parent, mirror)
	local p = frame(parent, UDim2.new(mirror and 1 or 0, mirror and -24 or 24, 0, 18), UDim2.new(0.36, 0, 0, 108), Color3.fromRGB(4, 4, 10), 0.35, 1)
	p.AnchorPoint = Vector2.new(mirror and 1 or 0, 0)
	corner(p, 8)
	local accent = frame(p, UDim2.new(mirror and 1 or 0, mirror and -5 or 0, 0, 0), UDim2.new(0, 5, 1, 0), mirror and BLUE or RED, 0, 2)
	local al = mirror and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
	local name = label(p, "", UDim2.new(0, 14, 0, 6), UDim2.new(1, -28, 0, 28), Color3.new(1, 1, 1), FONT, al)
	local sub = label(p, "", UDim2.new(0, 14, 0, 34), UDim2.new(1, -28, 0, 16), Color3.fromRGB(150, 165, 185), FONT2, al)
	local head = bar(p, UDim2.new(0, 14, 0, 54), UDim2.new(1, -28, 0, 16), RED, mirror)
	local body = bar(p, UDim2.new(0, mirror and 14 or 14, 0, 74), UDim2.new(0.75, -14, 0, 7), Color3.fromRGB(255, 153, 51), mirror)
	if mirror then body.back.Position = UDim2.new(0.25, 0, 0, 74) end
	local stam = bar(p, UDim2.new(0, 14, 0, 86), UDim2.new(1, -28, 0, 9), YELLOW, mirror)
	local flags = label(p, "", UDim2.new(0, 14, 0, 96), UDim2.new(1, -28, 0, 12), Color3.new(1, 1, 1), FONT, al)
	local _ = accent
	return { root = p, name = name, sub = sub, head = head, body = body, stam = stam, flags = flags }
end

-- ------------------------------------------------------------------ build
local function build()
	gui = make("ScreenGui", { Name = "NeonBayHUD", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5 }, player:WaitForChild("PlayerGui"))
	-- swollen eye vignettes
	refs.eyeL = frame(gui, UDim2.new(0, 0, 0, 0), UDim2.new(0.5, 0, 1, 0), Color3.fromRGB(12, 0, 6), 1, 0)
	make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 1), NumberSequenceKeypoint.new(1, 1) }) }, refs.eyeL)
	refs.eyeR = frame(gui, UDim2.new(0.5, 0, 0, 0), UDim2.new(0.5, 0, 1, 0), Color3.fromRGB(12, 0, 6), 1, 0)
	make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 1), NumberSequenceKeypoint.new(1, 0) }) }, refs.eyeR)
	refs.letterTop = frame(gui, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.1, 0), Color3.new(0, 0, 0), 0, 1)
	refs.letterBot = frame(gui, UDim2.new(0, 0, 0.9, 0), UDim2.new(1, 0, 0.1, 0), Color3.new(0, 0, 0), 0, 1)

	local fight = frame(gui, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), Color3.new(0, 0, 0), 1, 1)
	refs.fight = fight
	refs.red = fighterPanel(fight, false)
	refs.blue = fighterPanel(fight, true)
	local clock = frame(fight, UDim2.new(0.5, 0, 0, 14), UDim2.new(0, 190, 0, 96), Color3.fromRGB(4, 4, 10), 0.2, 2)
	clock.AnchorPoint = Vector2.new(0.5, 0)
	corner(clock, 8)
	stroke(clock, RED, 2)
	refs.round = label(clock, "ROUND 1 / 3", UDim2.new(0, 0, 0, 6), UDim2.new(1, 0, 0, 20), Color3.fromRGB(150, 165, 185), FONT2)
	refs.clock = label(clock, "1:30", UDim2.new(0, 0, 0, 28), UDim2.new(1, 0, 0, 60), Color3.new(1, 1, 1), FONT)
	refs.comment = label(fight, "", UDim2.new(0.5, 0, 1, -170), UDim2.new(0.7, 0, 0, 30), Color3.new(1, 1, 1), FONT2)
	refs.comment.AnchorPoint = Vector2.new(0.5, 0)
	refs.comment.BackgroundColor3 = Color3.new(0, 0, 0)
	refs.help = label(fight, "LMB jab · RMB cross · Q/E hooks · Z/X uppercuts · +CTRL body · +SHIFT power · SPACE block (tap = parry) · MOUSE slip/duck · C duck · F clinch · V taunt · B camera",
		UDim2.new(0.5, 0, 1, -34), UDim2.new(0.9, 0, 0, 20), Color3.fromRGB(170, 200, 220), FONT2)
	refs.help.AnchorPoint = Vector2.new(0.5, 0)

	-- count + get up
	refs.count = label(gui, "", UDim2.new(0.5, 0, 0.22, 0), UDim2.new(0, 260, 0, 170), Color3.new(1, 1, 1), FONT)
	refs.count.AnchorPoint = Vector2.new(0.5, 0)
	refs.countSub = label(gui, "", UDim2.new(0.5, 0, 0.22, 175), UDim2.new(0.6, 0, 0, 34), Color3.new(1, 1, 1), FONT2)
	refs.countSub.AnchorPoint = Vector2.new(0.5, 0)
	local gb = frame(gui, UDim2.new(0.5, 0, 0.64, 0), UDim2.new(0.42, 0, 0, 34), Color3.new(0, 0, 0), 0.25, 5)
	gb.AnchorPoint = Vector2.new(0.5, 0)
	stroke(gb, CYAN, 2)
	refs.getUp = gb
	refs.getUpZone = frame(gb, UDim2.new(0.375, 0, 0, 0), UDim2.new(0.25, 0, 1, 0), Config.Neon.Green, 0.45, 6)
	refs.getUpMarker = frame(gb, UDim2.new(0, 0, 0, -8), UDim2.new(0, 8, 1, 16), Color3.new(1, 1, 1), 0, 7)
	refs.getUpMeter = bar(gb, UDim2.new(0, 0, 1, 14), UDim2.new(1, 0, 0, 10), YELLOW, false)
	label(gb, "WILL TO CONTINUE  -  press SPACE / BLOCK in the green zone", UDim2.new(0, 0, 1, 28), UDim2.new(1, 0, 0, 18), Color3.fromRGB(180, 190, 200), FONT2)

	-- banner
	refs.banner = label(gui, "", UDim2.new(0.5, 0, 0.3, 0), UDim2.new(0.8, 0, 0, 90), Color3.new(1, 1, 1), TITLE)
	refs.banner.AnchorPoint = Vector2.new(0.5, 0)
	refs.bannerSub = label(gui, "", UDim2.new(0.5, 0, 0.3, 94), UDim2.new(0.6, 0, 0, 30), Color3.fromRGB(220, 220, 230), FONT2)
	refs.bannerSub.AnchorPoint = Vector2.new(0.5, 0)

	-- notifications
	refs.notify = label(gui, "", UDim2.new(0.5, 0, 0, 130), UDim2.new(0.5, 0, 0, 28), Color3.new(1, 1, 1), FONT2)
	refs.notify.AnchorPoint = Vector2.new(0.5, 0)
	refs.pads = label(gui, "", UDim2.new(0.5, 0, 0.75, 0), UDim2.new(0.6, 0, 0, 34), YELLOW, FONT)
	refs.pads.AnchorPoint = Vector2.new(0.5, 0)
end

-- ------------------------------------------------------------------ public: banners, popups, notes
local bannerToken = 0
function HUD.Banner(title, sub, color, t)
	bannerToken += 1
	local tok = bannerToken
	refs.banner.Text = title
	refs.banner.TextColor3 = color or Color3.new(1, 1, 1)
	refs.bannerSub.Text = sub or ""
	refs.banner.TextTransparency, refs.bannerSub.TextTransparency = 0, 0
	refs.banner.Size = UDim2.new(1.1, 0, 0, 110)
	TweenService:Create(refs.banner, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.new(0.8, 0, 0, 90) }):Play()
	task.delay(t or 2.6, function()
		if tok ~= bannerToken then return end
		TweenService:Create(refs.banner, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		TweenService:Create(refs.bannerSub, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
	end)
end

local noteToken = 0
function HUD.Notify(text, color)
	noteToken += 1
	local tok = noteToken
	refs.notify.Text = text
	refs.notify.TextColor3 = color or Color3.new(1, 1, 1)
	refs.notify.TextTransparency = 0
	task.delay(3.5, function() if tok == noteToken then refs.notify.TextTransparency = 1 end end)
end

function HUD.Popup(text, color, at: Vector3, size)
	local l = label(gui, text, UDim2.new(0, 0, 0, 0), UDim2.new(0, 360 * (size or 1), 0, 46 * (size or 1)), color or Color3.new(1, 1, 1), FONT)
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, l)
	table.insert(popups, { label = l, at = at, t = 1.1 })
end

-- ------------------------------------------------------------------ panels: tale of the tape, corner, result
local function clearPanel()
	if refs.panel then refs.panel:Destroy() refs.panel = nil end
end

local function panel(w, h)
	clearPanel()
	local p = frame(gui, UDim2.new(0.5, 0, 0.5, 0), UDim2.new(0, w, 0, h), Color3.fromRGB(6, 7, 14), 0.08, 10)
	p.AnchorPoint = Vector2.new(0.5, 0.5)
	corner(p, 10)
	stroke(p, RED, 2)
	make("UISizeConstraint", { MaxSize = Vector2.new(w, h) }, p)
	p.Size = UDim2.new(0.94, 0, 0.9, 0)
	refs.panel = p
	return p
end

local STAT_NAMES = { "power", "speed", "engine", "chin", "defense", "footwork", "heart" }

function HUD.Tape(ring)
	local p = panel(1100, 560)
	label(p, "TALE OF THE TAPE", UDim2.new(0, 0, 0, 14), UDim2.new(1, 0, 0, 46), YELLOW, TITLE)
	label(p, "THE PIT  //  " .. (ring:GetAttribute("Rounds") or 3) .. " ROUNDS  //  NEON BAY UNDERGROUND", UDim2.new(0, 0, 0, 62), UDim2.new(1, 0, 0, 20), Color3.fromRGB(150, 165, 185), FONT2)
	local function col(side, x, align, color)
		local nick = ring:GetAttribute(side .. "Nick") or ""
		label(p, (ring:GetAttribute(side .. "Name") or ""):upper(), UDim2.new(x, 0, 0, 96), UDim2.new(0.4, 0, 0, 38), color, FONT, align)
		label(p, (nick ~= "" and ('"' .. nick .. '"') or "") .. "\n" .. (ring:GetAttribute(side .. "Record") or "") .. "  ·  " .. (ring:GetAttribute(side .. "Style") or ""), UDim2.new(x, 0, 0, 136), UDim2.new(0.4, 0, 0, 44), Color3.new(1, 1, 1), FONT2, align)
		for i, n in STAT_NAMES do
			local v = (ring:GetAttribute(side .. "S_" .. n) or 50) / 100
			local b = frame(p, UDim2.new(x, 0, 0, 196 + i * 34), UDim2.new(0.38, 0, 0, 10), Color3.new(0, 0, 0), 0.3, 11)
			local fill = frame(b, UDim2.new(align == Enum.TextXAlignment.Right and 1 - v or 0, 0, 0, 0), UDim2.new(v, 0, 1, 0), color, 0, 12)
			local _ = fill
		end
	end
	col("Red", 0.05, Enum.TextXAlignment.Right, RED)
	col("Blue", 0.57, Enum.TextXAlignment.Left, BLUE)
	label(p, "VS", UDim2.new(0.45, 0, 0, 96), UDim2.new(0.1, 0, 0, 38), Color3.new(1, 1, 1), TITLE)
	for i, n in STAT_NAMES do
		label(p, n:upper(), UDim2.new(0.43, 0, 0, 190 + i * 34), UDim2.new(0.14, 0, 0, 20), Color3.fromRGB(150, 165, 185), FONT2)
	end
	label(p, '"' .. (ring:GetAttribute("Bio") or "") .. '"', UDim2.new(0.05, 0, 1, -64), UDim2.new(0.9, 0, 0, 40), Color3.fromRGB(170, 180, 195), FONT2)
end

function HUD.Corner(ev)
	local p = panel(560, 560)
	p.Position = UDim2.new(1, -24, 0.5, 0)
	p.AnchorPoint = Vector2.new(1, 0.5)
	p.Size = UDim2.new(0.42, 0, 0.82, 0)
	label(p, "CORNER  //  AFTER ROUND " .. ev.round, UDim2.new(0, 16, 0, 10), UDim2.new(1, -32, 0, 30), CYAN, FONT, Enum.TextXAlignment.Left)
	local me, them = ev.me, ev.them
	local rows = {
		{ "Punches landed", me.landed .. " / " .. me.thrown, them.landed .. " / " .. them.thrown },
		{ "Power punches", tostring(me.powerLanded), tostring(them.powerLanded) },
		{ "Body shots", tostring(me.bodyLanded), tostring(them.bodyLanded) },
		{ "Evaded / blocked", me.evaded .. " / " .. me.blocked, them.evaded .. " / " .. them.blocked },
	}
	label(p, "YOU", UDim2.new(0.5, 0, 0, 46), UDim2.new(0.22, 0, 0, 20), RED, FONT)
	label(p, "THEM", UDim2.new(0.74, 0, 0, 46), UDim2.new(0.22, 0, 0, 20), BLUE, FONT)
	for i, r in rows do
		local y = 46 + i * 26
		label(p, r[1], UDim2.new(0, 16, 0, y), UDim2.new(0.45, 0, 0, 20), Color3.fromRGB(150, 165, 185), FONT2, Enum.TextXAlignment.Left)
		label(p, r[2], UDim2.new(0.5, 0, 0, y), UDim2.new(0.22, 0, 0, 20), Color3.new(1, 1, 1), FONT2)
		label(p, r[3], UDim2.new(0.74, 0, 0, y), UDim2.new(0.22, 0, 0, 20), Color3.new(1, 1, 1), FONT2)
	end
	local dmg = { { "Cut", ev.cut, RED }, { "Left eye", ev.eyeL, Config.Neon.Purple }, { "Right eye", ev.eyeR, Config.Neon.Purple }, { "Concussion", ev.concussion, YELLOW }, { "Body", ev.ribs, Config.Neon.Orange } }
	label(p, "DAMAGE REPORT", UDim2.new(0, 16, 0, 186), UDim2.new(0.5, 0, 0, 16), Color3.fromRGB(150, 165, 185), FONT2, Enum.TextXAlignment.Left)
	for i, d in dmg do
		local y = 186 + i * 22
		label(p, d[1], UDim2.new(0, 16, 0, y), UDim2.new(0.3, 0, 0, 16), Color3.new(1, 1, 1), FONT2, Enum.TextXAlignment.Left)
		local b = frame(p, UDim2.new(0.36, 0, 0, y + 4), UDim2.new(0.58, 0, 0, 8), Color3.new(0, 0, 0), 0.3, 11)
		frame(b, UDim2.new(0, 0, 0, 0), UDim2.new(math.clamp(d[2] or 0, 0, 1), 0, 1, 0), d[3], 0, 12)
	end
	label(p, '<font color="#FFD826">COACH:</font> "' .. ev.advice .. '"', UDim2.new(0, 16, 0, 316), UDim2.new(1, -32, 0, 54), Color3.new(1, 1, 1), FONT2, Enum.TextXAlignment.Left)
	for i, o in ev.options do
		local col = (i - 1) % 2
		local row = math.floor((i - 1) / 2)
		local b
		b = button(p, o, UDim2.new(0.03 + col * 0.485, 0, 0, 384 + row * 58), UDim2.new(0.455, 0, 0, 48), CYAN, function()
			Controls.SendCorner(i)
			for _, c in p:GetChildren() do if c:IsA("TextButton") then c.AutoButtonColor = false; c.BackgroundTransparency = 0.6 end end
			b.BackgroundTransparency = 0
			b.BackgroundColor3 = Color3.fromRGB(10, 80, 90)
		end)
	end
	label(p, "Pick one before the bell", UDim2.new(0, 16, 1, -34), UDim2.new(1, -32, 0, 18), Color3.fromRGB(150, 165, 185), FONT2)
end

function HUD.Result(ev)
	local p = panel(1180, 640)
	local mine = (ev.winner == "Red" and player.Character and player.Character:GetAttribute("Corner") == 0) or (ev.winner == "Blue" and player.Character and player.Character:GetAttribute("Corner") == 1)
	label(p, ev.title, UDim2.new(0, 0, 0, 14), UDim2.new(1, 0, 0, 58), ev.winner == "" and Color3.new(1, 1, 1) or (mine and YELLOW or RED), TITLE)
	label(p, ev.method, UDim2.new(0, 0, 0, 74), UDim2.new(1, 0, 0, 26), Color3.new(1, 1, 1), FONT2)
	label(p, "OFFICIAL SCORECARDS", UDim2.new(0.03, 0, 0, 120), UDim2.new(0.4, 0, 0, 18), Color3.fromRGB(150, 165, 185), FONT2, Enum.TextXAlignment.Left)
	for i, c in ev.cards do
		local r, b, rounds = 0, 0, ""
		for j = 1, #c.red do r += c.red[j]; b += c.blue[j]; rounds ..= c.red[j] .. "-" .. c.blue[j] .. "  " end
		local y = 120 + i * 40
		label(p, c.name, UDim2.new(0.03, 0, 0, y), UDim2.new(0.25, 0, 0, 22), Color3.new(1, 1, 1), FONT2, Enum.TextXAlignment.Left)
		label(p, (#c.red > 0) and (r .. " - " .. b) or "-", UDim2.new(0.28, 0, 0, y), UDim2.new(0.12, 0, 0, 22), r > b and RED or b > r and BLUE or Color3.new(1, 1, 1), FONT)
		label(p, rounds, UDim2.new(0.03, 0, 0, y + 22), UDim2.new(0.42, 0, 0, 14), Color3.fromRGB(150, 165, 185), FONT2, Enum.TextXAlignment.Left)
	end
	local a, bb = ev.red, ev.blue
	local function pct(l, t) return t > 0 and (math.floor(100 * l / t + 0.5) .. "%") or "0%" end
	local stats = {
		{ "", ev.redName:split(" ")[1], ev.blueName:split(" ")[1] },
		{ "Total", a.landed .. "/" .. a.thrown .. " " .. pct(a.landed, a.thrown), bb.landed .. "/" .. bb.thrown .. " " .. pct(bb.landed, bb.thrown) },
		{ "Jabs", a.jabsLanded .. "/" .. a.jabsThrown, bb.jabsLanded .. "/" .. bb.jabsThrown },
		{ "Power", a.powerLanded .. "/" .. a.powerThrown, bb.powerLanded .. "/" .. bb.powerThrown },
		{ "Body / head", a.bodyLanded .. " / " .. a.headLanded, bb.bodyLanded .. " / " .. bb.headLanded },
		{ "Counters", tostring(a.counters), tostring(bb.counters) },
		{ "Knockdowns", tostring(a.knockdowns), tostring(bb.knockdowns) },
		{ "Evaded / blocked", a.evaded .. " / " .. a.blocked, bb.evaded .. " / " .. bb.blocked },
	}
	label(p, "PUNCH STATS", UDim2.new(0.52, 0, 0, 120), UDim2.new(0.4, 0, 0, 18), Color3.fromRGB(150, 165, 185), FONT2, Enum.TextXAlignment.Left)
	for i, s in stats do
		local y = 120 + i * 30
		label(p, s[1], UDim2.new(0.52, 0, 0, y), UDim2.new(0.16, 0, 0, 22), Color3.fromRGB(150, 165, 185), FONT2, Enum.TextXAlignment.Left)
		label(p, s[2], UDim2.new(0.68, 0, 0, y), UDim2.new(0.14, 0, 0, 22), RED, FONT2)
		label(p, s[3], UDim2.new(0.83, 0, 0, y), UDim2.new(0.14, 0, 0, 22), BLUE, FONT2)
	end
	local myCorner = player.Character and player.Character:GetAttribute("Corner")
	local purse = myCorner == 0 and ev.redPurse or myCorner == 1 and ev.bluePurse or nil
	if purse then
		label(p, "PURSE  $" .. purse .. "   ·   CAREER " .. (player:GetAttribute("Wins") or 0) .. "-" .. (player:GetAttribute("Losses") or 0) .. "  (" .. (player:GetAttribute("KOs") or 0) .. " KO)", UDim2.new(0, 0, 1, -70), UDim2.new(1, 0, 0, 30), YELLOW, FONT)
	end
	label(p, "Returning to the warehouse...", UDim2.new(0, 0, 1, -34), UDim2.new(1, 0, 0, 18), Color3.fromRGB(150, 165, 185), FONT2)
end

-- ------------------------------------------------------------------ per frame
local function ringOfInterest()
	local c = player.Character
	local r = c and c:FindFirstChild("Ring")
	if r and r.Value and c:GetAttribute("Fighter") then return r.Value, true end
	-- spectating: nearest busy ring
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	local map = workspace:FindFirstChild("Map")
	if not hrp or not map then return nil end
	local best, bd = nil, 70
	for _, d in map:GetDescendants() do
		if d:IsA("Model") and d:GetAttribute("IsRing") and d:GetAttribute("Busy") then
			local cv = d:FindFirstChild("Canvas")
			if cv then
				local dist = (cv.Position - hrp.Position).Magnitude
				if dist < bd then best, bd = d, dist end
			end
		end
	end
	return best, false
end

local lastPhase, lastRing
local function updatePanel(fighter, ring)
	local function fill(pnl, m)
		if not m then return end
		local nick = m:GetAttribute("Nick") or ""
		local side = (m:GetAttribute("Corner") == 0) and "Red" or "Blue"
		pnl.name.Text = (ring:GetAttribute(side .. "Name") or m.Name):upper()
		local n = ring:GetAttribute(side .. "Nick") or nick
		pnl.sub.Text = (n ~= "" and ('"' .. n .. '"  ') or "") .. (ring:GetAttribute(side .. "Record") or "") .. "   " .. (ring:GetAttribute(side .. "Style") or "")
		local dt = 1 / 60
		setBar(pnl.head, (m:GetAttribute("HeadHP") or 100) / 100, (m:GetAttribute("HeadCap") or 100) / 100, dt)
		setBar(pnl.body, (m:GetAttribute("BodyHP") or 100) / 100, 1, dt)
		setBar(pnl.stam, (m:GetAttribute("Stam") or 100) / 110, (m:GetAttribute("StamMax") or 100) / 110, dt)
		local flags = {}
		if (m:GetAttribute("Rocked") or 0) > 0 then table.insert(flags, '<font color="#FF3344">ROCKED</font>') end
		if math.max(m:GetAttribute("I_CutL") or 0, m:GetAttribute("I_CutR") or 0) > 0.3 then table.insert(flags, '<font color="#FF5566">CUT</font>') end
		if (m:GetAttribute("Stam") or 100) < 20 then table.insert(flags, '<font color="#FFD826">GASSED</font>') end
		pnl.flags.Text = table.concat(flags, "  ")
	end
	local rm = ring:FindFirstChild("RedModel")
	local bm = ring:FindFirstChild("BlueModel")
	fill(refs.red, rm and rm.Value)
	fill(refs.blue, bm and bm.Value)
	local _ = fighter
end

function HUD.Start(controls)
	Controls = controls
	build()
	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		-- popups
		for i = #popups, 1, -1 do
			local p = popups[i]
			p.t -= dt
			p.at += Vector3.new(0, dt * 1.1, 0)
			local sp, on = cam:WorldToViewportPoint(p.at)
			p.label.Visible = on
			p.label.Position = UDim2.new(0, sp.X, 0, sp.Y)
			p.label.TextTransparency = 1 - math.clamp(p.t * 2, 0, 1)
			if p.t <= 0 then p.label:Destroy(); table.remove(popups, i) end
		end
		local ring, mine = ringOfInterest()
		local c = player.Character
		refs.fight.Visible = ring ~= nil
		refs.help.Visible = mine == true and (ring and ring:GetAttribute("Phase") == "Fight")
		-- PvP pad prompt
		local padText = ""
		local map = workspace:FindFirstChild("Map")
		if map and not mine then
			for _, d in map:GetDescendants() do
				if d:IsA("Model") and d:GetAttribute("IsRing") and not d:GetAttribute("Busy") then
					local a, b = d:GetAttribute("PadRed") or "", d:GetAttribute("PadBlue") or ""
					local me = player.DisplayName
					if a == me or b == me then
						local cd = d:GetAttribute("Countdown") or -1
						padText = (a ~= "" and b ~= "") and ("PvP FIGHT STARTS IN " .. math.ceil(cd)) or "WAITING FOR AN OPPONENT ON THE OTHER CORNER PAD..."
					end
				end
			end
		end
		refs.pads.Text = padText
		-- swollen eyes / letterbox
		local eyeL = mine and c and math.clamp(((c:GetAttribute("I_EyeL") or 0) - 0.35) * 1.4, 0, 1) or 0
		local eyeR = mine and c and math.clamp(((c:GetAttribute("I_EyeR") or 0) - 0.35) * 1.4, 0, 1) or 0
		refs.eyeL.BackgroundTransparency = 1 - eyeL * 0.95
		refs.eyeR.BackgroundTransparency = 1 - eyeR * 0.95
		local phase = ring and ring:GetAttribute("Phase") or ""
		local cine = phase == "Intro" or phase == "KO"
		refs.letterTop.Visible, refs.letterBot.Visible = cine and mine == true, cine and mine == true
		refs.count.Text, refs.countSub.Text = "", ""
		refs.getUp.Visible = false
		if not ring then
			if refs.panel and lastPhase ~= "Shop" then clearPanel() end
			lastPhase, lastRing = nil, nil
			return
		end
		updatePanel(c, ring)
		refs.round.Text = "ROUND " .. math.max(1, ring:GetAttribute("Round") or 1) .. " / " .. (ring:GetAttribute("Rounds") or 3)
		local clock = ring:GetAttribute("Clock") or 0
		refs.clock.Text = Util.formatTime(clock)
		refs.clock.TextColor3 = (clock < 10 and phase == "Fight") and RED:Lerp(Color3.new(1, 1, 1), (math.sin(os.clock() * 8) + 1) / 2) or Color3.new(1, 1, 1)
		local ct = ring:GetAttribute("CommentT") or -99
		local age = workspace:GetServerTimeNow() - ct
		refs.comment.Text = age < 3.5 and ('<font color="#FFD826">MIC MALONE:</font>  ' .. (ring:GetAttribute("Comment") or "")) or ""
		refs.comment.BackgroundTransparency = age < 3.5 and 0.5 or 1
		if phase == "Knockdown" then
			local n = ring:GetAttribute("Count") or 0
			refs.count.Text = n > 0 and tostring(n) or ""
			refs.count.TextColor3 = n >= 8 and RED or Color3.new(1, 1, 1)
			local downed = ring:GetAttribute("Downed") or ""
			local myCorner = c and c:GetAttribute("Corner")
			local meDown = mine and ((downed == "Red" and myCorner == 0) or (downed == "Blue" and myCorner == 1))
			refs.countSub.Text = meDown and "GET UP!" or (downed ~= "" and ((ring:GetAttribute(downed .. "Name") or ""):upper() .. " IS DOWN") or "HE'S UP!")
			if meDown and n >= 1 and Controls then
				local g = Controls.getUp
				refs.getUp.Visible = true
				refs.getUpZone.Size = UDim2.new(g.zone, 0, 1, 0)
				refs.getUpZone.Position = UDim2.new(0.5 - g.zone / 2, 0, 0, 0)
				refs.getUpMarker.Position = UDim2.new(g.marker, -4, 0, -8)
				setBar(refs.getUpMeter, g.meter or 0, 1, dt)
			end
		end
		if phase ~= lastPhase or ring ~= lastRing then
			if phase == "Intro" then HUD.Tape(ring)
			elseif phase ~= "Corner" and phase ~= "Result" and phase ~= "KO" then clearPanel() end
			lastPhase, lastRing = phase, ring
		end
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="772">
          <Properties>
            <string name="Name">FX</string>
            <string name="Source"><![CDATA[--[[ Client effects: sounds, sweat spray, blood mist and drops, canvas stains, screen flash/blur, camera trauma. ]]

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)

local FX = {}

-- ------------------------------------------------------------------ camera feel (read by CameraController)
FX.trauma = 0
FX.kick = Vector3.zero
FX.kickV = Vector3.zero
FX.fov = 0
FX.fovV = 0
FX.dizzy = 0
FX.dizzyHold = 0

function FX.Shake(a) FX.trauma = math.clamp(FX.trauma + a, 0, 1) end
function FX.Kick(euler: Vector3) FX.kickV += euler * 22 end
function FX.FovPunch(d) FX.fovV += d * 18 end
function FX.Dizzy(a, hold) FX.dizzy = math.max(FX.dizzy, a); FX.dizzyHold = math.max(FX.dizzyHold, hold or 1) end

local cc = Instance.new("ColorCorrectionEffect")
cc.Name = "NeonBayHitFX"
cc.Parent = Lighting
local blur = Instance.new("BlurEffect")
blur.Name = "NeonBayBlur"
blur.Size = 0
blur.Parent = Lighting
local flash, flashColor, blurAmt, blurHold = 0, Color3.new(1, 1, 1), 0, 0

function FX.Flash(color, amount) flashColor = color; flash = math.max(flash, amount) end
function FX.Blur(amount, hold) blurAmt = math.max(blurAmt, amount); blurHold = math.max(blurHold, hold or 0.5) end

RunService.RenderStepped:Connect(function(dt)
	FX.trauma = math.max(0, FX.trauma - dt * 1.35)
	FX.kickV += (-FX.kick * 260 - FX.kickV * 22) * dt
	FX.kick += FX.kickV * dt
	FX.fovV += (-FX.fov * 200 - FX.fovV * 18) * dt
	FX.fov += FX.fovV * dt
	FX.dizzyHold -= dt
	if FX.dizzyHold <= 0 then FX.dizzy = math.max(0, FX.dizzy - dt * 0.35) end
	flash = math.max(0, flash - dt * 2.6)
	blurHold -= dt
	if blurHold <= 0 then blurAmt = math.max(0, blurAmt - dt * 0.9) end
	cc.TintColor = Color3.new(1, 1, 1):Lerp(flashColor, flash * 0.6)
	cc.Brightness = flash * 0.08
	cc.Saturation = -FX.dizzy * 0.4
	blur.Size = math.max(blurAmt, FX.dizzy * 0.5) * 14
end)

function FX.ShakeOffset(t)
	local s = FX.trauma * FX.trauma
	local n = function(a, b) return math.noise(a, b, 0.5) end
	local rot = Vector3.new(n(t * 24, 3.1), n(5.3, t * 24), n(t * 24, 7.7)) * s * 9
	local sway = Vector3.new(math.sin(t * 1.3) * 1.6, math.sin(t * 0.83) * 2.4, math.sin(t * 1.1) * 3.5) * FX.dizzy
	return rot + FX.kick + sway
end

-- ------------------------------------------------------------------ sound
local soundCache = {}
local function makeSound(name)
	local def = Config.Sounds[name]
	if not def or def.id == "" then return nil end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = def.id
	s.Volume = def.volume or 1
	s.PlaybackSpeed = def.pitch or 1
	if def.distortion then
		local d = Instance.new("DistortionSoundEffect")
		d.Level = def.distortion
		d.Parent = s
	end
	if def.reverb then
		local r = Instance.new("ReverbSoundEffect")
		r.DecayTime = 2.4
		r.WetLevel = -4
		r.Parent = s
	end
	return s
end

function FX.Play(name, at: Vector3?, volume, pitch)
	local proto = soundCache[name]
	if proto == nil then
		proto = makeSound(name) or false
		soundCache[name] = proto
	end
	if not proto then return end
	local s = proto:Clone()
	s.Volume *= volume or 1
	s.PlaybackSpeed *= (pitch or 1) * (0.94 + math.random() * 0.12)
	if at then
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
		p.Transparency = 1
		p.Size = Vector3.new(0.2, 0.2, 0.2)
		p.CFrame = CFrame.new(at)
		s.RollOffMinDistance = 8
		s.RollOffMaxDistance = 140
		s.Parent = p
		p.Parent = workspace
		s:Play()
		Debris:AddItem(p, 4)
	else
		s.Parent = SoundService
		s:Play()
		Debris:AddItem(s, 4)
	end
end

-- ------------------------------------------------------------------ particles
local holder = Instance.new("Part")
holder.Name = "NeonBayFX"
holder.Anchored = true
holder.CanCollide, holder.CanQuery, holder.CanTouch = false, false, false
holder.Transparency = 1
holder.Size = Vector3.new(0.2, 0.2, 0.2)
holder.Parent = workspace

local function emitter(name, color, size, life, speed, grav, light)
	local a = Instance.new("Attachment")
	a.Name = name
	a.Parent = holder
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Rate = 0
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.4) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(life * 0.5, life)
	e.Speed = NumberRange.new(speed * 0.4, speed)
	e.SpreadAngle = Vector2.new(35, 35)
	e.Acceleration = Vector3.new(0, -grav, 0)
	e.Drag = 2
	e.LightEmission = light or 0
	e.EmissionDirection = Enum.NormalId.Front
	e.Parent = a
	return a, e
end

local sweatAtt, sweatEm = emitter("Sweat", Color3.fromRGB(215, 235, 255), 0.12, 0.6, 14, 30, 0.2)
local bloodAtt, bloodEm = emitter("Blood", Color3.fromRGB(120, 8, 12), 0.18, 0.55, 10, 28, 0)
local sparkAtt, sparkEm = emitter("Spark", Color3.fromRGB(255, 240, 220), 0.25, 0.2, 6, 0, 0.6)

local function aim(att, pos: Vector3, dir: Vector3)
	local look = dir.Magnitude > 0 and dir.Unit or Vector3.new(0, 0, -1)
	att.CFrame = holder.CFrame:ToObjectSpace(CFrame.lookAt(pos, pos + look))
end

function FX.Sweat(pos, dir, n)
	aim(sweatAtt, pos, dir + Vector3.new(0, 0.3, 0))
	sweatEm:Emit(n or 14)
end

function FX.BloodSpray(pos, dir, n)
	aim(bloodAtt, pos, dir)
	bloodEm:Emit(n or 6)
	for _ = 1, math.max(1, math.floor((n or 6) / 3)) do
		FX.Drop(pos, dir * 6 + Vector3.new(math.random() - 0.5, 1, math.random() - 0.5) * 4)
	end
end

function FX.ImpactPuff(pos, dir)
	aim(sparkAtt, pos, -dir)
	sparkEm:Emit(4)
end

-- falling drops that leave stains on the canvas / floor
local drops = {}
local stainCount = 0
function FX.Drop(pos: Vector3, vel: Vector3)
	if #drops > 60 then return end
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.08, 0.08, 0.08)
	p.Color = Color3.fromRGB(110, 6, 10)
	p.Material = Enum.Material.SmoothPlastic
	p.Reflectance = 0.2
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
	p.CastShadow = false
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	table.insert(drops, { part = p, vel = vel, life = 2.5 })
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function stain(pos: Vector3, normal: Vector3)
	stainCount += 1
	local s = Instance.new("Part")
	s.Name = "BloodStain"
	s.Anchored = true
	s.CanCollide, s.CanQuery, s.CanTouch = false, false, false
	s.CastShadow = false
	local sz = 0.15 + math.random() * 0.35
	s.Size = Vector3.new(sz, 0.02, sz * (0.7 + math.random() * 0.6))
	s.Color = Color3.fromRGB(90, 4, 8)
	s.Material = Enum.Material.SmoothPlastic
	s.Reflectance = 0.15
	s.Transparency = 0.15
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = s
	s.CFrame = CFrame.new(pos + normal * 0.01) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	s.Parent = workspace
	Debris:AddItem(s, 90)
end

RunService.Heartbeat:Connect(function(dt)
	if #drops == 0 then return end
	local map = workspace:FindFirstChild("Map")
	rayParams.FilterDescendantsInstances = map and { map } or {}
	for i = #drops, 1, -1 do
		local d = drops[i]
		d.life -= dt
		d.vel += Vector3.new(0, -workspace.Gravity * 0.3 * dt, 0)
		local from = d.part.Position
		local step = d.vel * dt
		local hit = workspace:Raycast(from, step, rayParams)
		if hit or d.life <= 0 then
			if hit then stain(hit.Position, hit.Normal) end
			d.part:Destroy()
			table.remove(drops, i)
		else
			d.part.CFrame = CFrame.new(from + step)
		end
	end
end)

return FX
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="773">
          <Properties>
            <string name="Name">Client</string>
            <string name="Source"><![CDATA[--[[ NEON BAY: THE PIT - client entry. Wires server events into animation, effects, camera and UI. ]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local Remotes = ReplicatedStorage:WaitForChild("NeonBayRemotes")

local Animator = require(script.Parent.Animator)
local FX = require(script.Parent.FX)
local CameraController = require(script.Parent.CameraController)
local Controls = require(script.Parent.Controls)
local HUD = require(script.Parent.HUD)
local Menus = require(script.Parent.Menus)
local Ropes = require(script.Parent.Ropes)
local Crowd = require(script.Parent.Crowd)

local player = Players.LocalPlayer

pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false) end)
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)

Animator.Start()
CameraController.Start()
Controls.Start()
HUD.Start(Controls)
Menus.Start(Controls)
task.spawn(Ropes.Start)
task.spawn(Crowd.Start)

local function myModel() return player.Character end

local function ringOf(model)
	local r = model and model:FindFirstChild("Ring")
	return r and r.Value
end

-- ------------------------------------------------------------------ impacts
Remotes:WaitForChild("Impact").OnClientEvent:Connect(function(ev)
	if ev.type == "bag" then
		FX.Play("bag", ev.pos, ev.power and 1 or 0.7)
		return
	end
	local att, def = ev.att, ev.def
	if not att or not def then return end
	local me = myModel()
	local pos, dir = ev.pos, ev.dir
	local res = ev.res
	if res == "miss" then
		FX.Play("whiff", pos, 0.6)
		return
	end
	if res == "slip" then
		FX.Play("whiff", pos, 0.9, 0.85)
		HUD.Popup(((def:GetAttribute("LeanY") or 0) < -0.4) and "DUCKED" or "SLIPPED", Color3.fromRGB(150, 230, 255), pos + Vector3.new(0, 1, 0), 0.7)
		if def == me then FX.Kick(Vector3.new(0, (def:GetAttribute("LeanX") or 0) * 2, -(def:GetAttribute("LeanX") or 0) * 3)) end
		return
	end
	if res == "parry" then
		FX.Play("glove_block", pos, 1, 1.25)
		HUD.Popup("PARRY!", Config.Neon.Cyan, pos + Vector3.new(0, 1, 0), 1)
		Animator.React(att, -dir, 0.5, false, false)
		return
	end
	local pk = ev.pk or 0.5
	if res == "block" then
		FX.Play("glove_block", pos, 0.8)
		FX.ImpactPuff(pos, dir)
		Animator.React(def, dir, pk * 0.3, not ev.body, ev.body)
		if def == me then FX.Shake(0.06 + pk * 0.05); FX.Kick(Vector3.new(-1, 0, 0) * (1 + pk)) end
		return
	end
	-- clean
	Animator.React(def, dir, pk, not ev.body, ev.body)
	FX.Play(ev.body and "glove_body" or (pk > 0.9 and "glove_heavy" or "glove_head"), pos, 0.6 + 0.4 * math.min(pk, 1))
	if not ev.body then FX.Play("glove_snap", pos, 0.6) end
	if not ev.body then
		FX.Sweat(pos + Vector3.new(0, 0.4, 0), dir, math.floor(10 + pk * 26))
		local bleeding = (def:GetAttribute("I_Bleed") or 0) > 0.2 or pk > 1
		if bleeding then FX.BloodSpray(pos, dir, math.floor(2 + pk * 5)) end
	end
	local ring = ringOf(def)
	if pk > 0.75 or ev.counter then Crowd.Excite(ring, ev.counter and 0.45 or 0.3) end
	if ev.counter then HUD.Popup("COUNTER!", Config.Neon.Yellow, pos + Vector3.new(0, 1.2, 0), 1.1)
	elseif ev.power and pk > 0.8 then HUD.Popup("POWER SHOT", Config.Neon.Orange, pos + Vector3.new(0, 1.2, 0), 0.95)
	elseif ev.body and pk > 0.6 then HUD.Popup("BODY!", Color3.fromRGB(255, 153, 77), pos + Vector3.new(0, 0.6, 0), 0.8) end
	if ev.rocked and pk > 0.6 then HUD.Popup("ROCKED!", Config.Neon.Red, pos + Vector3.new(0, 1.8, 0), 1.2) end
	if att == me then
		FX.Shake(0.05 + pk * 0.1)
		FX.FovPunch(-pk * 1.2)
	end
	if def == me then
		FX.Shake(0.22 + pk * 0.28)
		local cam = workspace.CurrentCamera
		local l = cam.CFrame:VectorToObjectSpace(dir)
		FX.Kick(Vector3.new(-l.Y - math.abs(l.Z) * 0.6, -l.X, -l.X * 0.8) * (3 + pk * 5))
		FX.Flash(Color3.fromRGB(200, 20, 20), 0.2 + pk * 0.25)
		if ev.rocked then FX.Dizzy(0.6, 2.5); FX.Blur(0.4, 1) end
	end
end)

-- ------------------------------------------------------------------ match flow
Remotes:WaitForChild("MatchEvent").OnClientEvent:Connect(function(ev)
	local ring = ev.ring
	local me = myModel()
	local mine = me and ringOf(me) == ring and me:GetAttribute("Fighter")
	local near = false
	if ring and me and me:FindFirstChild("HumanoidRootPart") and ring:FindFirstChild("Canvas") then
		near = (ring.Canvas.Position - me.HumanoidRootPart.Position).Magnitude < 80
	end
	if not mine and not near then return end
	local t = ev.type
	if t == "intro" then
		Crowd.Excite(ring, 0.6)
	elseif t == "round" then
		HUD.Banner("ROUND " .. ev.n, ev.final and "FINAL ROUND" or ((ring:GetAttribute("RedName") or "") .. "  vs  " .. (ring:GetAttribute("BlueName") or "")), Config.Neon.Red)
	elseif t == "bell" then
		for i = 1, ev.count or 1 do task.delay((i - 1) * 0.32, function() FX.Play("bell", ring.Canvas.Position + Vector3.new(0, 6, 0), 1) end) end
	elseif t == "knockdown" then
		FX.Play("canvas", ring.Canvas.Position, 1)
		if ev.ko then FX.Play("ko", ring.Canvas.Position, 1) end
		Crowd.Excite(ring, 1)
		HUD.Banner(ev.ko and "KNOCKOUT!" or "KNOCKDOWN!", "", Config.Neon.Red, 2)
		FX.Shake(0.5)
		if ev.victim == me then FX.Flash(Color3.new(1, 1, 1), 0.8); FX.Dizzy(1, 3); FX.Blur(1, 2) end
	elseif t == "count" then
		FX.Play("count", nil, 0.8, 1 + ev.n * 0.02)
	elseif t == "getup" then
		Crowd.Excite(ring, 0.5)
	elseif t == "popup" then
		HUD.Popup(ev.text, ev.color, ev.at, 0.9)
	elseif t == "corner" and mine then
		HUD.Corner(ev)
	elseif t == "result" then
		Crowd.Excite(ring, 1)
		if mine then HUD.Result(ev) else HUD.Banner(ev.title, ev.method, Config.Neon.Yellow, 4) end
	end
end)

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(ev)
	HUD.Notify(ev.text, ev.color)
end)

print("[NeonBay] THE PIT client ready")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="774">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	Fight camera: over-the-shoulder framing of both fighters, a broadcast side angle (B / gamepad Y-click),
	a low knockdown angle, a slow KO orbit, a corner close-up that shows the damage on your face, and a
	result hero shot. Every mode goes through FX for shake, kicks and FOV punches. Outside fights the
	default Roblox camera is used.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local FX = require(script.Parent.FX)

local CameraController = {}
CameraController.broadcast = false
CameraController.active = false

local player = Players.LocalPlayer
local pos, rot, fov = nil, nil, 50
local orbit = 0

local function myFighter()
	local c = player.Character
	if c and c:GetAttribute("Fighter") then return c end
	return nil
end

local function head(m)
	local h = m and m:FindFirstChild("Head")
	return h and (h.CFrame * CFrame.new(0, 0.42, 0)).Position or (m and m:GetPivot().Position) or Vector3.zero
end

local function flatUnit(v)
	local f = Vector3.new(v.X, 0, v.Z)
	return f.Magnitude > 1e-3 and f.Unit or Vector3.new(0, 0, -1)
end

function CameraController.Start()
	RunService:BindToRenderStep("NeonBayCamera", Enum.RenderPriority.Camera.Value + 2, function(dt)
		local cam = workspace.CurrentCamera
		local me = myFighter()
		local ringVal = me and me:FindFirstChild("Ring")
		local ring = ringVal and ringVal.Value
		if not me or not ring then
			if CameraController.active then
				CameraController.active = false
				cam.CameraType = Enum.CameraType.Custom
				cam.FieldOfView = 70
				local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if hum then cam.CameraSubject = hum end
			end
			return
		end
		CameraController.active = true
		cam.CameraType = Enum.CameraType.Scriptable
		local oppVal = me:FindFirstChild("Opponent")
		local opp = oppVal and oppVal.Value
		local phase = ring:GetAttribute("Phase") or "Fight"
		local canvas = ring:FindFirstChild("Canvas")
		local center = canvas and (canvas.Position + Vector3.new(0, canvas.Size.Y / 2, 0)) or me:GetPivot().Position
		local ph, oh = head(me), head(opp)
		local k = me:GetAttribute("Scale") or 3.2
		orbit += dt * 0.25
		local wantPos, wantLook, wantFov
		if phase == "Intro" then
			local a = orbit * 0.6 + 0.8
			wantPos = center + Vector3.new(math.cos(a) * 17, 6, math.sin(a) * 17)
			wantLook = center + Vector3.new(0, 4.5, 0)
			wantFov = 46
		elseif phase == "Corner" then
			local h = me:FindFirstChild("Head")
			local f = h and flatUnit(h.CFrame.LookVector) or flatUnit(me:GetPivot().LookVector)
			wantPos = ph + f * 2.7 + Vector3.new(0, 0.1, 0) + me:GetPivot().RightVector * 0.6
			wantLook = ph
			wantFov = 34
		elseif phase == "Knockdown" then
			local downedName = ring:GetAttribute("Downed")
			local dm = downedName == "Red" and ring:FindFirstChild("RedModel") or ring:FindFirstChild("BlueModel")
			local dmod = dm and dm.Value
			local dp = dmod and dmod:FindFirstChild("LowerTorso") and dmod.LowerTorso.Position or center
			local side = flatUnit(dp - center):Cross(Vector3.yAxis)
			wantPos = dp + side * 8.5 + Vector3.new(0, 1.8, 0) - flatUnit(dp - center) * 2
			wantLook = dp + Vector3.new(0, 0.8, 0)
			wantFov = 48
		elseif phase == "KO" or phase == "Result" then
			local winner = ring:GetAttribute("WinnerCorner") or ""
			local loserModel = (winner == "Red") and opp or me
			if winner == "" then loserModel = opp end
			if phase == "Result" then
				local hero = (winner == "Blue") and opp or me
				local hh = head(hero)
				local f = hero and flatUnit(hero:GetPivot().LookVector) or Vector3.new(0, 0, -1)
				wantPos = hh + f * 7.5 + Vector3.new(0, -1, 0) + (hero and hero:GetPivot().RightVector or Vector3.xAxis) * 2
				wantLook = hh
				wantFov = 42
			else
				local lt = loserModel and loserModel:FindFirstChild("LowerTorso")
				local focus = lt and lt.Position or center
				local a = orbit * 1.6
				wantPos = focus + Vector3.new(math.cos(a) * 10, 2.3, math.sin(a) * 10)
				wantLook = focus + Vector3.new(0, 1, 0)
				wantFov = 44
			end
		else
			local toOpp = Vector3.new(oh.X - ph.X, 0, oh.Z - ph.Z)
			local dist = math.max(1, toOpp.Magnitude)
			local dir = toOpp / dist
			local right = dir:Cross(Vector3.yAxis)
			if CameraController.broadcast then
				local mid = (ph + oh) / 2
				local side = right
				if side:Dot(Vector3.new(center.X - mid.X, 0, center.Z - mid.Z)) > 0 then side = -side end
				wantPos = mid - side * (11 + dist * 0.8) + Vector3.new(0, 1.2, 0)
				wantLook = mid - Vector3.new(0, 0.2, 0)
				wantFov = 44
			else
				local back = 5.6 + math.clamp((dist / k - 0.6) / 1.6, 0, 1) * 2.1
				wantPos = ph - dir * back + right * 1.75 + Vector3.new(0, 0.95, 0)
				wantLook = ph:Lerp(oh, 0.68) - Vector3.new(0, 0.25, 0)
				wantFov = 48 + math.clamp((dist / k - 0.7) / 1.5, 0, 1) * 8
			end
		end
		local posK = (phase == "Fight") and 9 or 4
		if not pos then pos, rot, fov = wantPos, CFrame.lookAt(wantPos, wantLook), wantFov end
		pos = pos:Lerp(wantPos, 1 - math.exp(-posK * dt))
		local wantRot = CFrame.lookAt(pos, wantLook)
		rot = rot:Lerp(wantRot, 1 - math.exp(-11 * dt))
		fov += (wantFov - fov) * (1 - math.exp(-5 * dt))
		local off = FX.ShakeOffset(os.clock())
		local shakePos = Vector3.new(math.noise(os.clock() * 21, 0.1, 2), math.noise(0.3, os.clock() * 21, 2), 0) * FX.trauma * FX.trauma * 0.6
		cam.CFrame = CFrame.new(pos) * (rot - rot.Position) * CFrame.new(shakePos) * CFrame.Angles(math.rad(off.X), math.rad(off.Y), math.rad(off.Z))
		cam.FieldOfView = fov + FX.fov
	end)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="775">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--[[
	Fight controls for keyboard + mouse, gamepad and touch (mobile gets on-screen buttons automatically).

	KB+M:  LMB jab  RMB cross  Q/E hooks  Z/X uppercuts  hold CTRL body  hold SHIFT power
	       SPACE block (tap just before a punch lands = parry, CTRL+SPACE = body guard)
	       MOUSE slip / duck / lean back   C duck   F clinch   V taunt   B camera
	Pad:   X jab  Y cross  B lead hook  A rear hook  R1 uppercut  L2 body  R2 power  L1 block  right stick lean
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Util = require(Shared.Util)
local Remotes = ReplicatedStorage:WaitForChild("NeonBayRemotes")
local InputEv = Remotes:WaitForChild("Input")
local LeanEv = Remotes:WaitForChild("Lean")

local Animator = require(script.Parent.Animator)
local CameraController = require(script.Parent.CameraController)

local Controls = {}
local player = Players.LocalPlayer

local held = { block = false, body = false, power = false, duck = false }
local touchBody, touchPower = false, false
local leanAcc = Vector3.zero
local padLean = Vector2.zero
local lastLeanSend, sentLean = 0, Vector3.zero
local lastGuard = -1
Controls.getUp = { marker = 0, dir = 1, zone = 0.25, active = false }
Controls.uiOpen = false

local function myChar() return player.Character end

local function fighting()
	local c = myChar()
	if not c or not c:GetAttribute("Fighter") then return false end
	local r = c:FindFirstChild("Ring")
	return r and r.Value ~= nil
end

local function phase()
	local c = myChar()
	local r = c and c:FindFirstChild("Ring")
	return r and r.Value and r.Value:GetAttribute("Phase") or ""
end

local function send(msg) InputEv:FireServer(msg) end

local function punch(id)
	if Controls.uiOpen then return end
	local c = myChar()
	if not c then return end
	local body = held.body or touchBody
	local power = held.power or touchPower
	if fighting() then
		if phase() ~= "Fight" or c:GetAttribute("State") ~= "Fight" then return end
		if (c:GetAttribute("Act") or 0) == 0 then Animator.Predict(c, id, body, power, 1) end
	else
		Animator.Predict(c, id, body, power, 1)
	end
	send({ k = "punch", id = id, body = body, power = power })
end

local function getUpPress()
	local g = Controls.getUp
	if not g.active then return end
	local hit = math.abs(g.marker - 0.5) < g.zone * 0.5
	send({ k = "getup", hit = hit })
	g.flash = hit and 1 or -1
end

local function bind(name, fn, touchTitle, ...)
	ContextActionService:BindActionAtPriority(name, function(_, state, input)
		if state == Enum.UserInputState.Begin then fn(true, input) elseif state == Enum.UserInputState.End then fn(false, input) end
		if name == "NB_Block" or name == "NB_Jab" or name == "NB_Cross" then
			return fighting() and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
		end
		return Enum.ContextActionResult.Pass
	end, touchTitle ~= nil, Enum.ContextActionPriority.High.Value, ...)
	if touchTitle then
		ContextActionService:SetTitle(name, touchTitle)
	end
end

function Controls.Start()
	bind("NB_Jab", function(down) if down then punch(1) end end, "JAB", Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonX)
	bind("NB_Cross", function(down) if down then punch(2) end end, "CROSS", Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonY)
	bind("NB_LeadHook", function(down) if down then punch(3) end end, "HOOK", Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
	bind("NB_RearHook", function(down) if down then punch(4) end end, nil, Enum.KeyCode.E, Enum.KeyCode.ButtonA)
	bind("NB_LeadUpper", function(down) if down then punch(5) end end, "UPPER", Enum.KeyCode.Z)
	bind("NB_RearUpper", function(down) if down then punch(6) end end, nil, Enum.KeyCode.X, Enum.KeyCode.ButtonR1)
	bind("NB_Block", function(down)
		held.block = down
		if down then getUpPress() end
	end, "BLOCK", Enum.KeyCode.Space, Enum.KeyCode.ButtonL1)
	bind("NB_Body", function(down, input)
		held.body = down
		if down and input.UserInputType == Enum.UserInputType.Touch then touchBody = not touchBody end
	end, "BODY", Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonL2)
	bind("NB_Power", function(down, input)
		held.power = down
		if down and input.UserInputType == Enum.UserInputType.Touch then touchPower = not touchPower end
	end, "POWER", Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR2)
	bind("NB_Duck", function(down) held.duck = down end, "DUCK", Enum.KeyCode.C)
	bind("NB_Clinch", function(down) if down and fighting() then send({ k = "clinch" }) end end, nil, Enum.KeyCode.F)
	bind("NB_Taunt", function(down) if down and fighting() then send({ k = "taunt" }) end end, nil, Enum.KeyCode.V)
	bind("NB_Cam", function(down) if down then CameraController.broadcast = not CameraController.broadcast end end, nil, Enum.KeyCode.B, Enum.KeyCode.ButtonSelect)

	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then padLean = Vector2.new(input.Position.X, input.Position.Y) end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local c = myChar()
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		local fight = fighting()
		if hum then
			pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, not fight) end)
		end
		-- get-up minigame marker
		local g = Controls.getUp
		g.active = fight and c:GetAttribute("State") == "Down" and phase() == "Knockdown"
		if g.active then
			local ring = c.Ring.Value
			g.zone = ring:GetAttribute("GetUpZone") or 0.25
			g.marker += g.dir * dt * (1.1 + (c:GetAttribute("KD") or 0) * 0.25)
			if g.marker > 1 then g.marker, g.dir = 1, -1 elseif g.marker < 0 then g.marker, g.dir = 0, 1 end
			g.meter = ring:GetAttribute("GetUp") or 0
		end
		if not fight then
			Animator.LocalLean, Animator.LocalGuard = nil, nil
			if lastGuard ~= -1 then lastGuard = -1 end
			touchBody, touchPower = false, false
			return
		end
		-- face the opponent (we own our character's physics)
		local hrp = c:FindFirstChild("HumanoidRootPart")
		local opp = c:FindFirstChild("Opponent") and c.Opponent.Value
		local face = hrp and hrp:FindFirstChild("Facing")
		local st = c:GetAttribute("State")
		if face and opp and opp:FindFirstChild("HumanoidRootPart") and hrp then
			local look = Util.flatUnit(opp.HumanoidRootPart.Position - hrp.Position, hrp.CFrame.LookVector)
			if st == "Corner" or st == "Intro" then
				local ring = c.Ring.Value
				local canvas = ring and ring:FindFirstChild("Canvas")
				if canvas then look = Util.flatUnit(canvas.Position - hrp.Position, look) end
			end
			face.CFrame = CFrame.lookAt(Vector3.zero, look)
		end
		-- mouse lean (Undisputed-style right stick)
		local menus = phase() == "Corner" or phase() == "Result" or phase() == "KO"
		if not menus and not Controls.uiOpen then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
		local md = (not menus) and UserInputService:GetMouseDelta() or Vector2.zero
		leanAcc += Vector3.new(md.X * 0.012, 0, 0)
		if md.Y > 0 then leanAcc += Vector3.new(0, -md.Y * 0.013, 0) else leanAcc += Vector3.new(0, 0, md.Y * 0.013) end
		leanAcc = Util.moveTowardsV(leanAcc, Vector3.zero, dt * 2.6)
		leanAcc = Vector3.new(math.clamp(leanAcc.X, -1, 1), math.clamp(leanAcc.Y, -1, 0), math.clamp(leanAcc.Z, -1, 0.5))
		local lean = leanAcc
		if padLean.Magnitude > 0.2 then
			lean = Vector3.new(padLean.X, padLean.Y < 0 and padLean.Y or 0, padLean.Y > 0 and -padLean.Y or 0)
		end
		if held.duck then lean = Vector3.new(lean.X, -1, lean.Z) end
		if st ~= "Fight" then lean = Vector3.zero end
		Animator.LocalLean = lean
		local guard = (held.block and ((held.body or touchBody) and 2 or 1)) or 0
		Animator.LocalGuard = guard
		if guard ~= lastGuard then
			lastGuard = guard
			send({ k = "guard", g = guard })
		end
		local t = os.clock()
		if t - lastLeanSend > 1 / 15 and (lean - sentLean).Magnitude > 0.02 then
			lastLeanSend = t
			sentLean = lean
			LeanEv:FireServer(lean.X, lean.Y, lean.Z)
		end
	end)
end

function Controls.SendCorner(i) send({ k = "corner", i = i }) end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="776">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[--[[
	Procedural animation for every NEON BAY rig, done on each client through Motor6D.Transform.
	It runs its own forward kinematics so IK can place gloves on the opponent's chin and feet on the canvas
	in the same frame. Poses: lobby walk, boxing stance with planted-feet footwork, six punch paths,
	guard / slip / duck / pull-back, clinch, corner, celebrate, dejected, falls and get-ups.
	On top: sprung hit reactions, a living face (eyes, blinks, swelling lids, brows, jaw) and hair sway.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local RigDef = require(Shared.RigDef)
local PunchData = require(Shared.PunchData)
local Util = require(Shared.Util)

local Animator = {}
local rigs = {} -- model -> state
Animator.Rigs = rigs

local rad = math.rad
local A = CFrame.Angles
local V3 = Vector3.new
local UP = Vector3.yAxis
local camera = workspace.CurrentCamera

local function now() return workspace:GetServerTimeNow() end

-- ================================================================== rig registry
local function scan(st)
	local m = st.model
	st.motors, st.c0 = {}, {}
	for _, def in RigDef.Bones do
		local bone = m:FindFirstChild(def.name)
		local mo = bone and bone:FindFirstChild(def.motor)
		if mo and mo:IsA("Motor6D") then
			st.motors[def.motor] = mo
			st.c0[def.motor] = mo.C0
		end
	end
	st.face, st.strands, st.skinParts, st.injParts = {}, {}, {}, {}
	local cos = m:FindFirstChild("Cosmetics")
	if cos then
		for _, d in cos:GetDescendants() do
			if d:IsA("Motor6D") then
				local p1 = d.Part1
				if p1 and p1:GetAttribute("Role") == "Strand" then
					table.insert(st.strands, { motor = d, ax = 0, az = 0, vx = 0, vz = 0 })
				else
					st.face[d.Name] = d
				end
			elseif d:IsA("BasePart") then
				if d:GetAttribute("Skin") then table.insert(st.skinParts, d) end
				local tag = d:GetAttribute("Inj")
				if tag then
					local mesh = d:FindFirstChildOfClass("SpecialMesh")
					table.insert(st.injParts, { part = d, tag = tag, mesh = mesh, base = d.Color, shown = -1 })
				end
			end
		end
	end
	st.scanned = true
end

local function add(model)
	if rigs[model] then return end
	local st = {
		model = model, phase = math.random() * 6, idleT = math.random() * 10,
		headSnap = Vector3.zero, headV = Vector3.zero, chestSnap = Vector3.zero, chestV = Vector3.zero,
		feetInit = false, footL = Vector3.zero, footR = Vector3.zero, stepL = -1, stepR = -1,
		fromL = Vector3.zero, fromR = Vector3.zero, toL = Vector3.zero, toR = Vector3.zero,
		lean = Vector3.zero, guardHi = 0, guardLo = 0, bounce = 0, blinkT = -1, nextBlink = 1 + math.random() * 3,
		jaw = 0, jawV = 0, squint = 0, squintHold = 0, browUp = 0, pain = 0, saccade = Vector2.zero, saccadeT = 0,
		eye = Vector2.zero, lastHeadPos = nil, sweat = 0,
	}
	rigs[model] = st
	scan(st)
	model.ChildAdded:Connect(function(c) if c.Name == "Cosmetics" then task.defer(scan, st) end end)
end

local function remove(model) rigs[model] = nil end

function Animator.Get(model) return rigs[model] end

-- ================================================================== reactions (called from impact events)
function Animator.React(model, dirWorld: Vector3, power, headHit, bodyHit)
	local st = rigs[model]
	if not st then return end
	local head = model:FindFirstChild("Head")
	local cf = head and head.CFrame or model:GetPivot()
	local d = cf:VectorToObjectSpace(dirWorld.Magnitude > 0 and dirWorld.Unit or V3(0, 0, 1))
	power = math.clamp(power, 0, 2)
	if headHit then
		st.headV += V3((d.Z * 0.75 + d.Y) * 420, -d.X * 520, -d.X * 200) * power
		st.chestV += V3(30, -d.X * 60, 0) * power
		st.jawV += 9 * power + 2
		st.blinkT = 0
		st.squint = 1
		st.squintHold = 0.25 + 0.35 * power
		st.browUp = math.max(st.browUp, 0.6 * power)
		st.saccade += Vector2.new(-d.X, d.Y) * 18 * power
	end
	if bodyHit then
		st.chestV += V3(-260, -d.X * 160, d.X * 120) * power
		st.headV += V3(-120, 0, 0) * power
		st.jawV += 4 * power
		st.squint = math.max(st.squint, 0.6 + 0.4 * power)
		st.squintHold = 0.5 + power * 0.6
	end
	st.pain = math.max(st.pain, 0.5 * power)
end

-- local punch prediction for the local player's fighter
function Animator.Predict(model, id, body, power, scale)
	local st = rigs[model]
	if not st then return end
	st.predict = { id = id, body = body, power = power, t0 = now(), scale = scale or 1, actId = model:GetAttribute("ActId") or 0 }
end

-- ================================================================== helpers
local function spring(x: Vector3, v: Vector3, k, c, dt, limit)
	v += (-x * k - v * c) * dt
	x += v * dt
	if x.Magnitude > limit then x = x.Unit * limit end
	return x, v
end

local function deg(x, y, z) return A(rad(x), rad(y), rad(z)) end

local function lerpPose(a, b, t)
	local o = {}
	for k, v in b do
		local av = a[k]
		o[k] = av and av:Lerp(v, t) or v
	end
	for k, v in a do if not o[k] then o[k] = v end end
	return o
end

-- current punch (server attributes, or the local prediction)
local function currentPunch(st)
	local m = st.model
	local id = m:GetAttribute("Act") or 0
	local pr = st.predict
	if pr then
		local serverAct = m:GetAttribute("ActId") or 0
		if serverAct ~= pr.actId or now() - pr.t0 > 0.6 then
			st.predict = nil
		else
			return PunchData.Get(pr.id), pr.body, pr.power, now() - pr.t0, pr.scale, false
		end
	end
	if id == 0 then return nil end
	local t0 = m:GetAttribute("ActT0") or now()
	return PunchData.Get(id), m:GetAttribute("ActBody") == true, m:GetAttribute("ActPow") == true, now() - t0, m:GetAttribute("ActScale") or 1, m:GetAttribute("ActWhiff") == true
end

-- ================================================================== poses (local Motor6D transforms)
local function walkPose(st, dt, speedStuds, k)
	local speed = speedStuds / k -- m/s
	local amp = math.clamp(speed / 4.5, 0, 1)
	local run = math.clamp((speed - 3.6) / 3, 0, 1)
	local stride = Util.lerp(1.35, 2.5, run)
	st.phase += dt * (math.pi * 2 * speed / stride)
	st.idleT += dt
	local s, c = math.sin(st.phase), math.cos(st.phase)
	local Aw = (26 + run * 16) * amp
	local K = (38 + run * 50) * amp
	local thL, thR = s * Aw, -s * Aw
	local knL = -(math.max(0, c) * K + 4 + amp * 6)
	local knR = -(math.max(0, -c) * K + 4 + amp * 6)
	local sway = math.sin(st.idleT * 0.7) * (1 - amp)
	local bob = math.abs(c) * (0.02 + run * 0.03) * amp - 0.02 * amp
	local breathe = math.sin(st.idleT * (1.3 + run * 1.5))
	local armA = (24 + run * 26) * amp
	local elb = 14 + 18 * amp + 62 * run
	return {
		Root = CFrame.new((s * 0.018 * amp + sway * 0.012) * k, bob * k, 0) * deg(-3 * run, -s * 7 * amp, sway * 2),
		Waist = deg(-(3 * amp + 9 * run), s * 5 * amp, -sway * 1.5),
		Chest = deg(-(breathe * 1.2 + 3 * run), s * 7 * amp, 0),
		NeckJoint = deg(4 * amp + 8 * run, -s * 3 * amp, 0),
		Neck = deg((3 * amp + 9 * run) * 0.5 + breathe * 0.8, 0, 0),
		LeftHip = deg(thL, 0, -2), RightHip = deg(thR, 0, 2),
		LeftKnee = deg(knL, 0, 0), RightKnee = deg(knR, 0, 0),
		LeftAnkle = deg(-(thL + knL) * 0.6 + math.max(0, -s) * 18 * amp, 0, 0),
		RightAnkle = deg(-(thR + knR) * 0.6 + math.max(0, s) * 18 * amp, 0, 0),
		LeftShoulder = deg(-s * armA, 0, -(5 + run * 4)), RightShoulder = deg(s * armA, 0, 5 + run * 4),
		LeftElbow = deg(elb + math.max(0, s) * 18 * amp, 0, 0), RightElbow = deg(elb + math.max(0, -s) * 18 * amp, 0, 0),
		LeftWrist = CFrame.identity, RightWrist = CFrame.identity,
	}
end

local function downPose(st, k, u, fallBack, roll)
	-- u: 0 standing .. 1 flat on the canvas
	local buckle = math.clamp(u / 0.4, 0, 1)
	local fall = Util.smooth((u - 0.3) / 0.7)
	local tilt = (fallBack and 86 or -84) * fall
	local hipsDown = Util.lerp(0.22 * buckle, 0.84, fall)
	return {
		Root = CFrame.new(0, -hipsDown * k, (fallBack and 0.3 or -0.3) * fall * k) * deg(tilt, 0, roll * fall),
		Waist = deg(fallBack and -10 * fall or 8 * fall, 0, roll * 0.3),
		Chest = deg(0, 0, 0),
		NeckJoint = deg(fallBack and 15 * fall or -10 * fall, roll * 0.5, 0),
		Neck = deg(0, roll, roll * 0.4),
		LeftHip = deg(20 * fall + 30 * buckle * (1 - fall), 0, -8 * fall), RightHip = deg(35 * fall + 30 * buckle * (1 - fall), 0, 10 * fall),
		LeftKnee = deg(-60 * buckle * (1 - fall) - 25 * fall, 0, 0), RightKnee = deg(-60 * buckle * (1 - fall) - 50 * fall, 0, 0),
		LeftAnkle = deg(10 * fall, 0, 0), RightAnkle = deg(10 * fall, 0, 0),
		LeftShoulder = deg(20 * fall, 0, -(25 + 50 * fall)), RightShoulder = deg(10 * fall, 0, 25 + 60 * fall),
		LeftElbow = deg(30, 0, 0), RightElbow = deg(45 * fall + 20, 0, 0),
		LeftWrist = CFrame.identity, RightWrist = CFrame.identity,
	}
end

-- ================================================================== the boxing pose (FK + IK)
local function stepFoot(st, left, desired, dt, k, ground)
	local f = left and st.footL or st.footR
	local stepT = left and st.stepL or st.stepR
	local other = left and st.stepR or st.stepL
	if stepT >= 0 then
		stepT += dt / 0.13
		local u = math.clamp(stepT, 0, 1)
		local from = left and st.fromL or st.fromR
		local to = left and st.toL or st.toR
		f = from:Lerp(to, Util.smooth(u)) + V3(0, math.sin(u * math.pi) * 0.045 * k, 0)
		if stepT >= 1 then stepT = -1; f = to end
	elseif not (other >= 0 and other < 0.6) and Util.flat(f - desired).Magnitude > 0.1 * k then
		stepT = 0
		if left then st.fromL, st.toL = f, desired else st.fromR, st.toR = f, desired end
	else
		f = V3(f.X, ground, f.Z)
	end
	if left then st.footL, st.stepL = f, stepT else st.footR, st.stepR = f, stepT end
end

local function fightPose(st, dt, ctx)
	local m = st.model
	local k = ctx.k
	local hrpCF = ctx.hrpCF
	local fwd, right = hrpCF.LookVector, hrpCF.RightVector
	local southpaw = m:GetAttribute("Southpaw") == true
	local lead = southpaw and 1 or -1
	local stanceYaw = southpaw and 28 or -28
	local state = ctx.state
	local L = st.lean
	local duck, back, fwdLean = -math.min(0, L.Y), -math.min(0, L.Z), math.max(0, L.Z)
	local stam = m:GetAttribute("Stam") or 100
	local tired = stam < 30
	local rocked = (m:GetAttribute("Rocked") or 0) > 0
	local fatigue = m:GetAttribute("Fatigue") or 0
	st.clock = (st.clock or 0) + dt

	-- punch progress
	local def, body, power, t, scale, whiff = currentPunch(st)
	local twist, dip, ext = 0, 0, 0
	local w, e, r
	if def and state ~= "Clinch" then
		w, e, r = PunchData.Timing(def, power, body, scale, whiff)
		local wind = t < w and t / w or 0
		ext = t < w and 0 or (t < w + e and Util.easeOut((t - w) / e) or 1 - Util.smooth((t - w - e) / r))
		if t > w + e + r then def = nil; ext = 0 else
			local tw = def.twist * ext - def.twist * 0.25 * wind
			twist = -tw * (def.lead and 1 or -1) * (southpaw and -1 or 1)
			if body then dip = 0.6 * math.max(ext, wind) end
			if def.kind == "upper" then dip = math.max(dip, 0.4 * wind * (1 - ext) + 0.15 * ext) end
		end
	end

	-- body
	local moving = (ctx.vel.Magnitude / k) > 0.3
	local bounceAmp = ((state == "Intro" or moving) and 1 or 0.6) * (tired and 0.3 or 1) * (rocked and 0 or 1)
	st.bounce += dt * math.pi * 2 * (tired and 1.3 or 1.9)
	local bob = math.abs(math.sin(st.bounce)) * 0.016 * bounceAmp
	local wob = rocked and math.sin(st.clock * 2.3) * 6 or 0
	local hipDrop = 0.075 + duck * 0.2 + dip * 0.1 + (rocked and 0.04 or 0)
	local T = {}
	T.Root = CFrame.new(L.X * 0.11 * k, (-hipDrop + bob) * k, (0.02 + back * 0.06 - fwdLean * 0.04) * k)
		* deg(-(4 + duck * 10), stanceYaw * 0.8 + twist * 0.4, -L.X * 5 - wob * 0.5)
	T.Waist = deg(-(7 + duck * 24 + dip * 14 - back * 16 + fwdLean * 8), twist * 0.25 - stanceYaw * 0.15, -L.X * 13 - wob)
	T.Chest = deg(-(4 + duck * 8 - back * 7 + (tired and 6 or 0)) + st.chestSnap.X, twist * 0.35 - stanceYaw * 0.3 + st.chestSnap.Y, -L.X * 9 + st.chestSnap.Z)
	T.NeckJoint = deg(-(12 - duck * 6), 0, 0)
	T.Neck = deg(9 + duck * 10, 0, 0)
	if (m:GetAttribute("TauntT") or -9) > now() - 1.2 then
		T.Neck = deg(12, math.sin(st.clock * 14) * 15, 0)
		T.Chest = T.Chest * deg(8, 0, 0)
	end

	-- forward kinematics of the spine
	local c0 = st.c0
	local LT = hrpCF * c0.Root * T.Root
	local SP = LT * c0.Waist * T.Waist
	local UT = SP * c0.Chest * T.Chest

	-- feet: planted, stepping when the body moves away from them
	local ground = hrpCF.Position.Y - RigDef.HipHeightM * k
	local function off(isLead)
		return isLead and V3(lead * 0.05 * k, 0, -0.25 * k) or V3(-lead * 0.16 * k, 0, 0.19 * k)
	end
	local predict = ctx.vel * 0.16
	local dLead = hrpCF:PointToWorldSpace(off(true)) + predict
	local dRear = hrpCF:PointToWorldSpace(off(false)) + predict
	dLead = V3(dLead.X, ground, dLead.Z)
	dRear = V3(dRear.X, ground, dRear.Z)
	if not st.feetInit then
		st.footL = lead < 0 and dLead or dRear
		st.footR = lead < 0 and dRear or dLead
		st.feetInit = true
	end
	stepFoot(st, lead < 0, dLead, dt, k, ground)
	stepFoot(st, lead > 0, dRear, dt, k, ground)
	local function leg(isLeft)
		local hipName = isLeft and "LeftHip" or "RightHip"
		local kneeName = isLeft and "LeftKnee" or "RightKnee"
		local ankleName = isLeft and "LeftAnkle" or "RightAnkle"
		local isLead = (isLeft and lead < 0) or (not isLeft and lead > 0)
		local hipFrame = LT * c0[hipName]
		local foot = isLeft and st.footL or st.footR
		local footFwd = (CFrame.Angles(0, rad(stanceYaw * (isLead and 0.55 or 1.4)), 0) * fwd)
		if not isLead and def and not def.lead then footFwd = CFrame.Angles(0, rad(twist * 0.6), 0) * footFwd end
		local kneeDir = (fwd + right * (isLead and lead * -0.2 or -lead * 0.3)).Unit
		local upper, lower, tip = Util.twoBone(hipFrame.Position, foot + UP * 0.062 * k, hipFrame.Position + kneeDir * k, RigDef.UpperLeg * k, RigDef.LowerLeg * k, false, footFwd)
		T[hipName] = Util.relRot(hipFrame, upper)
		T[kneeName] = Util.relRot(upper * c0[kneeName], lower)
		local footCF = Util.flatLook(tip, footFwd)
		if not isLead then footCF = footCF * deg(-14, 0, 0) end
		T[ankleName] = Util.relRot(lower * c0[ankleName], footCF)
	end
	leg(true)
	leg(false)

	-- arms
	local O = UT:PointToWorldSpace(V3(0, 0.2 * k, -0.02 * k))
	local drop = math.clamp(fatigue * 0.7 + (rocked and 0.6 or 0), 0, 1)
	local guard = m:GetAttribute("Guard") or 0
	if ctx.isLocal and ctx.localGuard then guard = ctx.localGuard end
	st.guardHi = Util.moveTowards(st.guardHi, guard == 1 and 1 or 0, dt * 12)
	st.guardLo = Util.moveTowards(st.guardLo, guard == 2 and 1 or 0, dt * 12)
	local opp = ctx.opponent
	local function guardPos(isLead)
		local sx = isLead and lead or -lead
		local normal = isLead and (O + fwd * 0.25 * k + right * sx * 0.07 * k + UP * 0.1 * k) or (O + fwd * 0.13 * k + right * sx * 0.1 * k + UP * 0.13 * k)
		local high = O + fwd * (isLead and 0.15 or 0.12) * k + right * sx * 0.065 * k + UP * 0.2 * k
		local low = O + fwd * (isLead and 0.17 or 0.14) * k + right * sx * 0.09 * k + UP * (isLead and -0.1 or -0.15) * k
		local p = normal:Lerp(high, st.guardHi):Lerp(low, st.guardLo)
		p += UP * (-0.15 * drop * k) + fwd * (0.04 * drop * k)
		if state == "Intro" then p += (right * math.sin(st.clock * 3 + (isLead and 0 or 2)) * 0.03 + UP * math.sin(st.clock * 4.3 + sx) * 0.02) * k end
		return p
	end
	local function contactPoint()
		if opp then
			local oh = opp:FindFirstChild("Head")
			local ot = opp:FindFirstChild("UpperTorso")
			if body and ot then
				local leftHand = (def.lead and not southpaw) or (not def.lead and southpaw)
				local side = def.kind == "hook" and (leftHand and 1 or -1) or 0
				return ot.CFrame:PointToWorldSpace(V3(0.08 * side * k, 0.02 * k, -0.13 * k))
			elseif oh then
				return def.kind == "upper" and oh.CFrame:PointToWorldSpace(V3(0, 0.04 * k, -0.09 * k)) or oh.CFrame:PointToWorldSpace(V3(0, 0.12 * k, -0.1 * k))
			end
		end
		return O + fwd * 0.7 * k + UP * (body and -0.25 or 0.02) * k
	end
	for _, isLead in { true, false } do
		local rightArm = (isLead and lead > 0) or (not isLead and lead < 0)
		local sx = rightArm and 1 or -1
		local shName = rightArm and "RightShoulder" or "LeftShoulder"
		local elName = rightArm and "RightElbow" or "LeftElbow"
		local wrName = rightArm and "RightWrist" or "LeftWrist"
		local shFrame = UT * c0[shName]
		local sh = shFrame.Position
		local g = guardPos(isLead)
		local elbowHint = sh - UP * 0.35 * k + right * sx * 0.12 * k + fwd * 0.05 * k
		local backHand = (right * sx * 0.75 + fwd * 0.25 + UP * 0.2).Unit
		local target = g
		if def and def.lead == isLead and state ~= "Clinch" then
			local contact = contactPoint()
			local dirP = (contact - sh).Unit
			local wristAt = contact - dirP * 0.13 * k
			local maxR = 0.545 * k
			if (wristAt - sh).Magnitude > maxR then wristAt = sh + (wristAt - sh).Unit * maxR end
			local start, ctrl = g, nil
			if def.kind == "hook" then
				start = g + right * sx * 0.04 * k
				ctrl = g + right * sx * 0.34 * k + fwd * 0.12 * k + UP * (body and -0.1 or 0.02) * k
				elbowHint = sh + right * sx * 0.4 * k + UP * 0.2 * k
				backHand = backHand:Lerp(UP, ext).Unit
			elseif def.kind == "upper" then
				start = g - UP * 0.06 * k
				ctrl = g - UP * 0.22 * k + fwd * 0.1 * k - right * sx * 0.03 * k
				elbowHint = sh - UP * 0.4 * k + fwd * 0.1 * k
				backHand = backHand:Lerp(fwd, ext).Unit
			else
				ctrl = g:Lerp(wristAt, 0.5) + UP * 0.03 * k
				backHand = backHand:Lerp(UP, ext * 0.85).Unit
			end
			if t < w then target = g:Lerp(start - fwd * 0.035 * k, Util.smooth(t / w))
			elseif t < w + e then target = Util.bezier(start, ctrl, wristAt, Util.easeOut((t - w) / e))
			else target = wristAt:Lerp(g, Util.smooth((t - w - e) / r)) end
		elseif state == "Clinch" and opp and opp:FindFirstChild("UpperTorso") then
			target = opp.UpperTorso.CFrame:PointToWorldSpace(V3(0.2 * sx * k, 0.18 * k, 0.08 * k))
			elbowHint = sh + right * sx * 0.3 * k - UP * 0.1 * k
		elseif state == "Celebrate" then
			target = O + UP * 0.62 * k + right * sx * (0.24 + 0.04 * math.sin(st.clock * 6)) * k + fwd * 0.05 * k
			elbowHint = sh + right * sx * 0.4 * k
		elseif state == "Dejected" or (m:GetAttribute("TauntT") or -9) > now() - 1.2 then
			target = sh - UP * 0.5 * k + fwd * 0.08 * k + right * sx * 0.04 * k
		elseif state == "Corner" then
			target = O + right * sx * 0.58 * k + fwd * 0.2 * k + UP * 0.02 * k
			elbowHint = sh - UP * 0.3 * k
		end
		local upper, lower = Util.twoBone(sh, target, elbowHint, RigDef.UpperArm * k, RigDef.LowerArm * k, true, backHand)
		T[shName] = Util.relRot(shFrame, upper)
		T[elName] = Util.relRot(upper * c0[elName], lower)
		T[wrName] = CFrame.identity
	end
	if state == "Celebrate" then T.Root = CFrame.new(0, math.abs(math.sin(st.clock * 5)) * 0.08 * k, 0) * T.Root end
	return T
end

-- ================================================================== face
local function faceTick(st, dt, ctx)
	local f = st.face
	if not f.EyeL and not f.Jaw then return end
	local m = st.model
	local k = ctx.k
	local state = ctx.state
	local ko = state == "KO" or m:GetAttribute("Ragdolled") == true
	local down = state == "Down"
	local rocked = (m:GetAttribute("Rocked") or 0) > 0
	local fatigue = m:GetAttribute("Fatigue") or 0
	local daze = (rocked or down) and 0.8 or 0
	st.pain = Util.moveTowards(st.pain, 0, dt * 0.35)
	st.squintHold -= dt
	if st.squintHold <= 0 then st.squint = Util.moveTowards(st.squint, 0, dt * 2) end
	st.browUp = Util.moveTowards(st.browUp, 0, dt * 1.6)
	-- blink
	st.nextBlink -= dt
	if not ko and st.nextBlink <= 0 and st.blinkT < 0 then
		st.blinkT = 0
		st.nextBlink = (1.8 + math.random() * 3.7) * (daze > 0.3 and 0.5 or 1)
	end
	local blink = 0
	if st.blinkT >= 0 then
		st.blinkT += dt / 0.16
		blink = math.sin(math.clamp(st.blinkT, 0, 1) * math.pi)
		if st.blinkT >= 1 then st.blinkT = -1 end
	end
	-- jaw spring
	local tt = os.clock()
	local jawTarget = fatigue * (0.25 + 0.25 * (math.sin(tt * (2.5 + fatigue * 2)) * 0.5 + 0.5))
	if ko then jawTarget = 0.85 elseif daze > 0.2 then jawTarget = math.max(jawTarget, 0.3 * daze) end
	if (m:GetAttribute("SignalT") or -9) > now() - 0.8 then jawTarget = 0.35 + 0.25 * math.sin(tt * 13) end
	st.jawV += ((jawTarget - st.jaw) * 140 - st.jawV * 13) * dt
	st.jaw = math.clamp(st.jaw + st.jawV * dt, -0.05, 1.15)
	-- eyes
	st.saccadeT -= dt
	if st.saccadeT <= 0 then
		st.saccadeT = 0.4 + math.random() * 1.8
		st.saccadeTarget = Vector2.new(math.random() - 0.5, math.random() - 0.5) * (daze > 0.3 and 28 or 8)
	end
	st.saccade = st.saccade:Lerp(st.saccadeTarget or Vector2.zero, 1 - math.exp(-(daze > 0.3 and 3 or 25) * dt))
	local aim = Vector2.zero
	local head = m:FindFirstChild("Head")
	if ctx.lookAt and head then
		local l = head.CFrame:PointToObjectSpace(ctx.lookAt)
		aim = Vector2.new(math.clamp(math.deg(math.atan2(-l.X, -l.Z)), -32, 32), math.clamp(math.deg(math.atan2(l.Y - 0.158 * k, math.sqrt(l.X * l.X + l.Z * l.Z))), -25, 25))
	end
	st.eye = st.eye:Lerp(aim, 1 - math.exp(-18 * dt))
	local e = st.eye + st.saccade
	local roll = ko and 28 or daze * 6
	if f.EyeL then f.EyeL.Transform = deg(e.Y + roll, e.X - (daze > 0.4 and 5 or 0), 0) end
	if f.EyeR then f.EyeR.Transform = deg(e.Y + roll, e.X + (daze > 0.4 and 4 or 0), 0) end
	-- lids: swelling closes them
	local closeBase = ko and 0.62 or math.clamp(fatigue * 0.25 + daze * 0.35 + st.squint * 0.45, 0, 1)
	local function closure(side)
		local sw = m:GetAttribute("I_Eye" .. side) or 0
		local swell = math.clamp((sw - 0.35) * 1.4, 0, 1)
		return math.max(closeBase, blink, swell)
	end
	if f.LidL then f.LidL.Transform = CFrame.new(0, -0.021 * k * closure("L"), 0) end
	if f.LidR then f.LidR.Transform = CFrame.new(0, -0.021 * k * closure("R"), 0) end
	local up = (st.browUp * 0.006 - st.pain * 0.002 + daze * 0.002) * k
	if f.BrowL then f.BrowL.Transform = CFrame.new(0, up, 0) * deg(0, 0, -st.pain * 9) end
	if f.BrowR then f.BrowR.Transform = CFrame.new(0, up, 0) * deg(0, 0, st.pain * 9) end
end

local function jawTransform(st)
	return deg(-st.jaw * 21, 0, 0)
end

-- ================================================================== injuries, sweat, hair
local BRUISE = Color3.fromRGB(82, 26, 52)
local function injuryTick(st)
	local m = st.model
	for _, ip in st.injParts do
		local tag = ip.tag
		local v
		if tag == "CutBrowL" or tag == "CutCheekL" then v = m:GetAttribute("I_CutL") or 0
		elseif tag == "CutBrowR" or tag == "CutCheekR" then v = m:GetAttribute("I_CutR") or 0
		elseif tag == "StreakL" then v = math.max(0, (m:GetAttribute("I_CutL") or 0) - 0.25) * 1.5
		elseif tag == "StreakR" then v = math.max(0, (m:GetAttribute("I_CutR") or 0) - 0.25) * 1.5
		elseif tag == "NoseBlood" then v = math.max(0, (m:GetAttribute("I_Nose") or 0) - 0.45) * 2
		else v = m:GetAttribute("I_" .. tag) or 0 end
		local q = math.floor(v * 20) / 20
		if q ~= ip.shown then
			ip.shown = q
			local part = ip.part
			if q < 0.05 then
				part.LocalTransparencyModifier = 1
				part.Transparency = 1
			else
				part.Transparency = 0
				part.LocalTransparencyModifier = 0
				if string.find(tag, "Cut") or string.find(tag, "Streak") or tag == "NoseBlood" then
					if ip.mesh then ip.mesh.Scale = V3(math.min(1, 0.4 + q), math.min(1.2, 0.3 + q), 1) end
				else
					local s = 0.35 + q * 0.95
					if ip.mesh then ip.mesh.Scale = V3(s, s, 0.4 + q * 1.2) end
					part.Color = ip.base:Lerp(BRUISE, math.clamp(q * 0.7, 0, 0.75))
				end
			end
		end
	end
end

local function sweatTick(st, dt)
	local m = st.model
	local target = m:GetAttribute("Fighter") and math.clamp((m:GetAttribute("Fatigue") or 0) * 0.5 + 0.08, 0, 0.35) or 0
	local before = st.sweat
	st.sweat = Util.moveTowards(st.sweat, target, dt * 0.05)
	if math.abs(before - st.sweat) > 0 and math.floor(before * 50) ~= math.floor(st.sweat * 50) then
		for _, p in st.skinParts do
			if p.Material ~= Enum.Material.Metal then p.Reflectance = st.sweat end
		end
	end
end

local function hairTick(st, dt, headCF)
	if #st.strands == 0 then return end
	local prev = st.lastHeadPos
	local vel = prev and (headCF.Position - prev) / math.max(dt, 1 / 240) or Vector3.zero
	st.lastHeadPos = headCF.Position
	local lv = headCF:VectorToObjectSpace(vel)
	local g = headCF:VectorToObjectSpace(V3(0, -1, 0))
	for _, sd in st.strands do
		-- target angles: hang with gravity, trail behind motion
		local tx = math.clamp(-g.Z * 50 + lv.Z * 6, -60, 60)
		local tz = math.clamp(g.X * 50 - lv.X * 6, -60, 60)
		sd.vx += ((tx - sd.ax) * 60 - sd.vx * 7) * dt
		sd.vz += ((tz - sd.az) * 60 - sd.vz * 7) * dt
		sd.ax += sd.vx * dt
		sd.az += sd.vz * dt
		sd.motor.Transform = deg(sd.ax, 0, sd.az)
	end
end

-- ================================================================== main loop
local localPlayer = Players.LocalPlayer
Animator.LocalGuard = nil
Animator.LocalLean = nil

local function tickRig(st, dt)
	local m = st.model
	local hrp = m:FindFirstChild("HumanoidRootPart")
	if not hrp or not m.Parent then return end
	if not st.scanned or not st.motors.Root then scan(st) end
	if not st.motors.Root then return end
	local k = m:GetAttribute("Scale") or 3.2
	local state = m:GetAttribute("State") or "Idle"
	local camPos = camera.CFrame.Position
	local dist = (hrp.Position - camPos).Magnitude
	-- far rigs update at a lower rate
	st.skip = ((st.skip or 0) + 1) % (dist > 140 and 4 or dist > 70 and 2 or 1)
	if st.skip ~= 0 then return end
	local isLocal = localPlayer and localPlayer.Character == m
	local oppVal = m:FindFirstChild("Opponent")
	local opp = oppVal and oppVal.Value
	local ragdolled = m:GetAttribute("Ragdolled") == true
	local ctx = { k = k, hrpCF = hrp.CFrame, vel = Util.flat(hrp.AssemblyLinearVelocity), state = state, opponent = opp, isLocal = isLocal }

	-- lean: local player sees their own input instantly
	local lean = V3(m:GetAttribute("LeanX") or 0, m:GetAttribute("LeanY") or 0, m:GetAttribute("LeanZ") or 0)
	if isLocal and Animator.LocalLean and m:GetAttribute("Fighter") then lean = Animator.LocalLean end
	if isLocal then ctx.localGuard = Animator.LocalGuard end
	st.lean = st.lean:Lerp(lean, 1 - math.exp(-14 * dt))

	-- springs
	st.headSnap, st.headV = spring(st.headSnap, st.headV, 180, 13, dt, 55)
	st.chestSnap, st.chestV = spring(st.chestSnap, st.chestV, 95, 11, dt, 35)

	local T
	if ragdolled then
		T = nil
	elseif state == "Down" or state == "KO" then
		local t0 = m:GetAttribute("DownT0") or now()
		local dir = m:GetAttribute("DownDir") or -hrp.CFrame.LookVector
		local fallBack = dir:Dot(hrp.CFrame.LookVector) < 0.3
		local roll = math.clamp(dir:Dot(hrp.CFrame.RightVector) * 40, -35, 35)
		T = downPose(st, k, math.clamp((now() - t0) / 0.75, 0, 1), fallBack, roll)
		st.downPose = T
		st.feetInit = false
	elseif state == "GetUp" then
		local t0 = m:GetAttribute("GetUpT0") or now()
		local u = math.clamp((now() - t0) / 1.5, 0, 1)
		local stand = fightPose(st, dt, ctx)
		T = lerpPose(st.downPose or downPose(st, k, 1, true, 0), stand, Util.smooth(u))
	elseif m:GetAttribute("Fighter") and state ~= "Idle" then
		T = fightPose(st, dt, ctx)
	else
		local def = currentPunch(st)
		if def then
			ctx.state = "Fight"
			T = fightPose(st, dt, ctx)
		else
			T = walkPose(st, dt, ctx.vel.Magnitude, k)
			st.feetInit = false
			-- referee signal arm
			local sigT = m:GetAttribute("SignalT")
			if sigT and now() - sigT < 0.9 then
				local kk = math.sin(math.clamp((now() - sigT) / 0.9, 0, 1) * math.pi)
				T.RightShoulder = deg(100 + 50 * kk, 0, 20)
				T.RightElbow = deg(30 - 20 * kk, 0, 0)
			end
		end
	end
	if T then
		-- sprung reactions on top of the pose
		local hs = st.headSnap
		T.NeckJoint = (T.NeckJoint or CFrame.identity) * deg(hs.X * 0.35, hs.Y * 0.35, hs.Z * 0.35)
		T.Neck = (T.Neck or CFrame.identity) * deg(hs.X * 0.65, hs.Y * 0.65, hs.Z * 0.65)
		-- head tracks the opponent / the camera
		local look = opp and opp:FindFirstChild("Head") and opp.Head.Position or (dist < 25 and camPos or nil)
		ctx.lookAt = look
		for name, mo in st.motors do
			local tr = T[name]
			if tr then mo.Transform = tr end
		end
	else
		ctx.lookAt = nil
	end
	if st.face.Jaw == nil and st.motors.Jaw then st.face.Jaw = st.motors.Jaw end
	if st.motors.Jaw then st.motors.Jaw.Transform = jawTransform(st) end
	if dist < 70 then
		if ctx.lookAt == nil and opp and opp:FindFirstChild("Head") then ctx.lookAt = opp.Head.Position end
		faceTick(st, dt, ctx)
		injuryTick(st)
		sweatTick(st, dt)
		local head = m:FindFirstChild("Head")
		if head then hairTick(st, dt, head.CFrame) end
	end
end

function Animator.Start()
	for _, m in CollectionService:GetTagged("NBRig") do add(m) end
	CollectionService:GetInstanceAddedSignal("NBRig"):Connect(add)
	CollectionService:GetInstanceRemovedSignal("NBRig"):Connect(remove)
	RunService:BindToRenderStep("NeonBayAnimate", Enum.RenderPriority.Character.Value + 1, function(dt)
		camera = workspace.CurrentCamera
		for m, st in rigs do
			if m.Parent == nil then
				rigs[m] = nil
			else
				local ok, err = pcall(tickRig, st, dt)
				if not ok and not st.warned then
					st.warned = true
					warn("[NeonBay] animator:", err)
				end
			end
		end
	end)
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="777">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[--[[
	Lobby UI: record/cash bar, FIGHTER creator with a live 3D preview, CAREER ladder vs the Pit's ranked CPU
	fighters, TRAINING camp and MEDICAL. The creator opens automatically the first time you join.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("NeonBay")
local Config = require(Shared.Config)
local RigDef = require(Shared.RigDef)
local Appearance = require(Shared.Appearance)
local Util = require(Shared.Util)
local Remotes = ReplicatedStorage:WaitForChild("NeonBayRemotes")
local RequestFn = Remotes:WaitForChild("Request")

local HUD = require(script.Parent.HUD)
local FX = require(script.Parent.FX)

local Menus = {}
local player = Players.LocalPlayer
local make, frame, label, button, stroke, corner = HUD.Make, HUD.Frame, HUD.Label, HUD.Button, HUD.Stroke, HUD.Corner
local CYAN, YELLOW, RED = Config.Neon.Cyan, Config.Neon.Yellow, Color3.fromRGB(242, 51, 64)
local FONT, FONT2 = Enum.Font.GothamBlack, Enum.Font.GothamBold

local gui, topBar, panelRoot
local draft
local preview, previewBones
local Controls

local function request(kind, arg)
	local ok, a, b = pcall(function() return RequestFn:InvokeServer(kind, arg) end)
	if not ok then return false, "Network error" end
	return a, b
end

local function inFight()
	local c = player.Character
	return c and c:GetAttribute("Fighter") == true
end

-- ------------------------------------------------------------------ live preview rig (local only)
local function destroyPreview()
	if preview then preview:Destroy() preview = nil end
end

local function studioCF()
	local map = workspace:FindFirstChild("Map")
	local spot = map and map:FindFirstChild("CreatorStudio", true)
	if spot then return spot.CFrame * CFrame.new(0, spot.Size.Y / 2, 0) end
	local c = player.Character
	return c and c:GetPivot() * CFrame.new(0, -3, -12) or CFrame.new(0, 0, 0)
end

local function buildPreview()
	destroyPreview()
	local p = Util.deepCopy(draft)
	p.outfit = "boxer"
	local offsets, d = RigDef.Offsets(p)
	local model = Instance.new("Model")
	model.Name = "CreatorPreview"
	local base = studioCF()
	local hrp = Instance.new("Part")
	hrp.Name = "HumanoidRootPart"
	hrp.Size = RigDef.RootSize
	hrp.Transparency = 1
	hrp.Anchored = true
	hrp.CanCollide = false
	hrp.CFrame = CFrame.new(base.Position + Vector3.new(0, RigDef.HipHeightM * d.scale, 0)) * base.Rotation
	hrp.Parent = model
	local bones = { HumanoidRootPart = hrp }
	for _, def in RigDef.Bones do
		local part = Instance.new("Part")
		part.Name = def.name
		part.Size = Vector3.new(0.15, 0.15, 0.15)
		part.Transparency = 1
		part.CanCollide, part.CanQuery, part.CanTouch, part.Massless = false, false, false, true
		part.CFrame = bones[def.parent].CFrame * CFrame.new(offsets[def.name])
		local m = Instance.new("Motor6D")
		m.Name = def.motor
		m.Part0 = bones[def.parent]
		m.Part1 = part
		m.C0 = CFrame.new(offsets[def.name])
		m.Parent = part
		part.Parent = model
		bones[def.name] = part
	end
	Appearance.Apply(model, bones, p)
	model:SetAttribute("Scale", d.scale)
	model:SetAttribute("Southpaw", p.southpaw == true)
	model:SetAttribute("State", "Idle")
	model.Parent = workspace
	CollectionService:AddTag(model, "NBRig")
	preview, previewBones = model, bones
end

local spin = 0
local zoomFace = false
RunService.RenderStepped:Connect(function(dt)
	if not preview then return end
	local cam = workspace.CurrentCamera
	local hrp = previewBones.HumanoidRootPart
	local head = previewBones.Head
	spin += dt * 0.25
	local center = hrp.Position
	local target = zoomFace and head.Position + Vector3.new(0, 0.42, 0) or center + Vector3.new(0, 0.6, 0)
	local dist = zoomFace and 3.4 or 11
	local look = hrp.CFrame.LookVector
	local ang = math.sin(spin) * 0.6
	local dir = (CFrame.Angles(0, ang, 0) * look)
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(target + dir * dist + Vector3.new(0, zoomFace and 0.2 or 1, 0), target), 1 - math.exp(-6 * dt))
	cam.FieldOfView = 40
end)

-- ------------------------------------------------------------------ panels
local function clearPanel()
	if panelRoot then panelRoot:Destroy() panelRoot = nil end
	Controls.uiOpen = false
end

local function openPanel(title, w, h, side)
	clearPanel()
	Controls.uiOpen = true
	local p = frame(gui, UDim2.new(side and 0 or 0.5, side and 18 or 0, 0.5, 0), UDim2.new(0, w, 0, h), Color3.fromRGB(6, 7, 14), 0.06, 20)
	p.AnchorPoint = Vector2.new(side and 0 or 0.5, 0.5)
	corner(p, 10)
	stroke(p, CYAN, 2)
	make("UISizeConstraint", { MaxSize = Vector2.new(w, h), MinSize = Vector2.new(math.min(w, 300), 200) }, p)
	p.Size = UDim2.new(side and 0.46 or 0.92, 0, 0.88, 0)
	label(p, title, UDim2.new(0, 16, 0, 10), UDim2.new(1, -150, 0, 30), CYAN, FONT, Enum.TextXAlignment.Left)
	button(p, "CLOSE", UDim2.new(1, -120, 0, 10), UDim2.new(0, 104, 0, 32), RED, function()
		if title:find("FIGHTER") then
			destroyPreview()
			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		end
		clearPanel()
	end)
	panelRoot = p
	local body = make("ScrollingFrame", { Position = UDim2.new(0, 12, 0, 50), Size = UDim2.new(1, -24, 1, -62), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 21 }, p)
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	return body
end

local order = 0
local function row(parent, h)
	order += 1
	local r = frame(parent, UDim2.new(0, 0, 0, 0), UDim2.new(1, -8, 0, h or 40), Color3.fromRGB(14, 16, 26), 0.2, 21)
	r.LayoutOrder = order
	corner(r, 6)
	return r
end

local function picker(parent, title, get, set, count, nameOf, rebuild)
	local r = row(parent, 40)
	label(r, title, UDim2.new(0, 10, 0, 6), UDim2.new(0.35, 0, 0, 28), Color3.fromRGB(170, 185, 205), FONT2, Enum.TextXAlignment.Left)
	local val = label(r, nameOf(get()), UDim2.new(0.45, 0, 0, 6), UDim2.new(0.38, 0, 0, 28), Color3.new(1, 1, 1), FONT2)
	local function change(d)
		local v = get() + d
		local lo = count[1]
		local hi = count[2]
		if v < lo then v = hi elseif v > hi then v = lo end
		set(v)
		val.Text = nameOf(v)
		FX.Play("ui_click")
		if rebuild ~= false then buildPreview() end
	end
	button(r, "<", UDim2.new(0.37, 0, 0, 4), UDim2.new(0, 36, 0, 32), CYAN, function() change(-1) end)
	button(r, ">", UDim2.new(0.85, 0, 0, 4), UDim2.new(0, 36, 0, 32), CYAN, function() change(1) end)
end

local function slider(parent, title, get, set, lo, hi, steps, fmt)
	local step = (hi - lo) / steps
	picker(parent, title, function() return math.floor((get() - lo) / step + 0.5) end, function(i) set(lo + i * step) end, { 0, steps }, function(i) return fmt(lo + i * step) end)
end

local function textField(parent, title, get, set)
	local r = row(parent, 44)
	label(r, title, UDim2.new(0, 10, 0, 8), UDim2.new(0.35, 0, 0, 28), Color3.fromRGB(170, 185, 205), FONT2, Enum.TextXAlignment.Left)
	local tb = make("TextBox", { Text = get(), PlaceholderText = "type here", Position = UDim2.new(0.37, 0, 0, 6), Size = UDim2.new(0.6, 0, 0, 32), BackgroundColor3 = Color3.fromRGB(4, 4, 8), TextColor3 = Color3.new(1, 1, 1), Font = FONT2, TextScaled = true, ClearTextOnFocus = false, ZIndex = 22 }, r)
	corner(tb, 6)
	stroke(tb, Color3.fromRGB(60, 70, 90), 1)
	tb.FocusLost:Connect(function() set(string.sub(tb.Text, 1, 18)) end)
end

function Menus.OpenCreator()
	if inFight() then return end
	draft = draft or Util.deepCopy(Config.DefaultProfile)
	local ok, d = request("profile")
	if ok and type(d) == "table" and d.look then
		for k, v in d.look do draft[k] = v end
	end
	if draft.name == "" then draft.name = player.DisplayName end
	local body = openPanel("FIGHTER  //  BUILD YOUR BOXER", 560, 760, true)
	buildPreview()
	local function G(k) return function() return draft[k] end end
	local function S(k) return function(v) draft[k] = v end end
	local tabs = row(body, 40)
	button(tabs, "FULL BODY", UDim2.new(0, 6, 0, 4), UDim2.new(0.48, -8, 0, 32), YELLOW, function() zoomFace = false end)
	button(tabs, "FACE CLOSE-UP", UDim2.new(0.5, 2, 0, 4), UDim2.new(0.48, -8, 0, 32), YELLOW, function() zoomFace = true end)
	textField(body, "NAME", G("name"), S("name"))
	textField(body, "RING NAME", G("nickname"), S("nickname"))
	picker(body, "BODY TYPE", function() return draft.female and 2 or 1 end, function(v) draft.female = v == 2 end, { 1, 2 }, function(v) return v == 2 and "Feminine" or "Masculine" end)
	picker(body, "SKIN", G("skin"), S("skin"), { 1, #Config.SkinTones }, function(v) return v == Config.ChromeSkin and "Full Chrome" or ("Tone " .. v) end)
	picker(body, "HAIR", G("hair"), S("hair"), { 1, #Config.HairNames }, function(v) return Config.HairNames[v] end)
	picker(body, "HAIR COLOR", G("hairColor"), S("hairColor"), { 1, #Config.HairColors }, function(v) return Config.HairColorNames[v] end)
	picker(body, "FACIAL HAIR", G("beard"), S("beard"), { 1, #Config.BeardNames }, function(v) return Config.BeardNames[v] end)
	picker(body, "BEARD COLOR", G("beardColor"), S("beardColor"), { 0, #Config.HairColors }, function(v) return v == 0 and "Match hair" or Config.HairColorNames[v] end)
	picker(body, "EYEBROWS", G("brows"), S("brows"), { 1, #Config.BrowNames }, function(v) return Config.BrowNames[v] end)
	picker(body, "CYBER-OPTICS", G("eye"), S("eye"), { 1, #Config.EyeColors }, function(v) return v == #Config.EyeColors and "Natural" or ("Glow " .. v) end)
	slider(body, "JAWLINE", G("jaw"), S("jaw"), 0, 1, 4, function(v) return v < 0.35 and "Narrow" or v < 0.7 and "Average" or "Square" end)
	slider(body, "BUILD", G("bulk"), S("bulk"), 0.85, 1.35, 5, function(v) return v < 0.95 and "Lean" or v < 1.15 and "Athletic" or "Heavy" end)
	slider(body, "MUSCLE", G("muscle"), S("muscle"), 0, 1, 4, function(v) return v < 0.3 and "Soft" or v < 0.65 and "Athletic" or "Shredded" end)
	slider(body, "HEIGHT", G("height"), S("height"), 0.92, 1.08, 4, function(v) return math.floor(178 * v) .. " cm" end)
	picker(body, "TRUNKS", G("trunks"), S("trunks"), { 1, #Config.TrunkColors }, function(v) return Config.TrunkNames[v] end)
	picker(body, "GLOVES", G("gloves"), S("gloves"), { 1, #Config.GloveColors }, function(v) return Config.GloveNames[v] end)
	picker(body, "NEON ACCENT", G("accent"), S("accent"), { 1, 9 }, function(v) return "Glow " .. v end)
	picker(body, "STANCE", function() return draft.southpaw and 2 or 1 end, function(v) draft.southpaw = v == 2 end, { 1, 2 }, function(v) return v == 2 and "Southpaw" or "Orthodox" end)
	picker(body, "FACE TATTOO", function() return draft.tattoo and 2 or 1 end, function(v) draft.tattoo = v == 2 end, { 1, 2 }, function(v) return v == 2 and "Glowing" or "None" end)
	local save = row(body, 54)
	button(save, "SAVE & STEP INTO THE PIT", UDim2.new(0, 6, 0, 6), UDim2.new(1, -12, 0, 42), YELLOW, function()
		local ok2, err = request("saveLook", draft)
		if ok2 then
			HUD.Notify("Fighter saved", Config.Neon.Green)
			FX.Play("ui_good")
			destroyPreview()
			workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
			clearPanel()
		else
			HUD.Notify(err or "Couldn't save", RED)
		end
	end)
end

function Menus.OpenCareer()
	if inFight() then return end
	local body = openPanel("CAREER  //  THE PIT RANKINGS", 820, 700, false)
	local rank = player:GetAttribute("Rank") or 0
	for i = #Config.Roster, 1, -1 do
		local f = Config.Roster[i]
		local r = row(body, 74)
		local beaten = i <= rank
		local nextUp = i == rank + 1
		if nextUp then r.BackgroundColor3 = Color3.fromRGB(60, 10, 18) end
		label(r, i == #Config.Roster and "C" or ("#" .. (#Config.Roster - i + 1)), UDim2.new(0, 8, 0, 14), UDim2.new(0, 56, 0, 46), i == #Config.Roster and YELLOW or Color3.new(1, 1, 1), FONT)
		label(r, f.name .. '  <font color="#FFD826">"' .. f.nick .. '"</font>', UDim2.new(0, 72, 0, 6), UDim2.new(0.58, 0, 0, 26), beaten and Color3.fromRGB(140, 150, 165) or Color3.new(1, 1, 1), FONT2, Enum.TextXAlignment.Left)
		label(r, string.format("%d-%d (%d KO)  ·  %s%s  ·  %d rounds  ·  $%d", f.w, f.l, f.ko, Config.StyleNames[f.style], f.southpaw and "  ·  southpaw" or "", f.rounds, f.purse), UDim2.new(0, 72, 0, 32), UDim2.new(0.62, 0, 0, 16), Color3.fromRGB(150, 165, 185), FONT2, Enum.TextXAlignment.Left)
		label(r, f.bio, UDim2.new(0, 72, 0, 50), UDim2.new(0.62, 0, 0, 16), Color3.fromRGB(120, 130, 150), FONT2, Enum.TextXAlignment.Left)
		if nextUp then
			button(r, "FIGHT", UDim2.new(1, -170, 0, 16), UDim2.new(0, 160, 0, 42), YELLOW, function()
				local ok, err = request("career")
				if ok then clearPanel() else HUD.Notify(err or "Can't start", RED) end
			end)
		elseif beaten then
			button(r, "REMATCH", UDim2.new(1, -170, 0, 16), UDim2.new(0, 160, 0, 42), CYAN, function()
				local ok, err = request("exhibition", i)
				if ok then clearPanel() else HUD.Notify(err or "Can't start", RED) end
			end)
		else
			label(r, "LOCKED", UDim2.new(1, -170, 0, 22), UDim2.new(0, 160, 0, 28), Color3.fromRGB(100, 105, 120), FONT)
		end
	end
	local r = row(body, 40)
	label(r, "PvP: two players stand on a ring's RED and BLUE corner pads to start a fight.", UDim2.new(0, 10, 0, 6), UDim2.new(1, -20, 0, 28), Color3.fromRGB(170, 185, 205), FONT2, Enum.TextXAlignment.Left)
end

function Menus.OpenTraining()
	if inFight() then return end
	local body = openPanel("TRAINING CAMP  //  COACH MA RUIZ", 760, 560, false)
	for _, t in Config.Training do
		local r = row(body, 62)
		local lv = player:GetAttribute("Train_" .. t.key) or 0
		label(r, t.name, UDim2.new(0, 10, 0, 6), UDim2.new(0.55, 0, 0, 26), Color3.new(1, 1, 1), FONT2, Enum.TextXAlignment.Left)
		for i = 1, Config.TrainMax do
			frame(r, UDim2.new(0, 10 + (i - 1) * 30, 0, 38), UDim2.new(0, 24, 0, 12), i <= lv and CYAN or Color3.new(0, 0, 0), i <= lv and 0 or 0.4, 22)
		end
		if lv < Config.TrainMax then
			button(r, "TRAIN  $" .. Config.TrainCost(lv), UDim2.new(1, -210, 0, 10), UDim2.new(0, 200, 0, 42), YELLOW, function()
				local ok, err = request("train", t.key)
				if ok then FX.Play("ui_good"); task.wait(0.15); Menus.OpenTraining() else HUD.Notify(err or "Can't train", RED) end
			end)
		else
			label(r, "MAXED", UDim2.new(1, -210, 0, 14), UDim2.new(0, 200, 0, 30), YELLOW, FONT)
		end
	end
end

function Menus.OpenMedical()
	if inFight() then return end
	local body = openPanel("MEDICAL  //  OLD TOMAS THE CUTMAN", 640, 360, false)
	local r = row(body, 60)
	local inj = player:GetAttribute("Injured") or 0
	label(r, inj > 0.05 and string.format("You're carrying damage from your last fight (%d%%). It shows on your face and you'll start the next fight hurt.", math.floor(inj * 100)) or "You're fight-ready.", UDim2.new(0, 10, 0, 6), UDim2.new(1, -20, 0, 48), Color3.new(1, 1, 1), FONT2, Enum.TextXAlignment.Left)
	if inj > 0.05 then
		local r2 = row(body, 56)
		button(r2, "STITCH, ICE & PATCH ME UP  ($200)", UDim2.new(0, 6, 0, 6), UDim2.new(1, -12, 0, 44), YELLOW, function()
			local ok, err = request("heal")
			if ok then HUD.Notify("Good as new. Almost.", Config.Neon.Green); clearPanel() else HUD.Notify(err or "Can't heal", RED) end
		end)
	end
end

-- ------------------------------------------------------------------ top bar
local function buildTopBar()
	topBar = frame(gui, UDim2.new(0, 18, 0, 64), UDim2.new(0, 260, 0, 230), Color3.fromRGB(6, 7, 14), 0.2, 15)
	corner(topBar, 10)
	stroke(topBar, Color3.fromRGB(255, 38, 191), 1.5)
	make("UISizeConstraint", { MaxSize = Vector2.new(260, 230) }, topBar)
	local title = label(topBar, "THE PIT", UDim2.new(0, 10, 0, 6), UDim2.new(1, -20, 0, 30), Config.Neon.Magenta, Enum.Font.Michroma, Enum.TextXAlignment.Left)
	local stats = label(topBar, "", UDim2.new(0, 10, 0, 38), UDim2.new(1, -20, 0, 36), Color3.new(1, 1, 1), FONT2, Enum.TextXAlignment.Left)
	local y = 80
	for _, b in { { "FIGHTER", Menus.OpenCreator }, { "CAREER", Menus.OpenCareer }, { "TRAINING", Menus.OpenTraining }, { "MEDICAL", Menus.OpenMedical } } do
		button(topBar, b[1], UDim2.new(0, 10, 0, y), UDim2.new(1, -20, 0, 32), CYAN, b[2])
		y += 36
	end
	local _ = title
	RunService.RenderStepped:Connect(function()
		topBar.Visible = not inFight()
		stats.Text = string.format("$%d   ·   %d-%d-%d  (%d KO)\nRank: %s", player:GetAttribute("Cash") or 0, player:GetAttribute("Wins") or 0, player:GetAttribute("Losses") or 0, player:GetAttribute("Draws") or 0, player:GetAttribute("KOs") or 0,
			(player:GetAttribute("Rank") or 0) >= #Config.Roster and "UNDISPUTED CHAMPION" or ("#" .. (#Config.Roster - (player:GetAttribute("Rank") or 0) + 1) .. " contender"))
		if inFight() and panelRoot then clearPanel(); destroyPreview() end
	end)
end

function Menus.Start(controls)
	Controls = controls
	gui = make("ScreenGui", { Name = "NeonBayMenus", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 8 }, player:WaitForChild("PlayerGui"))
	buildTopBar()
	task.delay(2.5, function()
		if not player:GetAttribute("Created") then
			Menus.OpenCreator()
			HUD.Banner("WELCOME TO THE PIT", "Build your boxer, then climb the rankings", Config.Neon.Magenta, 4)
		end
	end)
end

return Menus
]]></string>
